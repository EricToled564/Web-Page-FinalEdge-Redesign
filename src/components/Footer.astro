---
<!-- Footer simplificado (pedido 2026-07-19): antes tenía dos bloques de
     marca redundantes (logo chico a la izquierda + lockup ENGINE grande
     a la derecha) y 3 columnas de navegación duplicando el nav/rueda —
     se consolida en UN solo bloque: el logo real donde antes estaba el
     lockup-título, con el copy debajo a piso de 14px (R2.1), mismo
     footer para TODAS las páginas. -->
<footer class="footer">
  <div class="footer-inner">
    <img
      class="footer-logo"
      src="/assets/logos/logo-finaledge.png"
      alt="final edge [AI]"
      width="220"
      loading="lazy"
    />
    <p class="footer-line"><span class="prompt">&gt;_</span> tu ventaja definitiva</p>
  </div>
  <div class="footer-meta">
    <span>© 2026 Final Edge · México</span>
    <span class="nav-lang" title="English — disponible próximamente"><span style="color:var(--fg)">ES</span> / EN</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--hairline); background: var(--panel); }
  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 72px 72px 40px;
  }
  .footer-logo { width: 220px; height: auto; display: block; }
  .footer-line { margin-top: 16px; color: var(--fg-2); font-size: 14px; }
  .footer-meta {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 72px 32px;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    color: var(--fg-faint);
    font-size: 14px;
  }
  .nav-lang { letter-spacing: .14em; color: var(--fg-faint); }
  @media (max-width: 900px) {
    .footer-inner { padding: 56px 24px 32px; }
    /* aire extra abajo: el chip fijo del asistente cubría el © en móvil
       (auditoría 2026-07-14) */
    .footer-meta { padding: 20px 24px 88px; }
  }
</style>
