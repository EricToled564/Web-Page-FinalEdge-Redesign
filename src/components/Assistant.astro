---
/* Asistente de IA (voz y texto): patrón previsto por la estrategia web.
   Sin backend todavía — este placeholder honesto conduce a la valoración. */
---
<div class="assistant" data-noprint>
  <button class="assistant-toggle" id="assistant-toggle" aria-expanded="false" aria-controls="assistant-panel">
    <span class="prompt">&gt;_</span> asistente <span class="tag-ai">[AI]</span>
  </button>
  <div class="assistant-panel" id="assistant-panel" hidden>
    <p class="eyebrow"><span class="prompt">&gt;_</span>asistente [AI]</p>
    <p class="assistant-copy">
      Nuestro asistente de inteligencia artificial —voz y texto— está en construcción y pronto te
      acompañará en todo el sitio. Mientras tanto, el camino directo es el mismo al que él te llevaría:
    </p>
    <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
  </div>
</div>

<style>
  .assistant { position: fixed; right: 24px; bottom: 24px; z-index: 60; display: grid; justify-items: end; gap: 12px; }
  .assistant-toggle {
    font-family: var(--font-ui);
    font-size: 14px;
    letter-spacing: .04em;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--accent);
    padding: 12px 18px;
    cursor: pointer;
    transition: background var(--t-hover) var(--ease);
  }
  .assistant-toggle:hover { background: var(--accent-active); }
  .assistant-panel {
    width: min(340px, calc(100vw - 48px));
    background: var(--panel);
    border: 1px solid var(--hairline);
    padding: 24px;
  }
  .assistant-copy { margin: 14px 0 18px; font-size: 14px; color: var(--fg-2); }
  /* MÓVIL (auditoría 2026-07-14): el chip a ancho de escritorio cubría
     CTAs y texto al pasar bajo él — compacto y pegado a la esquina.
     La fuente se queda en 14px (piso duro R2.1). */
  @media (max-width: 640px) {
    .assistant { right: 12px; bottom: 12px; }
    .assistant-toggle { padding: 9px 12px; letter-spacing: .02em; }
  }
</style>

<script>
  function initAssistant() {
    const btn = document.getElementById('assistant-toggle');
    const panel = document.getElementById('assistant-panel');
    if (!btn || !panel || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const open = panel.hasAttribute('hidden');
      panel.toggleAttribute('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    });
  }
  initAssistant();
  document.addEventListener('astro:page-load', initAssistant);
</script>
