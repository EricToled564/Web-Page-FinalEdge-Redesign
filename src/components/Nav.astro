---
import LockupMark from './LockupMark.astro';
---
<header class="nav" id="site-nav">
  <a class="nav-brand" href="/" aria-label="Final Edge — inicio">
    <LockupMark word="final edge" tag="[AI]" variant="section" />
  </a>
  <div class="nav-side">
    <span class="nav-lang" title="English — disponible próximamente">
      <span class="nav-lang-on">ES</span> / <span class="nav-lang-off">EN</span>
    </span>
    <a class="btn nav-cta" href="/#valoracion">Valoración</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 32px;
    height: 92px;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline-nav);
    transition: transform var(--t-ui) var(--ease);
  }
  .nav.is-hidden { transform: translateY(-100%); }
  /* mínimo digital del brand book: logo ≥160px de ancho, en cualquier tratamiento */
  .nav-brand { width: 168px; flex: none; }
  .nav-side { display: flex; align-items: center; gap: 20px; }
  .nav-lang { font-size: var(--text-label); letter-spacing: .14em; color: var(--fg-faint); }
  .nav-lang-on { color: var(--fg); }
  .nav-cta { padding: 10px 18px; }
  @media (max-width: 900px) {
    .nav { padding: 0 16px; }
  }
</style>

<script>
  // Nav estilo cosmos: se oculta al bajar, reaparece al subir.
  function initNav() {
    const nav = document.getElementById('site-nav');
    if (!nav || nav.dataset.bound) return;
    nav.dataset.bound = '1';
    let last = 0;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        nav.classList.toggle('is-hidden', y > 120 && y > last);
        last = y;
      },
      { passive: true }
    );
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
