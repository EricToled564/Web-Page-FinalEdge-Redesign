---
import LockupMark from './LockupMark.astro';
---
<header class="nav" id="site-nav" transition:persist>
  <a class="nav-brand" href="/" aria-label="Final Edge — inicio">
    <img src="/assets/logos/logo-finaledge.png" alt="final edge [AI]" width="180" height="49" />
  </a>
  <div class="nav-ctas">
    <!-- "Servicios" (pedido 2026-07-18): en móvil el botón del lockup
         de abajo se oculta por falta de espacio y no quedaba NINGÚN
         acceso visible a la rueda de servicios desde el nav — este
         chip solo aparece en esa franja angosta (ver media query) y
         lleva directo a la rueda. -->
    <a class="btn btn--ghost nav-cta nav-cta--services" href="/#engine">Servicios</a>
    <a class="btn nav-cta" href="/#valoracion">
      <span class="nav-cta-full">Exploremos tus necesidades</span>
      <span class="nav-cta-short">Valoración</span>
    </a>
    <a class="btn btn--ghost nav-cta nav-cta--lockup" href="/#engine">
      Conoce el<LockupMark word="final edge" tag="[ENGINE]" variant="wheel" class="brand-lockup" />
    </a>
  </div>
  <span class="nav-lang" title="English — disponible próximamente">
    <span class="nav-lang-on">ES</span> / <span class="nav-lang-off">EN</span>
  </span>
</header>

<style>
  /* carcasa persistente estilo cosmos.so: sticky, SIEMPRE visible — no se
     oculta al bajar. transition:persist (arriba) evita que se vuelva a
     montar entre páginas, así nunca parpadea. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 32px;
    height: 92px;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline-nav);
  }
  /* logo maestro real (brand book), no una reconstrucción de texto —
     mínimo digital del brand book: ≥160px de ancho, nunca menor */
  .nav-brand { width: 180px; flex: none; display: block; }
  .nav-brand img { width: 100%; height: auto; display: block; }
  .nav-ctas { display: flex; align-items: center; gap: 12px; }
  /* centrados de verdad en la página (no solo en el espacio sobrante
     entre logo y toggle de idioma, que casi nunca miden lo mismo):
     posición absoluta anclada al centro horizontal del nav. Solo en
     desktop — en ≤900px vuelven al flujo normal porque ahí ya solo
     queda un botón (ver abajo) y no hay espacio para centrar sin
     encimarse con el logo. */
  @media (min-width: 901px) {
    .nav-ctas { position: absolute; left: 50%; transform: translateX(-50%); }
  }
  .nav-lang { font-size: var(--text-label); letter-spacing: .14em; color: var(--fg-faint); }
  .nav-lang-on { color: var(--fg); }
  /* mayúsculas/minúsculas normales (pedido 2026-07-19) — .btn fuerza
     uppercase globalmente, se resetea aquí igual que ya hacía
     .nav-cta--lockup para su propio contenido. */
  /* 68px = alto natural del botón --lockup (su lockup de 2 líneas
     necesita ese espacio) — se comparte como min-height para que el
     botón de texto plano quede exactamente de la misma altura, nunca al
     revés (recortar el lockup lo rompería). */
  .nav-cta { padding: 10px 18px; min-height: 68px; white-space: nowrap; box-sizing: border-box; display: inline-flex; align-items: center; text-transform: none; letter-spacing: .02em; }
  .nav-cta-short { display: none; }
  /* resetea el uppercase/tracking del .btn (R5.8) para que el lockup se
     vea igual que en cualquier otro lugar del sitio, nunca distorsionado
     por el estilo del botón. Border-color sube de --hairline (casi
     invisible sobre el fondo oscuro del nav, reporte 2026-07-19 "uno
     tiene recuadro y el otro no") a --fg-faint — gris visible, más
     discreto que el azul del CTA primario pero se lee como caja. */
  .nav-cta--lockup { border-color: var(--fg-faint); display: flex; align-items: baseline; gap: 8px; text-transform: none; letter-spacing: normal; }
  /* "Servicios" solo vive en la franja móvil (ver @media 900px abajo):
     en escritorio ya está el lockup completo, sobraría duplicado */
  .nav-cta--services { display: none; }
  /* pedido explícito: el lockup ENGINE del nav al MISMO tamaño que el
     logo [AI] de la izquierda. La equivalencia se midió contra el PNG
     real (logo-finaledge.png segmentado por alfa): la palabra "final
     edge" del logo mide 129.5px de ancho a la escala del nav (180px),
     y la del lockup a 28px de fuente medía ~161px → factor 0.803:
     22.5px de palabra / 17.5px de tag (ambos sobre el piso de 14px,
     R2.1). SOLO esta colocación: .brand-lockup global (footer, /engine/,
     sección Engine del home) conserva su tamaño fijo de siempre.
     :global() porque .lm-* se renderiza dentro de LockupMark (otro
     componente) y el scope de Astro no lo alcanza desde aquí. */
  /* también el font-size del CONTENEDOR (no solo los hijos): el gap
     >_-palabra de LockupMark se calcula en em contra ESE valor
     (pedido 2026-07-19, "la distancia debe ser siempre la misma") —
     sin esto el hueco se quedaba en el tamaño de brand-lockup (35px)
     aunque el texto ya achicara a 22.5px aquí, y se veía desproporcionado. */
  .nav-cta--lockup :global(.lm-wheel.brand-lockup) { font-size: 22.5px; }
  .nav-cta--lockup :global(.lm-wheel.brand-lockup .lm-prompt),
  .nav-cta--lockup :global(.lm-wheel.brand-lockup .lm-word) { font-size: 22.5px; }
  .nav-cta--lockup :global(.lm-wheel.brand-lockup .lm-tag) { font-size: 17.5px; }
  @media (max-width: 1100px) {
    .nav { padding: 0 24px; }
    .nav-cta { padding: 8px 14px; }
  }
  /* en teléfonos y tablets angostos, el logo (180px fijo) + el toggle
     ES/EN + los dos botones ya no caben en una sola fila y producían
     scroll horizontal en TODO el sitio (el nav es sticky global) — se
     va soltando lo menos crítico primero: el toggle de idioma (inglés
     aún no disponible) y luego el botón secundario del Engine, así
     siempre queda al menos la llamada a la valoración, siempre visible. */
  @media (max-width: 900px) {
    .nav { padding: 0 16px; }
    .nav-lang { display: none; }
    .nav-cta--lockup { display: none; }
    .nav-cta--services { display: inline-block; }
  }
  /* "Exploremos tus necesidades" no cabe en una fila junto al logo y el
     padding del nav en pantallas angostas — se reemplaza por el label
     corto en vez de encogerse más (el font-size ya está en el piso duro
     de 14px, R2.1). */
  @media (max-width: 560px) {
    .nav-cta-full { display: none; }
    .nav-cta-short { display: inline; }
  }
  @media (max-width: 480px) {
    .nav { padding: 0 16px; gap: 10px; }
    .nav-brand { width: 128px; }
    .nav-cta { padding: 8px 12px; letter-spacing: .04em; }
  }
</style>
