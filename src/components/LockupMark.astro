---
/**
 * LockupMark — ÚNICA fuente de verdad para todo lockup de marca
 * (>_ + palabra + [tag]) en el sitio.
 *
 * Los valores de cada variante son COPIA LITERAL, carácter por carácter,
 * de los inline styles del archivo fuente del brand book
 * ("Final Edge AI Brand Book.dc.html") — no una aproximación ni un
 * cálculo propio. Si el brand book cambia estos números, se actualizan
 * aquí y en ningún otro lugar.
 *
 * Fuente exacta:
 *  - variant="wheel": objeto `wheelEdges`/`engineNodes` (sección 07, rueda ENGINE™).
 *  - variant="section": función `edgeStyles(color,1)` + `mkEdge` (sección 03, Edges & fases).
 *  - variant="hub": markup del hub central de la rueda (sección 07).
 *  - variant="big": MISMA proporción que "section", escalada 4× — el brand
 *    book no define un tamaño monumental para edges; se extiende la
 *    fórmula sin alterar ninguna proporción (ver README §tipografía: el
 *    propio sistema usa esta lógica de escalado consistente en clamp()).
 *
 * Todo lockup dentro de la rueda comparte el MISMO --scale (una sola
 * variable, calculada en runtime a partir de la palabra más larga) para
 * que los seis edges se vean siempre al mismo tamaño entre sí — nunca
 * cada uno encogido de forma independiente.
 */
interface Props {
  word: string;
  tag?: string;
  color?: string;
  wordColor?: string;
  variant?: 'wheel' | 'section' | 'hub' | 'big';
  class?: string;
  /* pedido 2026-07-23: los 6 heroes horneados (logo-<edge>.png +
     svc-<edge>-hero.mp4) traen un punto grabado en el arte después de
     la palabra ("strategy.", "readiness.", etc.) — no se puede editar
     esos assets desde código. dot alinea al lockup VIVO (rueda, menú)
     con esa realidad ya horneada; se pasa explícito por caller, nunca
     por defecto, porque el lockup del sistema ("final edge [ENGINE]")
     nunca lleva punto. */
  dot?: boolean;
}

const {
  word,
  tag = '[AI]',
  color = 'var(--accent)',
  wordColor = 'var(--fg)',
  variant = 'section',
  class: klass = '',
  dot = false,
} = Astro.props as Props;
---
<span class={`lm lm-${variant} ${klass}`} style={`--lm-color:${color}; --lm-word-color:${wordColor}`} data-autofit={variant === 'wheel' ? 'wheel' : undefined}>
  <span class="lm-prompt">&gt;_</span>
  <span class="lm-col">
    <span class="lm-word">{word}{dot && '.'}</span>
    <span class="lm-tag">{tag}</span>
  </span>
</span>

<style is:global>
  /* --- variant="wheel" — copia literal de `wheelEdges`/`engineNodes`.
     Dos pedidos explícitos encima del original (18px/14px): primero
     +20% (18→21.6px prompt/word, 14→16.8px tag), después +25% MÁS sobre
     ESE resultado (21.6→27px, 16.8→21px) — no +25% sobre el original.
     Gaps escalados igual para que el conjunto crezca proporcional, no
     solo el texto. fitWheelLabels() en engine-wheel.js mide el ancho YA
     renderizado de cada lockup contra su caja fija (118px/96px por
     edge, 148px el hub) y encoge --wheel-scale solo si de verdad no
     cabe — ese seguro sigue intacto sin tocarlo, así que ningún
     incremento de tamaño aquí puede desbordar la rueda. */
  .lm-wheel {
    display: inline-flex;
    align-items: baseline;
    /* pedido 2026-07-19: la distancia entre >_ y la palabra debe ser
       SIEMPRE la misma, sin importar la colocación (nav, hero, rueda) —
       un gap en px fijo se ve distinto en cada tamaño porque el
       font-size cambia por colocación (22.5px en el nav, 35px en
       brand-lockup, 34px por defecto) pero el hueco no. En em, contra
       el font-size DEL PROPIO CONTENEDOR (línea de abajo, calcado del
       tamaño real del >_ de cada variante), el hueco escala igual que
       el texto — misma proporción en todos lados. 0.3em: mismo valor
       usado en el resto del sitio (>_ + título). */
    font-size: 34px;
    gap: .3em;
    line-height: 1;
    white-space: nowrap;
    transform: scale(var(--wheel-scale, 1));
    transform-origin: left center;
  }
  .lm-wheel .lm-col { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  /* >_ un 26% mayor que la palabra en TODAS las variantes (opción A,
     pedido 2026-07-15): iguala la proporción medida en los PNGs
     horneados de los heroes (símbolo 220px vs palabra 326px en
     logo-strategy) — el HTML del brand book los traía al MISMO
     font-size y por eso la rueda se veía distinta a los heroes. La
     palabra y el tag no cambian; el seguro fitWheelLabels() absorbe
     el ancho extra si algún lockup deja de caber. */
  .lm-wheel .lm-prompt { font-family: 'Geist Mono', monospace; font-weight: 700; font-size: 34px; color: var(--lm-color); line-height: 1; }
  .lm-wheel .lm-word { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 27px; letter-spacing: -.02em; color: var(--lm-word-color); line-height: 1; }
  .lm-wheel .lm-tag { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 21px; letter-spacing: .07em; color: var(--lm-color); line-height: 1; }

  /* --- .brand-lockup — tamaño FIJO único para el logo ">_ final edge
     [ENGINE]" en TODAS las colocaciones estáticas del sitio (nav,
     footer, encabezado de /engine/, sección Engine del home): mismo
     font-size, misma proporción. La única excepción es el hub central
     de la rueda 3D — ESE no es una colocación de logo, es parte de la
     escena 3D y escala junto con el diámetro de la rueda por necesidad
     técnica.
     SIN !important en transform: fit-lockups.js sigue siendo el dueño
     del transform inline (lo resetea a 'none' y solo lo encoge si de
     verdad no cabe) — forzarlo con !important bloquearía ese seguro
     universal contra desbordes y volveríamos a tener scroll horizontal
     en pantallas angostas. */
  /* font-size del CONTENEDOR también, no solo de los hijos — es contra
     ESE valor que se calcula el gap en em (arriba), así el hueco queda
     proporcional también en esta colocación fija. */
  .lm-wheel.brand-lockup { font-size: 35px; }
  .lm-wheel.brand-lockup .lm-prompt { font-size: 35px; }
  .lm-wheel.brand-lockup .lm-word { font-size: 28px; }
  .lm-wheel.brand-lockup .lm-tag { font-size: 22px; }

  /* --- variant="section" — copia literal de `edgeStyles(color,1)` + `mkEdge` --- */
  .lm-section {
    display: inline-flex;
    align-items: baseline;
    font-size: 26px;
    gap: .3em;
    line-height: 1;
    white-space: nowrap;
  }
  .lm-section .lm-col { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 9px; }
  .lm-section .lm-prompt { font-family: 'Geist Mono', monospace; font-weight: 700; font-size: 26px; color: var(--lm-color); line-height: 1; }
  .lm-section .lm-word { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 21px; letter-spacing: -.01em; color: var(--lm-word-color); line-height: 1; }
  .lm-section .lm-tag { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 14px; letter-spacing: .16em; color: var(--lm-color); line-height: 1; }

  /* --- variant="hub" — copia literal del markup del hub central --- */
  .lm-hub {
    display: inline-flex;
    align-items: baseline;
    font-size: 29px;
    gap: .3em;
    line-height: 1;
    white-space: nowrap;
    transform: scale(var(--wheel-scale, 1));
    transform-origin: center center;
  }
  .lm-hub .lm-col { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 7px; }
  .lm-hub .lm-prompt { font-family: 'Geist Mono', monospace; font-weight: 700; font-size: 29px; color: var(--accent); line-height: 1; }
  .lm-hub .lm-word { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 23px; letter-spacing: -.02em; word-spacing: -.36ch; color: var(--fg); line-height: 1; }
  .lm-hub .lm-tag { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 14px; letter-spacing: .16em; color: var(--accent); line-height: 1; }

  /* --- variant="big" — misma fórmula que "section", ×4 --- */
  .lm-big {
    display: inline-flex;
    align-items: baseline;
    font-size: 106px;
    gap: .3em;
    line-height: 1;
    white-space: nowrap;
  }
  .lm-big .lm-col { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 36px; }
  .lm-big .lm-prompt { font-family: 'Geist Mono', monospace; font-weight: 700; font-size: 106px; color: var(--lm-color); line-height: 1; }
  .lm-big .lm-word { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 84px; letter-spacing: -.01em; color: var(--lm-word-color); line-height: 1; }
  .lm-big .lm-tag { font-family: 'Geist Mono', monospace; font-weight: 600; font-size: 56px; letter-spacing: .16em; color: var(--lm-color); line-height: 1; }
  @media (max-width: 760px) {
    .lm-big { font-size: 53px; gap: .3em; }
    .lm-big .lm-col { gap: 18px; }
    .lm-big .lm-prompt { font-size: 53px; }
    .lm-big .lm-word { font-size: 42px; }
    .lm-big .lm-tag { font-size: 28px; }
  }
</style>
