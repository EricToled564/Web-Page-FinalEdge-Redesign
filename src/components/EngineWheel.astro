---
/**
 * Isla persistente de la rueda ENGINE™ (WebGL). Se conserva entre páginas
 * (transition:persist) para que la coreografía fluya sin recargas.
 * Fallback sin WebGL: los mismos lockups como enlaces estáticos en retícula.
 */
import { PHASES, EDGES } from '../data/engine.js';
import LockupMark from './LockupMark.astro';
const { compact = false, fitHeight = false } = Astro.props;
---
<div
  id="engine-wheel"
  class="wheel-stage"
  data-compact={compact ? '1' : '0'}
  data-fit-height={fitHeight ? '1' : '0'}
  transition:persist="engine-wheel"
>
  <canvas class="wheel-canvas" aria-hidden="true"></canvas>

  <div class="wheel-overlay" data-overlay>
    {EDGES.map((e) => {
      const color = PHASES.find((p) => p.id === e.phase).color;
      return (
        <a class={`wl wl-edge wl-phase-${e.phase}`} data-anchor={`edge-${e.id}`} href={e.slug} aria-label={`${e.id} — ${e.service}`}>
          <LockupMark word={e.id} tag="[AI]" color={color} variant="wheel" dot />
        </a>
      );
    })}
    {PHASES.map((p) => (
      <a class={`wl wl-band wl-phase-${p.id}`} data-anchor={`phase-${p.id}`} href={p.slug}>
        {p.name}
      </a>
    ))}
    <div class="wl wl-hub" data-anchor="hub" aria-hidden="true">
      <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" />
    </div>
  </div>

  <noscript>
    <ul class="wheel-list">
      {EDGES.map((e) => (
        <li><a href={e.slug}>{e.id} — {e.service}</a></li>
      ))}
    </ul>
  </noscript>
</div>

<style>
  /* La rueda SIEMPRE se ve completa, en una sola imagen, sin scroll ni
     horizontal ni vertical bajo ninguna circunstancia: el ancho Y el
     alto los calcula engine-wheel.js en cada resize() a partir del
     espacio real disponible en AMBAS dimensiones (nunca solo el ancho),
     y los aplica directo como width/height en px — por eso no hay
     width/aspect-ratio fijos aquí, sería redundante con ese cálculo y
     podría entrar en conflicto con él. */
  .wheel-stage {
    position: relative;
    margin: 0 auto;
    /* contención defensiva: pase lo que pase con el cálculo de proyección
       3D (framing de zoom en modo servicio, redondeos, etc.), una etiqueta
       JAMÁS puede producir scroll a nivel de página. */
    overflow: hidden;
  }
  /* el canvas NO llena el 100% de .wheel-stage: .wheel-stage tiene un
     margen de seguridad (ver BUFFER en engine-wheel.js resize()) para
     que las etiquetas de fase tengan aire entre el anillo y el borde de
     recorte — nunca se encima el nombre sobre el color de la rueda, y
     nunca se corta contra el borde. El canvas y el overlay comparten
     exactamente el mismo tamaño y posición (centrados), así que las
     coordenadas de projectLabels() (relativas al canvas) siguen siendo
     válidas para el overlay. */
  .wheel-canvas, .wheel-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .wheel-canvas { display: block; z-index: 0; }
  /* refuerzo del mismo contrato de .wheel-stage ("una etiqueta JAMÁS
     puede producir scroll a nivel de página", ver arriba): las etiquetas
     ocultas de la fase/edge que no están enfocadas (opacity:0 vía
     [data-mode='phase'] .wl) siguen ocupando su caja normal —
     projectLabels() las posiciona en el radio real de la rueda 3D, que
     puede caer fuera de .wheel-stage. .wheel-stage ya las recorta
     visualmente (sus píxeles nunca se ven), pero detectado con
     Playwright: en el hub de fase a 360px, una etiqueta oculta
     empujaba document.documentElement.scrollWidth 2px más allá del
     viewport (scroll horizontal real, aunque invisible, forzable por
     JS/gesto) — .wheel-overlay (el padre directo de las etiquetas)
     nunca clipaba por sí mismo, solo heredaba el clip visual de
     .wheel-stage. overflow:hidden aquí también cierra esa fuga. */
  /* z-index 1 EXPLÍCITO: las etiquetas viven SIEMPRE sobre el canvas
     3D — los segmentos (pixeles del canvas) no pueden cubrir jamás una
     etiqueta, se expandan lo que se expandan (reporte 2026-07-13). */
  .wheel-overlay { pointer-events: none; overflow: hidden; z-index: 1; }

  .wl {
    position: absolute;
    top: 0; left: 0;
    pointer-events: auto;
    transition: opacity var(--t-ui) var(--ease);
  }

  /* lockup de edge: ancho FIJO en el espacio de referencia de la rueda
     (880px) — engine-wheel.js aplica una escala uniforme al conjunto
     cuando la rueda se muestra más chica, así todos los edges achican
     exactamente igual, nunca cada uno por separado.
     118→160 / 96→130: TIENE que coincidir exactamente con edgeBox en
     fitWheelLabels() (engine-wheel.js) — es la misma caja de referencia
     usada ahí para decidir cuánto encoger --wheel-scale; si estos dos
     valores se desincronizan, el centrado (translate(-50%,-50%) sobre
     ESTE ancho) deja de coincidir con la caja que en verdad se está
     midiendo. Ver el comentario largo en fitWheelLabels() para el
     porqué del número. */
  /* 164→197 (×1.2): pedido explícito 2026-07-12 de lockups de servicio
     20% mayores. NO se toca ningún font-size: la etiqueta más larga
     ("intelligence") siempre excede su caja y fitWheelLabels() encoge
     --wheel-scale (compartida por los 6) hasta que quepa — es decir, el
     tamaño RENDERIZADO es caja × (proporción fija de la fuente), la
     caja es el único mando real. Crecerla ×1.2 agranda los 6 lockups
     exactamente 20%, en bloque (una sola escala compartida, jamás cada
     uno por separado). Debe coincidir SIEMPRE con edgeBox en
     fitWheelLabels() (engine-wheel.js).
     SOLO la rueda completa del home crece: en la mini-rueda de los hubs
     de fase (compact, 133) "intelligence" a +20% se salía de su gajo
     (verificado en captura: las letras sangraban sobre el fondo
     naranja) y el pedido exige NO exceder el espacio — ahí queda el
     tamaño anterior, que ya es el máximo que cabe. El lockup del HUB
     central no es un servicio: su caja (hubBox) no se toca. */
  .wl-edge { width: 197px; }
  [data-compact='1'] .wl-edge { width: 133px; }
  /* El CONTENIDO del lockup se centra dentro de su caja (flex) y escala
     desde el CENTRO — mismo patrón que el hub, por la misma razón: el
     ancla se centra en el gajo vía translate(-50%,-50%) sobre la caja
     fija, pero el .lm-wheel es inline y por defecto se pega al borde
     IZQUIERDO de esos 197px y encoge desde ahí (transform-origin: left)
     — cualquier palabra más corta que "intelligence" (la que llena la
     caja) quedaba corrida a la izquierda de su gajo, y el crecimiento
     de la caja a 197 lo hizo evidente (medido: "creative" 27.3px a la
     izquierda de su ancla; bug reportado con captura 2026-07-13). Con
     flex + origen central, el contenido queda clavado al centro del
     gajo sin importar su largo ni la escala. La MEDICIÓN de
     fitWheelLabels() no cambia: mide el ancho del bbox, que es el mismo
     centrado o no. */
  .wl-edge { display: flex; justify-content: center; }
  .wl-edge :global(.lm-wheel) { transform-origin: center center; }

  /* etiqueta de fase — 16px, tracking 2.6px, 600. Texto SIEMPRE blanco
     sobre un fondo sólido oscuro (nunca el color de la fase): antes el
     texto usaba el mismo color que el propio anillo de la rueda, y
     donde ambos se cruzan en la proyección 3D el nombre se volvía
     ilegible (mismo color sobre mismo color). El fondo sólido garantiza
     contraste sin importar qué haya detrás — anillo, línea punteada o
     vacío — sin usar sombras (R3.2, prohibidas). */
  /* +25% respecto al tamaño anterior (16px) — pedido explícito de que
     SOLO crezca el nombre de la fase. El label se posiciona con
     translate(-50%,-50%) sobre su propio centro (ver projectLabels() en
     engine-wheel.js), así que agrandarlo no mueve ni un solo punto de
     la geometría 3D de la rueda. */
  /* Chips de fase en mayúsculas/minúsculas ({p.name}, ya no el label en
     ALTAS) y al MISMO tamaño que el título de la sección del home
     (.engine-h2: clamp(14px, 1.3vw, 16px)) — pedido 2026-07-15 sobre
     "los botones de [la sección] tu ventaja competitiva". El tracking
     baja proporcional (20→16 = ×0.8). */
  /* +25% (pedido 2026-07-18: "los nombres de las fases están demasiado
     pequeños") — mismo criterio que el crecimiento anterior de esta
     etiqueta: solo el tamaño de fuente y el padding que lo acompaña,
     el posicionamiento centrado (translate -50%,-50%) no se mueve. */
  .wl-band { font-size: clamp(17px, 1.7vw, 20px); letter-spacing: 2.6px; font-weight: 600; color: var(--fg); background: var(--void-deep); padding: 5px 13px; white-space: nowrap; }
  /* reporte 2026-07-19 (segunda vez — "sigue estando muy pequeñas
     todavía"): en móvil 1.7vw cae debajo del piso de 17px en cualquier
     viewport <1000px, así que la etiqueta se queda SIEMPRE en el
     mínimo — pero la rueda en sí crece bastante en móvil (ver
     .engine-col-wheel en index.astro, "pasa de 273px a ~370px"), y el
     nombre de fase no acompañaba ese crecimiento. Sube el piso propio
     para móvil, proporcional al tamaño real de la rueda ahí. */
  @media (max-width: 900px) {
    .wl-band { font-size: clamp(22px, 6vw, 28px); padding: 7px 16px; }
  }
  /* En el hub de fase (modo 'phase') la banda dice "Conoce más:" sobre el
     fondo de color de la fase (landing 2026-07-11) y el cliente pidió
     quitarle el rectángulo negro y reducirla en la misma proporción que
     la sección (−35%). Sin el chip oscuro el texto blanco no contrasta
     sobre ámbar/cian/magenta: pasa a tinta void, igual que el título.
     20px×0.65 = 13px viola el piso duro de 14px (R2.1) — se queda en
     14px, el mínimo permitido; el tracking sí baja proporcional. En el
     home (modo 'full') el chip queda exactamente como estaba. */
  /* +30% pedido explícito 2026-07-12 (14px → 18.2px, tracking
     proporcional) — sigue arriba del piso duro de 14px (R2.1) */
  /* Respaldo del MISMO color del fondo del hub (no negro — el cliente
     pidió quitar el rectángulo negro, y aquí sigue fuera): en reposo es
     invisible (se funde con la página), pero cuando el hover 3D expande
     un segmento y su cara oscura pasa POR DEBAJO de la frase, el texto
     tinta-void perdía todo contraste y se "cubría" (reporte 2026-07-13:
     "que esta frase no se cubra al momento de que se expanden los
     segmentos"). El chip garantiza que el efecto y los segmentos
     siempre queden visualmente DETRÁS de la frase. Misma fórmula que el
     fondo del hero del hub: --pc desaturado 15%. */
  [data-mode='phase'] .wl-band {
    /* sobre los lockups de servicio (sus hermanos del overlay): la
       frase es lo último que puede taparse dentro de la rueda */
    z-index: 2;
    /* fallback primero: si el navegador no soporta la sintaxis de color
       relativo (Safari < 16.4), el chip queda en el color pleno de la
       fase en vez de quedar TRANSPARENTE (que era perder el respaldo y
       volver a "la frase se cubre"). El override de abajo lo afina al
       tono exacto del fondo donde sí hay soporte. */
    background: var(--pc, var(--accent));
    background: oklch(from var(--pc, var(--accent)) l calc(c * 0.85) h);
    color: var(--void-deep);
    font-size: 18.2px;
    letter-spacing: 2.2px;
    padding: 4px 12px;
  }

  /* el ancla (.wl-hub) SÍ queda centrada en la rueda vía translate(-50%,-50%)
     en projectLabels() (engine-wheel.js) — eso nunca fue el problema. El
     lockup de adentro (el span ">_ final edge [ENGINE]") es un elemento
     inline dentro de un contenedor block, así que por defecto se pega al
     borde IZQUIERDO de esos 148px en vez de quedar centrado dentro de
     ellos — dos cosas distintas: el ancla estaba centrada, su CONTENIDO
     no (medido: ~24px de diferencia entre el centro real del canvas y el
     centro del texto visible). flex + centrado en ambos ejes resuelve el
     contenido sin tocar cómo se posiciona el ancla en sí. */
  .wl-hub { width: 148px; display: flex; align-items: center; justify-content: center; }
  /* .lm-wheel vive en LockupMark.astro (otro componente) — un selector
     normal aquí escrito como ".wl-hub .lm-wheel" nunca lo alcanza: el
     CSS con scope de Astro solo afecta elementos escritos EN ESTE
     archivo, no los que renderiza un componente hijo (por eso
     LockupMark.astro usa <style is:global> para sus propias reglas).
     :global() es lo mismo, apuntado, sin tener que marcar TODO este
     bloque como global. transform-origin:left center (el default de
     .lm-wheel) es correcto para los 6 edges, pero en el hub — ya
     centrado por el flex de arriba — ese origen IZQUIERDO hacía que el
     encogimiento de --wheel-scale (el seguro contra desbordes) tirara el
     contenido hacia la izquierda en vez de encoger parejo desde el
     centro: el mismo bug de "no centrado", ahora causado por la escala
     en vez del layout. Solo el hub se recentra; los edges no se tocan. */
  .wl-hub :global(.lm-wheel) { transform-origin: center center; }
  /* el hub NO acompaña el +20% de los lockups de servicio (pedido
     2026-07-12, solo servicios): usa su propia escala, calculada en
     fitWheelLabels() como la que le tocaba con la caja anterior — ver
     el comentario ahí. Mismo patrón var() que .lm-wheel. */
  .wl-hub :global(.lm-wheel) { transform: scale(var(--wheel-scale-hub, 1)); }

  /* estados: en el hub de fase solo vive la fase enfocada; en servicio, nada */
  [data-mode='service'] .wl,
  [data-mode='phase'] .wl { opacity: 0; pointer-events: none; }
  [data-mode='phase'][data-focus='evaluacion'] .wl-phase-evaluacion,
  [data-mode='phase'][data-focus='capacidades'] .wl-phase-capacidades,
  [data-mode='phase'][data-focus='ejecucion'] .wl-phase-ejecucion { opacity: 1; pointer-events: auto; }
  /* el rótulo "Conoce más:" ya vive en la PÁGINA del hub
     (.hub-cta-label en [phase].astro), fuera de la isla — el de adentro
     se apaga para no duplicarse ni viajar con el hover. DESPUÉS de las
     reglas de foco (misma especificidad: gana por orden). */
  [data-mode='phase'][data-focus] .wl-band { opacity: 0; pointer-events: none; }

  /* fallback sin WebGL: retícula de lockups */
  .wheel-stage.is-fallback { aspect-ratio: auto; }
  .wheel-stage.is-fallback .wheel-canvas { display: none; }
  .wheel-stage.is-fallback .wheel-overlay { position: static; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .wheel-stage.is-fallback .wl { position: static; transform: none; background: var(--bg); padding: 24px; }
  .wheel-stage.is-fallback .wl-hub { grid-column: 1 / -1; }
  .wheel-list { list-style: none; display: grid; gap: 10px; padding: 24px; }
</style>

<script>
  import '../scripts/engine-wheel.js';
</script>
