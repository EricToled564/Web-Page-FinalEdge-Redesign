---
/**
 * Isla persistente de la rueda ENGINE™ (WebGL). Se conserva entre páginas
 * (transition:persist) para que la coreografía fluya sin recargas.
 * Fallback sin WebGL: los mismos lockups como enlaces estáticos en retícula.
 */
import { PHASES, EDGES } from '../data/engine.js';
import LockupMark from './LockupMark.astro';
const { compact = false } = Astro.props;
---
<div
  id="engine-wheel"
  class="wheel-stage"
  data-compact={compact ? '1' : '0'}
  transition:persist="engine-wheel"
>
  <canvas class="wheel-canvas" aria-hidden="true"></canvas>

  <div class="wheel-overlay" data-overlay>
    {EDGES.map((e) => {
      const color = PHASES.find((p) => p.id === e.phase).color;
      return (
        <a class={`wl wl-edge wl-phase-${e.phase}`} data-anchor={`edge-${e.id}`} href={e.slug} aria-label={`${e.id} — ${e.service}`}>
          <LockupMark word={e.id} tag="[AI]" color={color} size="wheel" />
        </a>
      );
    })}
    {PHASES.map((p) => (
      <a class={`wl wl-band wl-phase-${p.id}`} data-anchor={`phase-${p.id}`} href={p.slug} style={`color:${p.color}`}>
        {p.label}
      </a>
    ))}
    <div class="wl wl-hub" data-anchor="hub" aria-hidden="true">
      <LockupMark word="final edge" tag="[ENGINE]" size="wheel" />
    </div>
  </div>

  <noscript>
    <ul class="wheel-list">
      {EDGES.map((e) => (
        <li><a href={e.slug}>{e.id} — {e.service}</a></li>
      ))}
    </ul>
  </noscript>
</div>

<style>
  /* la rueda completa vive fija a 880×880 dentro de un card con scroll
     horizontal (comportamiento del brand book: nada baja de 14px) */
  .wheel-stage {
    position: relative;
    width: 880px;
    height: 880px;
    margin: 0 auto;
    flex: none;
  }
  .wheel-stage[data-compact='1'] { width: 100%; max-width: 620px; height: 560px; }
  .wheel-canvas { width: 100%; height: 100%; display: block; }
  .wheel-overlay { position: absolute; inset: 0; pointer-events: none; }

  .wl {
    position: absolute;
    top: 0; left: 0;
    pointer-events: auto;
    transition: opacity var(--t-ui) var(--ease);
  }

  /* lockup de edge: ancho FIJO por contexto — el SVG (viewBox proporcional)
     siempre escala dentro de ese ancho, así "intelligence" nunca desborda
     su sector: se auto-ajusta proporcionalmente, nunca se sale. */
  .wl-edge { width: 118px; }
  [data-compact='1'] .wl-edge { width: 96px; }

  /* etiqueta de fase — 16px, tracking 2.6px, 600 */
  .wl-band { font-size: 16px; letter-spacing: 2.6px; font-weight: 600; }

  .wl-hub { width: 148px; }

  /* estados: en el hub de fase solo vive la fase enfocada; en servicio, nada */
  [data-mode='service'] .wl,
  [data-mode='phase'] .wl { opacity: 0; pointer-events: none; }
  [data-mode='phase'][data-focus='evaluacion'] .wl-phase-evaluacion,
  [data-mode='phase'][data-focus='capacidades'] .wl-phase-capacidades,
  [data-mode='phase'][data-focus='ejecucion'] .wl-phase-ejecucion { opacity: 1; pointer-events: auto; }

  /* fallback sin WebGL: retícula de lockups */
  .wheel-stage.is-fallback { aspect-ratio: auto; }
  .wheel-stage.is-fallback .wheel-canvas { display: none; }
  .wheel-stage.is-fallback .wheel-overlay { position: static; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .wheel-stage.is-fallback .wl { position: static; transform: none; background: var(--bg); padding: 24px; }
  .wheel-stage.is-fallback .wl-hub { grid-column: 1 / -1; }
  .wheel-list { list-style: none; display: grid; gap: 10px; padding: 24px; }

  /* móvil: la rueda completa mantiene 880px y el card hace scroll horizontal
     (regla del brand book: ninguna etiqueta baja de 14px); la compacta sí se adapta */
  @media (max-width: 760px) {
    .wheel-stage[data-compact='1'] { max-width: 100%; height: 440px; }
  }
</style>

<script>
  import '../scripts/engine-wheel.js';
</script>
