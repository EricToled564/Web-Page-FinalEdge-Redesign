---
/* Banda azul de cierre — antes vivía SOLO en el home; pedido 2026-07-19
   ("quiero que la última banda azul quede igual en todas las otras
   páginas pero quiero que cambie de color dependiendo de dónde esté"):
   ahora vive en Base.astro y sale en TODAS las páginas, con el color
   de fase de cada servicio en vez de un azul fijo. blue-edge-bg.js ya
   sabe leer --pc del host del canvas y caer a --accent si no hay
   (mismo mecanismo que los hubs de fase) — aquí solo se estampa --pc
   en la sección cuando la página manda un color. */
interface Props { color?: string }
const { color } = Astro.props as Props;
---
<section class="closing-band" aria-label="Tu ventaja definitiva" style={color ? `--pc:${color}` : undefined}>
  <canvas class="band-static" data-blue-edge aria-hidden="true"></canvas>
  <div class="closing-band-scene">
    <!-- logo-mono-light.png (no logo-finaledge.png): variante mono
         horneada del brand book, >_ y [AI] ya en plata, relieve 3D
         intacto (R5.4/R5.5, pedido explícito 2026-07-19). Además
         neutraliza el logo frente al color de fase de cada página. -->
    <img
      class="closing-band-logo"
      src="/assets/logos/logo-mono-light.png"
      alt="final edge [AI]"
      width="220"
      loading="lazy"
    />
    <p class="closing-band-tagline"><span class="prompt">&gt;_</span> tu ventaja definitiva</p>
    <!-- sin destino funcional todavía (pedido explícito) — <button>,
         no <a href="#">, para no simular una navegación que no existe. -->
    <div class="closing-band-ctas">
      <button type="button" class="closing-band-cta">Por qué elegirnos</button>
      <button type="button" class="closing-band-cta">Test: ¿Estás preparado para trabajar con IA?</button>
      <button type="button" class="closing-band-cta">Blog</button>
    </div>
  </div>
</section>

<style>
  .closing-band {
    position: relative;
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
    padding: 120px 72px;
    overflow: hidden;
  }
  /* reporte 2026-07-19 ("espacio magenta enorme y vacío en móvil"): el
     scope de Astro es por componente — .band-static traía su
     position:absolute definido dentro del <style> de index.astro
     nada más, así que aquí el canvas caía en flujo normal de
     documento con el alto que blue-edge-bg.js le pone (pensado para
     llenar un contenedor ABSOLUTO, no para ser un bloque más), y
     empujaba los botones cientos de píxeles hacia abajo. Mismo canon
     que .band-static en index.astro / .hub-static en engine/[phase]. */
  .band-static { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .closing-band-scene {
    position: relative; /* encima del canvas de estática */
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }
  .closing-band-logo { display: inline-block; width: 220px; height: auto; }
  /* mismo tamaño que el texto de las tarjetas de "la presión"
     (var(--text-body), pedido 2026-07-19) — minúscula, con el prompt,
     igual que el footer. */
  .closing-band-tagline {
    margin-top: 16px;
    font-family: var(--font-ui);
    font-size: var(--text-body);
    color: var(--on-accent);
  }
  /* >_ en plata (--silver), no on-accent (pedido 2026-07-19) — mismo
     tono que el >_ del lockup de arriba. */
  .closing-band-tagline .prompt { color: var(--silver); }
  .closing-band-ctas {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .closing-band-cta {
    font-family: var(--font-ui);
    font-size: var(--text-label);
    text-transform: none;
    letter-spacing: .02em;
    color: var(--on-accent);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--on-accent) 40%, transparent);
    padding: 16px 28px;
    cursor: pointer;
    transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .closing-band-cta:hover { background: var(--on-accent); color: var(--pc, var(--accent)); border-color: var(--on-accent); }
  .closing-band-cta:active { background: color-mix(in srgb, var(--on-accent) 85%, transparent); }
  @media (max-width: 760px) {
    .closing-band { padding: 88px 24px; }
  }
</style>
