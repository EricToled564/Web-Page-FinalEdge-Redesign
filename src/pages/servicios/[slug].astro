    transition: color var(--t-hover) var(--ease);
  }
  .tech-stage:hover .tech-stage-cta { color: var(--pc, var(--accent)); }
  .tech-stage-cta svg { width: 14px; height: 14px; }
  /* tira numerada bajo la pantalla — mismo ancho tope que la pantalla
     para que sus bordes queden alineados */
  .tech-strip { margin-top: 14px; width: min(100%, calc((100vh - 342px) * 16 / 9)); }
  .tech-videos-group {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
