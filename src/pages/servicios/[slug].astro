---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../../data/engine.js';

export function getStaticPaths() {
  return EDGES.map((e) => ({
    params: { slug: e.slug.split('/').filter(Boolean).pop() },
    props: { edge: e },
  }));
}
const { edge } = Astro.props;
const phase = phaseOfEdge(edge);
/* el otro servicio de la misma fase — botón "Explorar …" bajo el
   statement (pedido 2026-07-14) */
const sibling = EDGES.find((e) => e.phase === edge.phase && e.id !== edge.id);
/* Muestra del rediseño del landing de servicios (pedido 2026-07-13),
   empezando por el hero: video de fondo + el lockup horneado centrado
   encima, con su plancha negra exacta debajo (mismo patrón que el logo
   del hero del home: la plancha se genera del propio mapa de alfa del
   PNG — cuerpo sólido de los glifos en negro, halo y anti-alias sin
   tocar — y va como background del MISMO <img>, así la alineación es
   exacta por construcción). Un servicio entra al mapa cuando el cliente
   entrega su video (w/h = tamaño real de su PNG horneado); los que aún
   no lo tienen conservan el hero anterior. */
/* f = factor de ancho que iguala el TAMAÑO VISUAL de los 6 logos
   (reporte 2026-07-13: "logos de diferentes tamaños"): a ancho fijo,
   "flow" (4 letras) renderiza glifos enormes e "intelligence" (12)
   diminutos, porque cada PNG trae su propia escala interna. El factor
   se calculó midiendo la altura en píxeles del glifo ">_" de cada PNG
   (mismo elemento de marca en los 6, proporcional a la escala del
   lockup: strategy 228px, intelligence 226, readiness 236, flow 322,
   systems 234, creative 259) y despejando el ancho que deja esa altura
   RENDERIZADA idéntica a la de creative (la muestra aprobada) a 560px:
   f = (259 × Wᵢ) / (1284 × promptHᵢ). */
const VIDEO_HEROES = {
  creative: { w: 1284, h: 465, f: 1 },
  intelligence: { w: 1302, h: 482, f: 1.1621 },
  readiness: { w: 1323, h: 449, f: 1.1308 },
  systems: { w: 1182, h: 438, f: 1.0189 },
  flow: { w: 1279, h: 634, f: 0.8012 },
  strategy: { w: 1416, h: 566, f: 1.2528 },
};
const videoHero = VIDEO_HEROES[edge.id]
  ? {
      ...VIDEO_HEROES[edge.id],
      src: `/assets/video/svc-${edge.id}-hero.mp4`,
      poster: `/assets/video/svc-${edge.id}-hero-poster.jpg`,
      logo: `/assets/logos/logo-${edge.id}.png`,
      plate: `/assets/logos/logo-${edge.id}-plate.png`,
    }
  : null;
/* Sección de video con animación disparada por scroll (pedido
   2026-07-13, técnica de referencia descrita por el cliente): el video
   empieza chico, centrado y semitransparente; conforme se baja crece
   (scale) y se aclara (opacity) hasta ocupar el ancho completo, y
   arranca solo al hacerse visible (autoplay muted). SOLO el video —
   el cliente pidió explícitamente quitar cualquier otra imagen o
   miniatura de esta sección (2026-07-13). Hoy solo creative la tiene. */
const FEATURE_VIDEOS = {
  creative: {
    src: '/assets/video/svc-creative-feature.mp4',
    poster: '/assets/video/svc-creative-feature-poster.jpg',
  },
};
const featureVideo = FEATURE_VIDEOS[edge.id] ?? null;
---
<Base
  title={`${edge.service} — Final Edge`}
  description={edge.summary}
>
  {videoHero ? (
    <section class={`svc-vhero${featureVideo ? ' svc-vhero--tabbed' : ''}`} style={`--pc:${phase.color}; --plate:url('${videoHero.plate}'); --logo-f:${videoHero.f}`}>
      <video
        class="svc-vhero-video"
        data-svc-hero-video
        src={videoHero.src}
        poster={videoHero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <img
        class="svc-vhero-logo"
        src={videoHero.logo}
        alt={`${edge.id} [AI]`}
        width={videoHero.w}
        height={videoHero.h}
      />
      {edge.statement && (
        <div class="svc-vhero-copy reveal">
          <p class="svc-statement">{edge.statement}</p>
          <!-- "Conoce más" + flecha hacia abajo (pedido 2026-07-15):
               centrado bajo el texto principal; al presionarlo baja a
               la siguiente lámina de este servicio (ver initSvcMore). -->
          <button class="svc-more" type="button" data-svc-more>
            Conoce más
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
          </button>
        </div>
      )}
      <!-- Flechas de navegación (pedido 2026-07-15, sustituyen a los dos
           botones): IZQUIERDA regresa a la fase; DERECHA lleva al otro
           servicio de la fase. Escritorio y móvil por igual. -->
      {edge.statement && (
        <div class={`svc-vhero-actions reveal${featureVideo ? ' svc-vhero-actions--tabbed' : ''}`}>
          <a class="svc-arrow" href={phase.slug} aria-label={`Regresar a ${phase.name}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
          </a>
          {sibling && (
            <a class="svc-arrow" href={sibling.slug} aria-label={`Siguiente servicio: ${sibling.service}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </a>
          )}
        </div>
      )}
    </section>
  ) : (
  <section class="svc-hero" style={`--pc:${phase.color}`}>
    <div class="svc-grid">
      <div class="svc-wheel">
        <EngineWheel compact />
      </div>
      <div>
        <p class="svc-crumb reveal">
          <a href={phase.slug}>FASE {phase.num} · {phase.label}</a>
        </p>
        <h1 class="svc-title reveal">
          <LockupMark word={edge.id} tag="[AI]" color={phase.color} variant="big" transition:name={`edge-${edge.id}`} />
        </h1>
        <p class="svc-service reveal">{edge.service}</p>
        <p class="svc-hook reveal">{edge.hook}</p>
        <p class="lead reveal">{edge.summary}</p>
        <div class="svc-actions reveal">
          <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        </div>
      </div>
    </div>
  </section>
  )}

  {featureVideo && (
    <section class="svc-feature" data-svc-feature data-state="idle" style={`--pc:${phase.color}`}>
      <div class="svc-feature-stage">
        <p class="svc-feature-label" aria-hidden="true">Conoce lo que podemos hacer:</p>
        <div class="svc-feature-frame" data-svc-frame>
          <video
            class="svc-feature-video"
            data-svc-feature-video
            src={featureVideo.src}
            poster={featureVideo.poster}
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
          ></video>
          <!-- Controles DENTRO del video (pedido 2026-07-15): play/pausa y
               volumen; visibles solo cuando la pantalla está expandida. -->
          <div class="svc-feature-controls" data-svc-controls>
            <button class="svc-ctl" data-svc-play data-playing="0" type="button" aria-label="Reproducir o pausar el video">
              <svg class="svc-ctl-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="8 5 19 12 8 19 8 5"></polygon></svg>
              <svg class="svc-ctl-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.4" height="14"></rect><rect x="13.6" y="5" width="3.4" height="14"></rect></svg>
            </button>
            <button class="svc-ctl svc-sound" data-svc-sound data-sound="off" type="button" aria-label="Activar o silenciar el sonido del video">
              <svg class="svc-sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"></polygon><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
              <svg class="svc-sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"></polygon><line x1="15" y1="9" x2="21" y2="15"></line><line x1="21" y1="9" x2="15" y2="15"></line></svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section" style={`--pc:${phase.color}`}>
    <div class="hairline-grid grid-3 reveal">
      {edge.stats.map(([num, txt]) => (
        <div>
          <p class="svc-stat-num" style={`color:${phase.color}`}>{num}</p>
          <p class="svc-stat-txt">{txt}</p>
        </div>
      ))}
    </div>
    <blockquote class="svc-quote reveal">«{edge.quote}»</blockquote>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>¿para qué sirve?</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.uses.map(([t, d], i) => (
        <div>
          <p class="svc-use-num prompt">{String(i + 1).padStart(2, '0')}</p>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>entregables reales</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.proof.map(([t, d]) => (
        <div>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
    <p class="svc-closing reveal">{edge.closing}</p>
    <div class="svc-actions reveal" style="margin-top:40px">
      <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
      <a class="btn btn--ghost" href={phase.slug}>Volver a {phase.name}</a>
    </div>
  </section>
</Base>

<style>
  /* hero de video (muestra del rediseño, hoy solo creative): pantalla
     completa bajo el nav, video sangrado a los bordes, logo horneado
     centrado. La plancha negra exacta va como background del MISMO
     <img> estirado a 100% 100% — misma caja y malla de píxeles que el
     logo, alineación exacta por construcción (ver el patrón original
     en .hero-logo de index.astro). */
  .svc-vhero {
    position: relative;
    min-height: calc(100vh - 92px);
    display: flex;
    /* columna: logo arriba, statement + botones debajo (mock 2026-07-14) */
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    overflow: hidden;
  }
  .svc-vhero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-vhero-logo {
    position: relative;
    /* base común min(560px, 70vw) multiplicada por el factor de
       igualación visual de cada logo (--logo-f, ver VIDEO_HEROES): el
       factor va FUERA del min() a propósito — así en pantallas chicas
       los 6 se encogen por el mismo múltiplo y siguen viéndose del
       mismo tamaño entre sí, en vez de que el min() recorte antes a
       los factores grandes.
       × 0.41 = reducción del 59% pedida explícitamente 2026-07-13
       ("reduzcas todos los logos de los heros de los servicios en un
       59%") — multiplica a los 6 por igual, así la igualación visual
       recién calibrada se conserva intacta. */
    width: calc(var(--logo-f, 1) * min(560px, 70vw) * 0.41);
    height: auto;
    background: var(--plate) center / 100% 100% no-repeat;
  }

  /* Animación disparada por scroll (técnica de referencia del cliente):
     la sección mide 260vh — el visor (sticky) se queda clavado bajo el
     nav mientras el usuario "recorre" esos 260vh, y ese progreso de
     scroll ES la línea de tiempo (mapeo posicional directo, sin easing
     — mismo principio que initCosmosScroll en el home): el video pasa
     de scale .35 / opacity .35 a 1 / 1, y las miniaturas del fondo se
     desvanecen y abren paso. El script solo escribe transform/opacity
     (nunca layout) vía requestAnimationFrame. */
  /* Arranque tipo "pestaña" (diagrama del cliente 2026-07-14): la
     sección sube sobre el hero con margen negativo, de modo que al
     cargar la página se vean DENTRO del hero la leyenda "Conoce lo que
     podemos hacer:" y el borde superior del video chico — una pestaña
     que invita a bajar. Por eso el visor dejó de centrar el video:
     leyenda y video van anclados arriba (columna), y el video crece
     hacia abajo desde su borde superior (transform-origin: top). */
  /* -14vh (antes -26vh): la pestaña se redujo 60% a pedido (2026-07-14)
     — en el hero solo asoma la leyenda y un rectángulo del borde
     superior del video. */
  /* Sección de video con SCROLL-LOCK por gestos (rediseño 2026-07-15):
     un flick hacia abajo expande el video al 100% y TRABA el scroll;
     otro flick lo destraba y pausa; click alterna play/pausa. El stage
     se fija (sticky) durante un rango de scroll (la sección mide 160vh)
     para que el gesto de expansión siempre tenga dónde engancharse. */
  .svc-feature { height: 160vh; position: relative; z-index: 2; margin-top: -14vh; }
  .svc-feature-stage {
    position: sticky;
    top: 92px;
    height: calc(100vh - 92px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    overflow: hidden;
  }
  /* misma voz que "Conoce más:" en los hubs (Geist Mono 600 —
     tipografía aprobada del brand book), en blanco sobre el hero.
     Desaparece cuando el video se expande. */
  .svc-feature-label {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 18.2px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent);
    white-space: nowrap;
    transition: opacity var(--t-ui) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-label { opacity: 0; }
  /* el frame contiene el video + los controles y es lo que escala */
  .svc-feature-frame {
    position: relative;
    display: block;
    width: min(1400px, 94vw);
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 140px);
    transform: scale(0.4);
    transform-origin: center;
    opacity: 0.55;
    border: 2px solid var(--pc, var(--accent));
    cursor: pointer;
    transition: transform var(--t-enter) var(--ease), opacity var(--t-enter) var(--ease);
    will-change: transform, opacity;
  }
  .svc-feature[data-state='expanded'] .svc-feature-frame {
    transform: scale(1);
    opacity: 1;
  }
  .svc-feature-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* controles DENTRO del video (pedido 2026-07-15): visibles solo al
     expandir. Sin sombras (R3.2): chips con hairline como el resto. */
  .svc-feature-controls {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-ui) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-controls {
    opacity: 1;
    pointer-events: auto;
  }
  .svc-ctl {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    border: 1px solid var(--hairline);
    cursor: pointer;
    transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
  }
  .svc-ctl:hover { background: var(--fg); color: var(--bg); }
  .svc-ctl svg { width: 22px; height: 22px; }
  .svc-ctl[data-playing='1'] .svc-ctl-play { display: none; }
  .svc-ctl[data-playing='0'] .svc-ctl-pause { display: none; }
  .svc-sound[data-sound='on'] .svc-sound-off { display: none; }
  .svc-sound[data-sound='off'] .svc-sound-on { display: none; }

  /* con movimiento reducido no hay scroll-lock: el video se muestra
     completo y los controles siempre visibles. */
  @media (prefers-reduced-motion: reduce) {
    .svc-feature { height: auto; margin-top: 0; }
    .svc-feature-stage { position: static; height: auto; padding: 96px 24px; }
    .svc-feature-frame { transform: none; opacity: 1; }
    .svc-feature-controls { opacity: 1; pointer-events: auto; }
    .svc-feature-label { display: none; }
  }

  /* statement del servicio (copy del cliente 2026-07-14) DENTRO del
     hero, abajo del logo (pedido 2026-07-14 con mock): mismo font que
     los statements de las fases (la referencia .engine-h2 del home:
     clamp(14px, 1.3vw, 16px), peso 400, espaciado normal, interlineado
     1.12), en blanco y con sombra oscura debajo del texto para
     garantizar la legibilidad sobre el video — pedido explícito. */
  .svc-vhero-copy {
    position: relative;
    max-width: 62ch;
    padding: 0 24px;
  }
  .svc-statement {
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.12;
    /* centrado (pedido explícito 2026-07-14) */
    text-align: center;
    color: color-mix(in srgb, var(--fg) 92%, transparent);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 70%, transparent),
                 0 3px 14px color-mix(in srgb, var(--void-deep) 55%, transparent);
  }
  /* botones del hero de servicio (pedido 2026-07-14): uno al lado del
     otro, cerca del borde inferior de la lámina, con fondo SÓLIDO del
     color de la fase y tinta oscura encima. En creative suben por
     encima de la pestaña del video que asoma en el hero (-14vh). */
  .svc-vhero-actions {
    position: absolute;
    /* 14px (antes 30): "mucho menos prominentes y más cerca al borde
       inferior del slide" — pedido 2026-07-15 */
    bottom: 14px;
    /* centrado sin transform: .reveal anima transform y lo pisaría */
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    width: max-content;
    max-width: calc(100vw - 48px);
  }
  .svc-vhero-actions--tabbed { bottom: calc(14vh + 8px); }
  /* Flechas de navegación (pedido 2026-07-15, sustituyen a los dos
     botones): chip cuadrado con el hex exacto de la fase, trazo oscuro,
     hover invertido a blanco — mismo lenguaje que las flechas de los
     hubs. Área táctil de 52px. */
  .svc-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--pc, var(--accent));
    border: 1px solid var(--pc, var(--accent));
    color: var(--void-deep);
    transition: background var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .svc-arrow svg { width: 24px; height: 24px; }
  .svc-arrow:hover,
  .svc-arrow:active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--void-deep);
  }
  /* "Conoce más" + flecha hacia abajo, centrado bajo el statement
     (pedido 2026-07-15): misma voz tipográfica del texto, con la sombra
     ya exceptuada para leerse sobre el video. */
  .svc-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 26px auto 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 600;
    letter-spacing: normal;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 70%, transparent);
    transition: color var(--t-hover) var(--ease);
  }
  .svc-more svg { width: 22px; height: 22px; }
  .svc-more:hover { color: var(--pc, var(--accent)); }

  .svc-hero { padding: 150px 72px 88px; }
  .svc-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .svc-crumb a { font-size: 14px; letter-spacing: .24em; color: var(--pc); }
  .svc-crumb a:hover { color: var(--fg); }
  .svc-title { margin-top: 20px; width: min(560px, 100%); }
  .svc-service { margin-top: 18px; font-size: var(--text-subtitle); color: var(--fg); font-weight: 500; }
  .svc-hook { margin: 12px 0 16px; font-size: var(--text-manifesto); letter-spacing: -.025em; color: var(--fg-2); }
  .svc-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  .svc-stat-num { font-size: clamp(30px, 3.4vw, 46px); font-weight: 600; letter-spacing: -.04em; }
  .svc-stat-txt { margin-top: 10px; font-size: 14px; color: var(--fg-muted); }
  .svc-quote {
    margin-top: 56px;
    border-left: 2px solid var(--pc, var(--accent));
    padding-left: 28px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .svc-use-num { font-size: 14px; letter-spacing: .2em; }
  .svc-use-title { margin-top: 10px; color: var(--fg); font-weight: 500; font-size: var(--text-body); }
  .svc-use-desc { margin-top: 8px; color: var(--fg-muted); font-size: 14px; }
  .svc-closing { margin-top: 48px; font-size: var(--text-subtitle); color: var(--fg-2); max-width: 62ch; }
  @media (max-width: 980px) {
    .svc-hero { padding: 120px 24px 64px; }
    .svc-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 40px; }
    /* MÓVIL (auditoría 2026-07-14): los botones anclados al fondo se
       encimaban con el statement centrado (creative, medido en captura
       390×844) y el segundo se recortaba bajo el chip del asistente.
       En pantallas angostas vuelven al flujo, apilados y centrados
       bajo el texto. */
    .svc-vhero { padding: 32px 20px 84px; gap: 24px; }
    /* las flechas son un par compacto de 52px: se quedan ancladas al
       borde inferior también en móvil (el padding de 84px del hero les
       reserva la franja bajo el contenido centrado). */
    /* creative: la pestaña del video asoma en el fondo del hero (-14vh)
       — el contenido centrado le deja esa franja libre */
    .svc-vhero--tabbed { padding-bottom: 17vh; }
  }
</style>

<script>
  /* Arranque del video del hero de servicio — MISMO patrón blindado que
     el video del hero del home (index.astro), duplicado a propósito: el
     del home está verificado con reproducción real y congelado; una
     abstracción compartida ahora arriesgaría regresarlo. Capas:
     reconstrucción del elemento en cada regreso SPA, reintentos con
     vigilancia, load() de rescate y arranque por gesto (Safari). */
  /* Conecta el blob precargado (window.__videoWarm, ver Base.astro) al
     <video> del hero: cero red al llegar — MEDIDO que el <video> jamás
     reutiliza la caché HTTP del prefetch (fix 2026-07-15, "los videos
     tardan mucho en comenzar de nuevo"). Solo si el clip aún no corre:
     si el blob resuelve tarde y el clip ya avanza por red, no se
     reinicia. */
  function applyWarmSrc(v: HTMLVideoElement) {
    const src = v.getAttribute('src');
    const warm = (window as any).__videoWarm;
    const p = warm && src ? warm[src] : null;
    if (!p) return;
    Promise.resolve(p).then((url) => {
      if (url && v.isConnected && !v.dataset.warmed && v.currentTime < 0.3) {
        v.dataset.warmed = '1';
        v.src = url;
        v.muted = true;
        v.play().catch(() => {});
      }
    }).catch(() => {});
  }

  document.addEventListener('astro:after-swap', () => {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    const n = v.cloneNode(false) as HTMLVideoElement;
    n.muted = true;
    n.defaultMuted = true;
    v.replaceWith(n);
    applyWarmSrc(n);
    n.play().catch(() => {});
  });

  let svcWatch = 0;
  function playSvcHeroVideo() {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    applyWarmSrc(v);
    const kick = () => { if (v.isConnected && v.paused) { v.muted = true; v.play().catch(() => {}); } };
    kick();
    v.addEventListener('loadeddata', kick, { once: true });
    clearInterval(svcWatch);
    const t0 = Date.now();
    let reloaded = false;
    svcWatch = setInterval(() => {
      if (!v.isConnected || v.currentTime > 0.2 || Date.now() - t0 > 10000) { clearInterval(svcWatch); return; }
      if (!reloaded && Date.now() - t0 > 3000 && v.currentTime === 0) {
        reloaded = true;
        v.addEventListener('canplay', kick, { once: true });
        try { v.load(); } catch {}
        return;
      }
      kick();
    }, 500);
    const gesture = () => { kick(); };
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, gesture, { once: true, passive: true });
    }
  }
  playSvcHeroVideo();
  document.addEventListener('astro:page-load', playSvcHeroVideo);

  /* "Conoce más" del hero (pedido 2026-07-15): baja a la SIGUIENTE
     lámina de la página del servicio — la sección que sigue al hero
     (en creative es la sección del video; en el resto, estadísticas).
     scrollIntoView nativo, sin easing propio (R3.4 no aplica a scroll
     del navegador). */
  function initSvcMore() {
    const btn = document.querySelector('[data-svc-more]') as HTMLElement | null;
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const hero = document.querySelector('.svc-vhero');
      const next = hero?.nextElementSibling;
      next?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
  initSvcMore();
  document.addEventListener('astro:page-load', initSvcMore);

  /* Sección de video con SCROLL-LOCK por gestos (rediseño 2026-07-15,
     pedido explícito): al llegar a la sección, UN flick hacia abajo
     expande el video al 100% y TRABA el scroll; aparecen los controles
     de play/pausa y volumen DENTRO del video. OTRO flick lo destraba y
     pausa el video automáticamente. Un click en la pantalla alterna
     play/pausa. Bajo prefers-reduced-motion no hay secuestro de scroll:
     el CSS deja el video completo y aquí solo se gestiona play/pausa por
     visibilidad. */
  function initSvcFeature() {
    const sec = document.querySelector('[data-svc-feature]') as HTMLElement | null;
    if (!sec) return;
    /* guardia de init ÚNICA: astro:page-load también dispara en la carga
       inicial, así que sin esto los listeners se registran dos veces. */
    if (sec.dataset.featureInit === '1') return;
    sec.dataset.featureInit = '1';
    const vid = sec.querySelector('[data-svc-feature-video]') as HTMLVideoElement;
    const frame = sec.querySelector('[data-svc-frame]') as HTMLElement | null;
    const playBtn = sec.querySelector('[data-svc-play]') as HTMLElement | null;
    const soundBtn = sec.querySelector('[data-svc-sound]') as HTMLElement | null;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let soundWanted = false;

    const syncIcons = () => {
      if (playBtn) playBtn.dataset.playing = vid.paused ? '0' : '1';
      if (soundBtn) soundBtn.dataset.sound = (!vid.muted && !vid.paused) ? 'on' : 'off';
    };
    for (const ev of ['play', 'pause', 'volumechange']) vid.addEventListener(ev, syncIcons);

    /* play blindado: reintenta y, si el navegador bloquea el audio sin
       gesto, revierte a mudo y sigue corriendo. */
    const playVid = (wantSound: boolean) => {
      vid.muted = !wantSound;
      vid.play().then(syncIcons).catch(() => {
        if (wantSound) { soundWanted = false; vid.muted = true; vid.play().catch(() => {}); }
        syncIcons();
      });
    };
    const pauseVid = () => { vid.pause(); syncIcons(); };
    const toggleVid = () => { if (vid.paused) playVid(soundWanted); else pauseVid(); };

    /* CLICK en la pantalla = iniciar/parar (pedido 2026-07-15). El click
       en los controles no cuenta como click de pantalla. */
    frame?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-svc-controls]')) return;
      toggleVid();
    });
    playBtn?.addEventListener('click', (e) => { e.stopPropagation(); toggleVid(); });
    soundBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (vid.muted) { soundWanted = true; vid.muted = false; if (vid.paused) playVid(true); }
      else { soundWanted = false; vid.muted = true; }
      syncIcons();
    });

    if (reduced) {
      /* sin secuestro de scroll: play/pausa por visibilidad */
      sec.dataset.state = 'expanded';
      const io = new IntersectionObserver((es) => {
        const en = es[es.length - 1];
        if (en.isIntersecting) playVid(soundWanted); else pauseVid();
      }, { threshold: 0.4 });
      io.observe(vid);
      return;
    }

    /* ---- máquina de estados del scroll-lock ---- */
    let locked = false;     // expandido + scroll bloqueado
    let released = false;   // ya soltado en esta pasada; se re-arma al salir de la zona
    /* "un gesto" = un flick: inGesture se mantiene mientras lleguen
       eventos de rueda seguidos y se limpia tras 180ms de quietud, así
       la inercia del trackpad no cuenta como varios gestos. */
    let inGesture = false, gTimer = 0;
    const endGestureSoon = () => { clearTimeout(gTimer); gTimer = window.setTimeout(() => { inGesture = false; }, 180); };

    const vh = () => innerHeight || 800;
    /* el stage (sticky top:92) está fijado y llenando el visor cuando el
       tope de la sección ya cruzó el nav y su fondo sigue por debajo. */
    const centered = () => {
      const r = sec.getBoundingClientRect();
      return r.top <= 96 && r.bottom >= vh() - 4;
    };

    const expand = () => {
      locked = true; released = false;
      sec.dataset.state = 'expanded';
      playVid(soundWanted);
      /* intento de sonido automático al expandir (una vez) */
      if (!soundWanted) {
        soundWanted = true; vid.muted = false; vid.play().catch(() => {});
        setTimeout(() => {
          if (vid.paused || vid.muted) { soundWanted = false; vid.muted = true; vid.play().catch(() => {}); }
          syncIcons();
        }, 150);
      }
    };
    const collapse = (dir: number) => {
      locked = false; released = true;
      sec.dataset.state = 'idle';
      pauseVid();
      /* empujar el scroll fuera de la zona de fijado para no re-enganchar
         y dejar ver la siguiente lámina (abajo) o el hero (arriba). */
      const r = sec.getBoundingClientRect();
      if (dir > 0) scrollBy({ top: Math.max(80, r.bottom - vh() + 80), behavior: 'smooth' });
      else scrollBy({ top: Math.min(-80, r.top - 92 - 80), behavior: 'smooth' });
    };

    /* RUEDA — no-pasivo para poder preventDefault (trabar el scroll) */
    addEventListener('wheel', (e) => {
      /* ignorar micro-scrolls / delta 0 (un trackpad quieto o un rebote
         no deben contar como gesto — si no, destraba solo) */
      if (Math.abs(e.deltaY) < 6) { if (locked) e.preventDefault(); return; }
      if (locked) {
        e.preventDefault();                 // trabado: bloquea el scroll de la página
        const dir = e.deltaY > 0 ? 1 : -1;
        if (!inGesture) { inGesture = true; collapse(dir); }  // un flick = destrabar + pausar
        endGestureSoon();
        return;
      }
      if (!centered()) { released = false; return; }  // fuera de la zona: re-armar
      if (released) return;                            // en zona pero ya usado: scroll normal hasta salir
      if (e.deltaY > 0) {                              // flick hacia abajo en la zona → expandir + trabar
        e.preventDefault();
        if (!inGesture) { inGesture = true; expand(); }
        endGestureSoon();
      }
    }, { passive: false });

    /* TECLADO mientras está trabado */
    addEventListener('keydown', (e) => {
      if (!locked) return;
      if (e.key === ' ') { e.preventDefault(); toggleVid(); }
      else if (e.key === 'ArrowDown' || e.key === 'PageDown') { e.preventDefault(); collapse(1); }
      else if (e.key === 'ArrowUp' || e.key === 'PageUp') { e.preventDefault(); collapse(-1); }
    });

    /* TÁCTIL (móvil) — mismo modelo por swipe */
    let touchY = 0;
    addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { passive: true });
    addEventListener('touchmove', (e) => {
      const dy = touchY - e.touches[0].clientY; // >0 = swipe hacia arriba (scroll down)
      if (locked) {
        e.preventDefault();
        if (Math.abs(dy) > 40 && !inGesture) { inGesture = true; collapse(dy > 0 ? 1 : -1); }
        return;
      }
      if (!centered()) { released = false; return; }
      if (released) return;
      if (dy > 40) { e.preventDefault(); if (!inGesture) { inGesture = true; expand(); } }
    }, { passive: false });
    addEventListener('touchend', () => { inGesture = false; }, { passive: true });

    /* re-armar al salir por completo de la sección (por si se soltó y se
       vuelve a entrar desde cualquier lado) */
    const io = new IntersectionObserver((es) => {
      const en = es[es.length - 1];
      if (!en.isIntersecting) {
        released = false; locked = false;
        if (sec.dataset.state === 'expanded') { sec.dataset.state = 'idle'; pauseVid(); }
      }
    }, { threshold: 0 });
    io.observe(sec);
  }
  initSvcFeature();
  document.addEventListener('astro:page-load', initSvcFeature);
</script>
