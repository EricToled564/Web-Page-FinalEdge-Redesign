    color: var(--fg);
    font: inherit;
    text-align: left;
    transition: border-color var(--t-hover) var(--ease), transform var(--t-hover) var(--ease);
  }
  .work-card:hover { border-color: var(--pc, var(--accent)); transform: translateY(-4px); }
  .work-card-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--hairline); }
  .work-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-enter) var(--ease); }
  .work-card:hover .work-card-media img { transform: scale(1.05); }
  .work-card-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
