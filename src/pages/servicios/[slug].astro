  .work-card-num { color: var(--pc, var(--accent)); font-weight: 700; font-size: 14px; }
  .work-card:hover { border-color: color-mix(in srgb, var(--pc, var(--accent)) 55%, var(--hairline)); }
  /* pantalla de reproducción: overlay oscuro con el player nativo */
  .work-player {
