---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../../data/engine.js';

export function getStaticPaths() {
  return EDGES.map((e) => ({
    params: { slug: e.slug.split('/').filter(Boolean).pop() },
    props: { edge: e },
  }));
}
const { edge } = Astro.props;
const phase = phaseOfEdge(edge);
/* Muestra del rediseño del landing de servicios (pedido 2026-07-13),
   empezando por el hero: video de fondo + el lockup horneado centrado
   encima, con su plancha negra exacta debajo (mismo patrón que el logo
   del hero del home: la plancha se genera del propio mapa de alfa del
   PNG — cuerpo sólido de los glifos en negro, halo y anti-alias sin
   tocar — y va como background del MISMO <img>, así la alineación es
   exacta por construcción). Un servicio entra al mapa cuando el cliente
   entrega su video (w/h = tamaño real de su PNG horneado); los que aún
   no lo tienen conservan el hero anterior. */
/* f = factor de ancho que iguala el TAMAÑO VISUAL de los 6 logos
   (reporte 2026-07-13: "logos de diferentes tamaños"): a ancho fijo,
   "flow" (4 letras) renderiza glifos enormes e "intelligence" (12)
   diminutos, porque cada PNG trae su propia escala interna. El factor
   se calculó midiendo la altura en píxeles del glifo ">_" de cada PNG
   (mismo elemento de marca en los 6, proporcional a la escala del
   lockup: strategy 228px, intelligence 226, readiness 236, flow 322,
   systems 234, creative 259) y despejando el ancho que deja esa altura
   RENDERIZADA idéntica a la de creative (la muestra aprobada) a 560px:
   f = (259 × Wᵢ) / (1284 × promptHᵢ). */
const VIDEO_HEROES = {
  creative: { w: 1284, h: 465, f: 1 },
  intelligence: { w: 1302, h: 482, f: 1.1621 },
  readiness: { w: 1323, h: 449, f: 1.1308 },
  systems: { w: 1182, h: 438, f: 1.0189 },
  flow: { w: 1279, h: 634, f: 0.8012 },
  strategy: { w: 1416, h: 566, f: 1.2528 },
};
const videoHero = VIDEO_HEROES[edge.id]
  ? {
      ...VIDEO_HEROES[edge.id],
      src: `/assets/video/svc-${edge.id}-hero.mp4`,
      poster: `/assets/video/svc-${edge.id}-hero-poster.jpg`,
      logo: `/assets/logos/logo-${edge.id}.png`,
      plate: `/assets/logos/logo-${edge.id}-plate.png`,
    }
  : null;
/* Sección de video con animación disparada por scroll (pedido
   2026-07-13, técnica de referencia descrita por el cliente): el video
   empieza chico, centrado y semitransparente; conforme se baja crece
   (scale) y se aclara (opacity) hasta ocupar el ancho completo, y
   arranca solo al hacerse visible (autoplay muted). SOLO el video —
   el cliente pidió explícitamente quitar cualquier otra imagen o
   miniatura de esta sección (2026-07-13). Hoy solo creative la tiene. */
const FEATURE_VIDEOS = {
  creative: {
    src: '/assets/video/svc-creative-feature.mp4',
    poster: '/assets/video/svc-creative-feature-poster.jpg',
  },
};
const featureVideo = FEATURE_VIDEOS[edge.id] ?? null;
---
<Base
  title={`${edge.service} — Final Edge`}
  description={edge.summary}
>
  {videoHero ? (
    <section class="svc-vhero" style={`--pc:${phase.color}; --plate:url('${videoHero.plate}'); --logo-f:${videoHero.f}`}>
      <video
        class="svc-vhero-video"
        data-svc-hero-video
        src={videoHero.src}
        poster={videoHero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <img
        class="svc-vhero-logo"
        src={videoHero.logo}
        alt={`${edge.id} [AI]`}
        width={videoHero.w}
        height={videoHero.h}
      />
    </section>
  ) : (
  <section class="svc-hero" style={`--pc:${phase.color}`}>
    <div class="svc-grid">
      <div class="svc-wheel">
        <EngineWheel compact />
      </div>
      <div>
        <p class="svc-crumb reveal">
          <a href={phase.slug}>FASE {phase.num} · {phase.label}</a>
        </p>
        <h1 class="svc-title reveal">
          <LockupMark word={edge.id} tag="[AI]" color={phase.color} variant="big" transition:name={`edge-${edge.id}`} />
        </h1>
        <p class="svc-service reveal">{edge.service}</p>
        <p class="svc-hook reveal">{edge.hook}</p>
        <p class="lead reveal">{edge.summary}</p>
        <div class="svc-actions reveal">
          <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        </div>
      </div>
    </div>
  </section>
  )}

  {featureVideo && (
    <section class="svc-feature" data-svc-feature style={`--pc:${phase.color}`}>
      <div class="svc-feature-sticky">
        <video
          class="svc-feature-video"
          data-svc-feature-video
          src={featureVideo.src}
          poster={featureVideo.poster}
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        ></video>
      </div>
    </section>
  )}

  <section class="section" style={`--pc:${phase.color}`}>
    <div class="hairline-grid grid-3 reveal">
      {edge.stats.map(([num, txt]) => (
        <div>
          <p class="svc-stat-num" style={`color:${phase.color}`}>{num}</p>
          <p class="svc-stat-txt">{txt}</p>
        </div>
      ))}
    </div>
    <blockquote class="svc-quote reveal">«{edge.quote}»</blockquote>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>¿para qué sirve?</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.uses.map(([t, d], i) => (
        <div>
          <p class="svc-use-num prompt">{String(i + 1).padStart(2, '0')}</p>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>entregables reales</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.proof.map(([t, d]) => (
        <div>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
    <p class="svc-closing reveal">{edge.closing}</p>
    <div class="svc-actions reveal" style="margin-top:40px">
      <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
      <a class="btn btn--ghost" href={phase.slug}>Volver a {phase.name}</a>
    </div>
  </section>
</Base>

<style>
  /* hero de video (muestra del rediseño, hoy solo creative): pantalla
     completa bajo el nav, video sangrado a los bordes, logo horneado
     centrado. La plancha negra exacta va como background del MISMO
     <img> estirado a 100% 100% — misma caja y malla de píxeles que el
     logo, alineación exacta por construcción (ver el patrón original
     en .hero-logo de index.astro). */
  .svc-vhero {
    position: relative;
    min-height: calc(100vh - 92px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .svc-vhero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-vhero-logo {
    position: relative;
    /* base común min(560px, 70vw) multiplicada por el factor de
       igualación visual de cada logo (--logo-f, ver VIDEO_HEROES): el
       factor va FUERA del min() a propósito — así en pantallas chicas
       los 6 se encogen por el mismo múltiplo y siguen viéndose del
       mismo tamaño entre sí, en vez de que el min() recorte antes a
       los factores grandes.
       × 0.41 = reducción del 59% pedida explícitamente 2026-07-13
       ("reduzcas todos los logos de los heros de los servicios en un
       59%") — multiplica a los 6 por igual, así la igualación visual
       recién calibrada se conserva intacta. */
    width: calc(var(--logo-f, 1) * min(560px, 70vw) * 0.41);
    height: auto;
    background: var(--plate) center / 100% 100% no-repeat;
  }

  /* Animación disparada por scroll (técnica de referencia del cliente):
     la sección mide 260vh — el visor (sticky) se queda clavado bajo el
     nav mientras el usuario "recorre" esos 260vh, y ese progreso de
     scroll ES la línea de tiempo (mapeo posicional directo, sin easing
     — mismo principio que initCosmosScroll en el home): el video pasa
     de scale .35 / opacity .35 a 1 / 1, y las miniaturas del fondo se
     desvanecen y abren paso. El script solo escribe transform/opacity
     (nunca layout) vía requestAnimationFrame. */
  .svc-feature { height: 260vh; position: relative; }
  .svc-feature-sticky {
    position: sticky;
    top: 92px;
    height: calc(100vh - 92px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .svc-feature-video {
    display: block;
    width: min(1180px, 94vw);
    /* proporción declarada del clip (16:9): sin ella, el <video> mide
       150px de alto hasta que llega la metadata y al llegar SALTA a su
       alto real — ese brinco de layout desplazaba el scroll (anchoring)
       y descuadraba el progreso de la animación a media lectura. */
    aspect-ratio: 16 / 9;
    transform: scale(0.35);
    opacity: 0.35;
    will-change: transform, opacity;
  }
  /* con movimiento reducido no hay animación de scroll: el video se
     muestra completo y nítido de entrada. */
  @media (prefers-reduced-motion: reduce) {
    .svc-feature { height: auto; }
    .svc-feature-sticky { position: static; height: auto; padding: 96px 24px; }
    .svc-feature-video { transform: none; opacity: 1; }
  }

  .svc-hero { padding: 150px 72px 88px; }
  .svc-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .svc-crumb a { font-size: 14px; letter-spacing: .24em; color: var(--pc); }
  .svc-crumb a:hover { color: var(--fg); }
  .svc-title { margin-top: 20px; width: min(560px, 100%); }
  .svc-service { margin-top: 18px; font-size: var(--text-subtitle); color: var(--fg); font-weight: 500; }
  .svc-hook { margin: 12px 0 16px; font-size: var(--text-manifesto); letter-spacing: -.025em; color: var(--fg-2); }
  .svc-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  .svc-stat-num { font-size: clamp(30px, 3.4vw, 46px); font-weight: 600; letter-spacing: -.04em; }
  .svc-stat-txt { margin-top: 10px; font-size: 14px; color: var(--fg-muted); }
  .svc-quote {
    margin-top: 56px;
    border-left: 2px solid var(--pc, var(--accent));
    padding-left: 28px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .svc-use-num { font-size: 14px; letter-spacing: .2em; }
  .svc-use-title { margin-top: 10px; color: var(--fg); font-weight: 500; font-size: var(--text-body); }
  .svc-use-desc { margin-top: 8px; color: var(--fg-muted); font-size: 14px; }
  .svc-closing { margin-top: 48px; font-size: var(--text-subtitle); color: var(--fg-2); max-width: 62ch; }
  @media (max-width: 980px) {
    .svc-hero { padding: 120px 24px 64px; }
    .svc-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 40px; }
  }
</style>

<script>
  /* Arranque del video del hero de servicio — MISMO patrón blindado que
     el video del hero del home (index.astro), duplicado a propósito: el
     del home está verificado con reproducción real y congelado; una
     abstracción compartida ahora arriesgaría regresarlo. Capas:
     reconstrucción del elemento en cada regreso SPA, reintentos con
     vigilancia, load() de rescate y arranque por gesto (Safari). */
  document.addEventListener('astro:after-swap', () => {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    const n = v.cloneNode(false) as HTMLVideoElement;
    n.muted = true;
    n.defaultMuted = true;
    v.replaceWith(n);
    n.play().catch(() => {});
  });

  let svcWatch = 0;
  function playSvcHeroVideo() {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    const kick = () => { if (v.isConnected && v.paused) { v.muted = true; v.play().catch(() => {}); } };
    kick();
    v.addEventListener('loadeddata', kick, { once: true });
    clearInterval(svcWatch);
    const t0 = Date.now();
    let reloaded = false;
    svcWatch = setInterval(() => {
      if (!v.isConnected || v.currentTime > 0.2 || Date.now() - t0 > 10000) { clearInterval(svcWatch); return; }
      if (!reloaded && Date.now() - t0 > 3000 && v.currentTime === 0) {
        reloaded = true;
        v.addEventListener('canplay', kick, { once: true });
        try { v.load(); } catch {}
        return;
      }
      kick();
    }, 500);
    const gesture = () => { kick(); };
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, gesture, { once: true, passive: true });
    }
  }
  playSvcHeroVideo();
  document.addEventListener('astro:page-load', playSvcHeroVideo);

  /* Animación de la sección de video ligada al scroll (ver el CSS de
     .svc-feature): p = progreso 0→1 del recorrido de la sección; el
     scroll ES la línea de tiempo (sin easing, mapeo directo — R3.4 no
     aplica a mapeos posicionales, mismo criterio que initCosmosScroll).
     El autoplay lo gobierna un IntersectionObserver: play() al entrar
     al viewport (muted, permitido sin gesto), pause() al salir — nunca
     espera un click. Bajo prefers-reduced-motion el CSS ya dejó todo
     fijo y aquí solo se gestiona el play/pause. */
  function initSvcFeature() {
    const sec = document.querySelector('[data-svc-feature]');
    if (!sec) return;
    const vid = sec.querySelector('[data-svc-feature-video]') as HTMLVideoElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      let ticking = false;
      const update = () => {
        ticking = false;
        if (!sec.isConnected) return;
        const vh = innerHeight || 800;
        const r = sec.getBoundingClientRect();
        const total = Math.max(1, r.height - vh);
        const p = Math.min(1, Math.max(0, -r.top / total));
        vid.style.transform = `scale(${(0.35 + p * 0.65).toFixed(4)})`;
        vid.style.opacity = (0.35 + p * 0.65).toFixed(4);
      };
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }

    /* mismo criterio blindado que los heroes: al hacerse visible no se
       confía en UN solo play() — se insiste (muted reafirmado, intento
       inmediato + loadeddata) hasta que el clip de verdad corre. */
    const kick = () => { if (vid.isConnected && vid.paused) { vid.muted = true; vid.play().catch(() => {}); } };
    const io = new IntersectionObserver(([en]) => {
      if (en.isIntersecting) {
        kick();
        vid.addEventListener('loadeddata', kick, { once: true });
        setTimeout(kick, 400);
        setTimeout(kick, 1500);
      } else vid.pause();
    }, { threshold: 0.15 });
    io.observe(vid);
  }
  initSvcFeature();
  document.addEventListener('astro:page-load', initSvcFeature);
</script>
