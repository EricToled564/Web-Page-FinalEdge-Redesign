    .phase-band-inner { padding: 24px 20px 36px; }
    .phase-grid { grid-template-columns: 1fr; }
    .phase-card { border-inline-start: none; border-top: 1px solid var(--hairline); min-height: 190px; }
    .phase-card:first-child { border-top: none; }
