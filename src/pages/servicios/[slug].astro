---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../../data/engine.js';

export function getStaticPaths() {
  return EDGES.map((e) => ({
    params: { slug: e.slug.split('/').filter(Boolean).pop() },
    props: { edge: e },
  }));
}
const { edge } = Astro.props;
const phase = phaseOfEdge(edge);
/* el otro servicio de la misma fase — botón "Explorar …" bajo el
   statement (pedido 2026-07-14) */
const sibling = EDGES.find((e) => e.phase === edge.phase && e.id !== edge.id);
/* Muestra del rediseño del landing de servicios (pedido 2026-07-13),
   empezando por el hero: video de fondo + el lockup horneado centrado
   encima, con su plancha negra exacta debajo (mismo patrón que el logo
   del hero del home: la plancha se genera del propio mapa de alfa del
   PNG — cuerpo sólido de los glifos en negro, halo y anti-alias sin
   tocar — y va como background del MISMO <img>, así la alineación es
   exacta por construcción). Un servicio entra al mapa cuando el cliente
   entrega su video (w/h = tamaño real de su PNG horneado); los que aún
   no lo tienen conservan el hero anterior. */
/* f = factor de ancho que iguala el TAMAÑO VISUAL de los 6 logos
   (reporte 2026-07-13: "logos de diferentes tamaños"): a ancho fijo,
   "flow" (4 letras) renderiza glifos enormes e "intelligence" (12)
   diminutos, porque cada PNG trae su propia escala interna. El factor
   se calculó midiendo la altura en píxeles del glifo ">_" de cada PNG
   (mismo elemento de marca en los 6, proporcional a la escala del
   lockup: strategy 228px, intelligence 226, readiness 236, flow 322,
   systems 234, creative 259) y despejando el ancho que deja esa altura
   RENDERIZADA idéntica a la de creative (la muestra aprobada) a 560px:
   f = (259 × Wᵢ) / (1284 × promptHᵢ). */
const VIDEO_HEROES = {
  creative: { w: 1284, h: 465, f: 1 },
  intelligence: { w: 1302, h: 482, f: 1.1621 },
  readiness: { w: 1323, h: 449, f: 1.1308 },
  systems: { w: 1182, h: 438, f: 1.0189 },
  flow: { w: 1279, h: 634, f: 0.8012 },
  strategy: { w: 1416, h: 566, f: 1.2528 },
};
const videoHero = VIDEO_HEROES[edge.id]
  ? {
      ...VIDEO_HEROES[edge.id],
      src: `/assets/video/svc-${edge.id}-hero.mp4`,
      poster: `/assets/video/svc-${edge.id}-hero-poster.jpg`,
      logo: `/assets/logos/logo-${edge.id}.png`,
      plate: `/assets/logos/logo-${edge.id}-plate.png`,
    }
  : null;
/* Sección de video con animación disparada por scroll (pedido
   2026-07-13, técnica de referencia descrita por el cliente): el video
   empieza chico, centrado y semitransparente; conforme se baja crece
   (scale) y se aclara (opacity) hasta ocupar el ancho completo, y
   arranca solo al hacerse visible (autoplay muted). SOLO el video —
   el cliente pidió explícitamente quitar cualquier otra imagen o
   miniatura de esta sección (2026-07-13). Hoy solo creative la tiene. */
const FEATURE_VIDEOS = {
  creative: {
    src: '/assets/video/svc-creative-feature.mp4',
    poster: '/assets/video/svc-creative-feature-poster.jpg',
  },
};
const featureVideo = FEATURE_VIDEOS[edge.id] ?? null;
---
<Base
  title={`${edge.service} — Final Edge`}
  description={edge.summary}
>
  {videoHero ? (
    <section class="svc-vhero" style={`--pc:${phase.color}; --plate:url('${videoHero.plate}'); --logo-f:${videoHero.f}`}>
      <video
        class="svc-vhero-video"
        data-svc-hero-video
        src={videoHero.src}
        poster={videoHero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <img
        class="svc-vhero-logo"
        src={videoHero.logo}
        alt={`${edge.id} [AI]`}
        width={videoHero.w}
        height={videoHero.h}
      />
    </section>
  ) : (
  <section class="svc-hero" style={`--pc:${phase.color}`}>
    <div class="svc-grid">
      <div class="svc-wheel">
        <EngineWheel compact />
      </div>
      <div>
        <p class="svc-crumb reveal">
          <a href={phase.slug}>FASE {phase.num} · {phase.label}</a>
        </p>
        <h1 class="svc-title reveal">
          <LockupMark word={edge.id} tag="[AI]" color={phase.color} variant="big" transition:name={`edge-${edge.id}`} />
        </h1>
        <p class="svc-service reveal">{edge.service}</p>
        <p class="svc-hook reveal">{edge.hook}</p>
        <p class="lead reveal">{edge.summary}</p>
        <div class="svc-actions reveal">
          <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        </div>
      </div>
    </div>
  </section>
  )}

  {featureVideo && (
    <section class="svc-feature" data-svc-feature style={`--pc:${phase.color}`}>
      <div class="svc-feature-sticky">
        <p class="svc-feature-label" aria-hidden="true">Conoce lo que podemos hacer:</p>
        <video
          class="svc-feature-video"
          data-svc-feature-video
          src={featureVideo.src}
          poster={featureVideo.poster}
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        ></video>
        <button
          class="svc-sound"
          data-svc-sound
          data-sound="off"
          type="button"
          aria-label="Activar o silenciar el sonido del video"
        >
          <svg class="svc-sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"></polygon><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
          <svg class="svc-sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"></polygon><line x1="15" y1="9" x2="21" y2="15"></line><line x1="21" y1="9" x2="15" y2="15"></line></svg>
        </button>
      </div>
    </section>
  )}

  {edge.statement && (
    <section class="section svc-statement-sec" style={`--pc:${phase.color}`}>
      <p class="svc-statement reveal">{edge.statement}</p>
      <div class="svc-actions reveal">
        {sibling && <a class="btn" href={sibling.slug}>Explorar {sibling.service}</a>}
        <a class="btn btn--ghost" href="/#engine">Explora el final edge [ENGINE]</a>
      </div>
    </section>
  )}

  <section class="section" style={`--pc:${phase.color}`}>
    <div class="hairline-grid grid-3 reveal">
      {edge.stats.map(([num, txt]) => (
        <div>
          <p class="svc-stat-num" style={`color:${phase.color}`}>{num}</p>
          <p class="svc-stat-txt">{txt}</p>
        </div>
      ))}
    </div>
    <blockquote class="svc-quote reveal">«{edge.quote}»</blockquote>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>¿para qué sirve?</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.uses.map(([t, d], i) => (
        <div>
          <p class="svc-use-num prompt">{String(i + 1).padStart(2, '0')}</p>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>entregables reales</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.proof.map(([t, d]) => (
        <div>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
    <p class="svc-closing reveal">{edge.closing}</p>
    <div class="svc-actions reveal" style="margin-top:40px">
      <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
      <a class="btn btn--ghost" href={phase.slug}>Volver a {phase.name}</a>
    </div>
  </section>
</Base>

<style>
  /* hero de video (muestra del rediseño, hoy solo creative): pantalla
     completa bajo el nav, video sangrado a los bordes, logo horneado
     centrado. La plancha negra exacta va como background del MISMO
     <img> estirado a 100% 100% — misma caja y malla de píxeles que el
     logo, alineación exacta por construcción (ver el patrón original
     en .hero-logo de index.astro). */
  .svc-vhero {
    position: relative;
    min-height: calc(100vh - 92px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .svc-vhero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-vhero-logo {
    position: relative;
    /* base común min(560px, 70vw) multiplicada por el factor de
       igualación visual de cada logo (--logo-f, ver VIDEO_HEROES): el
       factor va FUERA del min() a propósito — así en pantallas chicas
       los 6 se encogen por el mismo múltiplo y siguen viéndose del
       mismo tamaño entre sí, en vez de que el min() recorte antes a
       los factores grandes.
       × 0.41 = reducción del 59% pedida explícitamente 2026-07-13
       ("reduzcas todos los logos de los heros de los servicios en un
       59%") — multiplica a los 6 por igual, así la igualación visual
       recién calibrada se conserva intacta. */
    width: calc(var(--logo-f, 1) * min(560px, 70vw) * 0.41);
    height: auto;
    background: var(--plate) center / 100% 100% no-repeat;
  }

  /* Animación disparada por scroll (técnica de referencia del cliente):
     la sección mide 260vh — el visor (sticky) se queda clavado bajo el
     nav mientras el usuario "recorre" esos 260vh, y ese progreso de
     scroll ES la línea de tiempo (mapeo posicional directo, sin easing
     — mismo principio que initCosmosScroll en el home): el video pasa
     de scale .35 / opacity .35 a 1 / 1, y las miniaturas del fondo se
     desvanecen y abren paso. El script solo escribe transform/opacity
     (nunca layout) vía requestAnimationFrame. */
  /* Arranque tipo "pestaña" (diagrama del cliente 2026-07-14): la
     sección sube sobre el hero con margen negativo, de modo que al
     cargar la página se vean DENTRO del hero la leyenda "Conoce lo que
     podemos hacer:" y el borde superior del video chico — una pestaña
     que invita a bajar. Por eso el visor dejó de centrar el video:
     leyenda y video van anclados arriba (columna), y el video crece
     hacia abajo desde su borde superior (transform-origin: top). */
  /* -14vh (antes -26vh): la pestaña se redujo 60% a pedido (2026-07-14)
     — en el hero solo asoma la leyenda y un rectángulo del borde
     superior del video. */
  .svc-feature { height: 260vh; position: relative; z-index: 2; margin-top: -14vh; }
  .svc-feature-sticky {
    position: sticky;
    top: 92px;
    height: calc(100vh - 92px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 18px;
    gap: 14px;
    overflow: hidden;
  }
  /* misma voz que "Conoce más:" en los hubs (Geist Mono 600 —
     tipografía aprobada del brand book), en blanco sobre el hero */
  .svc-feature-label {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 18.2px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent);
    white-space: nowrap;
  }
  .svc-feature-video {
    display: block;
    width: min(1180px, 94vw);
    /* proporción declarada del clip (16:9): sin ella, el <video> mide
       150px de alto hasta que llega la metadata y al llegar SALTA a su
       alto real — ese brinco de layout desplazaba el scroll (anchoring)
       y descuadraba el progreso de la animación a media lectura. */
    aspect-ratio: 16 / 9;
    transform: scale(0.35);
    transform-origin: top center;
    /* .55 de arranque (antes .35) + marco en el color de la fase: el
       rectángulo que asoma en el hero se lee claramente con el color
       de marca aun con el clip pausado/oscuro (pedido 2026-07-14).
       El grosor arranca en 5.72px porque el transform lo multiplica
       por 0.35 → 2px VISUALES; el script lo recalcula con la escala
       para que el marco se vea siempre de 2px nítidos. */
    opacity: 0.55;
    border: 5.72px solid var(--pc, var(--accent));
    will-change: transform, opacity;
  }
  /* botón de sonido del video (pedido 2026-07-13): mudo por política de
     navegador hasta que el video se agranda (ahí se INTENTA activar el
     audio — ver initSvcFeature) o hasta el click del usuario. Anclado a
     la esquina del visor sticky, no al video (que escala con transform):
     nunca se mueve ni cambia de tamaño con la animación. Sin sombras
     (R3.2): chip con hairline como el resto de la UI. */
  .svc-sound {
    position: absolute;
    /* esquina IZQUIERDA: la derecha la ocupa el chip fijo del asistente
       (verificado con hit-test: tapaba el botón y se robaba el click). */
    left: 28px;
    bottom: 28px;
    z-index: 2;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    border: 1px solid var(--hairline);
    cursor: pointer;
    transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
  }
  .svc-sound:hover { background: var(--fg); color: var(--bg); }
  .svc-sound svg { width: 22px; height: 22px; }
  .svc-sound[data-sound='on'] .svc-sound-off { display: none; }
  .svc-sound[data-sound='off'] .svc-sound-on { display: none; }

  /* con movimiento reducido no hay animación de scroll: el video se
     muestra completo y nítido de entrada. */
  @media (prefers-reduced-motion: reduce) {
    .svc-feature { height: auto; margin-top: 0; }
    .svc-feature-sticky { position: static; height: auto; padding: 96px 24px; }
    .svc-feature-video { transform: none; opacity: 1; }
  }

  /* statement del servicio (copy del cliente 2026-07-14): mismo tamaño
     y trazo que el texto del hero del home, sin negrita — el mismo
     tratamiento aprobado para los statements de las fases. Sin sombra:
     aquí el fondo es plano, no el efecto (R3.2). */
  .svc-statement {
    font-size: clamp(17px, 2.3vw, 32px);
    font-weight: 400;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: color-mix(in srgb, var(--fg) 90%, transparent);
    max-width: 60ch;
  }
  .svc-statement-sec .svc-actions { margin-top: 36px; }

  .svc-hero { padding: 150px 72px 88px; }  .svc-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .svc-crumb a { font-size: 14px; letter-spacing: .24em; color: var(--pc); }
  .svc-crumb a:hover { color: var(--fg); }
  .svc-title { margin-top: 20px; width: min(560px, 100%); }
  .svc-service { margin-top: 18px; font-size: var(--text-subtitle); color: var(--fg); font-weight: 500; }
  .svc-hook { margin: 12px 0 16px; font-size: var(--text-manifesto); letter-spacing: -.025em; color: var(--fg-2); }
  .svc-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  .svc-stat-num { font-size: clamp(30px, 3.4vw, 46px); font-weight: 600; letter-spacing: -.04em; }
  .svc-stat-txt { margin-top: 10px; font-size: 14px; color: var(--fg-muted); }
  .svc-quote {
    margin-top: 56px;
    border-left: 2px solid var(--pc, var(--accent));
    padding-left: 28px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .svc-use-num { font-size: 14px; letter-spacing: .2em; }
  .svc-use-title { margin-top: 10px; color: var(--fg); font-weight: 500; font-size: var(--text-body); }
  .svc-use-desc { margin-top: 8px; color: var(--fg-muted); font-size: 14px; }
  .svc-closing { margin-top: 48px; font-size: var(--text-subtitle); color: var(--fg-2); max-width: 62ch; }
  @media (max-width: 980px) {
    .svc-hero { padding: 120px 24px 64px; }
    .svc-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 40px; }
  }
</style>

<script>
  /* Arranque del video del hero de servicio — MISMO patrón blindado que
     el video del hero del home (index.astro), duplicado a propósito: el
     del home está verificado con reproducción real y congelado; una
     abstracción compartida ahora arriesgaría regresarlo. Capas:
     reconstrucción del elemento en cada regreso SPA, reintentos con
     vigilancia, load() de rescate y arranque por gesto (Safari). */
  document.addEventListener('astro:after-swap', () => {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    const n = v.cloneNode(false) as HTMLVideoElement;
    n.muted = true;
    n.defaultMuted = true;
    v.replaceWith(n);
    n.play().catch(() => {});
  });

  let svcWatch = 0;
  function playSvcHeroVideo() {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    const kick = () => { if (v.isConnected && v.paused) { v.muted = true; v.play().catch(() => {}); } };
    kick();
    v.addEventListener('loadeddata', kick, { once: true });
    clearInterval(svcWatch);
    const t0 = Date.now();
    let reloaded = false;
    svcWatch = setInterval(() => {
      if (!v.isConnected || v.currentTime > 0.2 || Date.now() - t0 > 10000) { clearInterval(svcWatch); return; }
      if (!reloaded && Date.now() - t0 > 3000 && v.currentTime === 0) {
        reloaded = true;
        v.addEventListener('canplay', kick, { once: true });
        try { v.load(); } catch {}
        return;
      }
      kick();
    }, 500);
    const gesture = () => { kick(); };
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, gesture, { once: true, passive: true });
    }
  }
  playSvcHeroVideo();
  document.addEventListener('astro:page-load', playSvcHeroVideo);

  /* Animación de la sección de video ligada al scroll (ver el CSS de
     .svc-feature): p = progreso 0→1 del recorrido de la sección; el
     scroll ES la línea de tiempo (sin easing, mapeo directo — R3.4 no
     aplica a mapeos posicionales, mismo criterio que initCosmosScroll).
     El autoplay lo gobierna un IntersectionObserver: play() al entrar
     al viewport (muted, permitido sin gesto), pause() al salir — nunca
     espera un click. Bajo prefers-reduced-motion el CSS ya dejó todo
     fijo y aquí solo se gestiona el play/pause. */
  function initSvcFeature() {
    const sec = document.querySelector('[data-svc-feature]') as HTMLElement | null;
    if (!sec) return;
    /* guardia de inicialización ÚNICA por sección: astro:page-load
       dispara también en la carga inicial del documento, así que sin
       esto TODO se registraba dos veces — y dos manejadores de click en
       el botón de sonido son dos toggles que se anulan entre sí (el
       botón "no apagaba"). La marca vive en el DOM de la sección: una
       navegación nueva trae DOM nuevo y se re-inicializa limpio. */
    if (sec.dataset.featureInit === '1') return;
    sec.dataset.featureInit = '1';
    const vid = sec.querySelector('[data-svc-feature-video]') as HTMLVideoElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ARRANQUE AL 90% (pedido 2026-07-14): el clip NO corre hasta que la
       pantalla está al 90% de su expansión (p ≥ 0.90). Bajo movimiento
       reducido no hay animación de crecimiento, así que ahí el criterio
       vuelve a ser solo la visibilidad. Los enganches (kick/pause) se
       conectan más abajo, cuando ya existen. */
    let featReady = reduced;
    let onFeatReady = () => {};
    let onFeatNotReady = () => {};

    if (!reduced) {
      let ticking = false;
      const update = () => {
        ticking = false;
        if (!sec.isConnected) return;
        const vh = innerHeight || 800;
        const r = sec.getBoundingClientRect();
        const total = Math.max(1, r.height - vh);
        const p = Math.min(1, Math.max(0, -r.top / total));
        const s = 0.35 + p * 0.65;
        vid.style.transform = `scale(${s.toFixed(4)})`;
        vid.style.opacity = (0.55 + p * 0.45).toFixed(4);
        /* marco de grosor visual constante (2px) pese a la escala */
        vid.style.borderWidth = `${(2 / s).toFixed(2)}px`;
        const ready = p >= 0.90;
        if (ready !== featReady) {
          featReady = ready;
          (ready ? onFeatReady : onFeatNotReady)();
        }
      };
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }

    /* SONIDO (pedido 2026-07-13): el video arranca mudo (es lo único que
       el navegador permite sin gesto), y al AGRANDARSE (p ≥ 0.92, una
       sola vez) se INTENTA encender el audio. Chrome/Safari pueden
       bloquear audio sin gesto: si al desmutear el navegador pausa el
       clip, se revierte a mudo y sigue corriendo — el botón queda listo
       para encenderlo con un click (eso sí es un gesto y siempre se
       permite). El icono refleja SIEMPRE el estado real (play/pause/
       volumechange), nunca una suposición. */
    const btn = sec.querySelector('[data-svc-sound]') as HTMLElement | null;
    let soundWanted = false;
    const syncIcon = () => { if (btn) btn.dataset.sound = !vid.muted && !vid.paused ? 'on' : 'off'; };
    for (const ev of ['play', 'pause', 'volumechange']) vid.addEventListener(ev, syncIcon);

    const tryUnmute = () => {
      soundWanted = true;
      vid.muted = false;
      if (vid.paused) vid.play().catch(() => {});
      setTimeout(() => {
        if (vid.paused || vid.muted) {
          soundWanted = false;
          vid.muted = true;
          vid.play().catch(() => {});
        }
        syncIcon();
      }, 150);
    };

    btn?.addEventListener('click', () => {
      if (vid.muted) {
        soundWanted = true;
        vid.muted = false;
        if (vid.paused) vid.play().catch(() => {});
      } else {
        soundWanted = false;
        vid.muted = true;
      }
      syncIcon();
    });

    /* mismo criterio blindado que los heroes: al hacerse visible no se
       confía en UN solo play() — se insiste (intento inmediato +
       loadeddata + reintentos) hasta que el clip de verdad corre,
       respetando el estado de sonido elegido. */
    /* featVisible: los reintentos de kick se ENCOLAN con setTimeout al
       entrar a vista — sin este candado, los que quedaban pendientes al
       salir disparaban DESPUÉS del pause() y revivían el video fuera de
       pantalla (medido: sección a −1412px del viewport y el clip
       corriendo). Cada intento re-verifica la visibilidad al momento de
       ejecutarse, no al momento de encolarse. */
    let featVisible = false;
    const kick = () => {
      if (!featVisible || !featReady || !vid.isConnected || !vid.paused) return;
      vid.muted = !soundWanted;
      vid.play().then(syncIcon).catch(() => {
        if (soundWanted) { soundWanted = false; vid.muted = true; vid.play().catch(() => {}); }
        syncIcon();
      });
    };
    /* SIEMPRE la última entrada del lote (mismo bug corregido en la
       rueda 2026-07-13): con scroll rápido, "entró a vista" y "salió de
       vista" llegan agrupadas en un solo callback — leer la primera
       dejaba el video corriendo fuera de pantalla y atascado al volver. */
    const io = new IntersectionObserver((entries) => {
      const en = entries[entries.length - 1];
      featVisible = en.isIntersecting;
      if (en.isIntersecting) {
        kick();
        vid.addEventListener('loadeddata', kick, { once: true });
        setTimeout(kick, 400);
        setTimeout(kick, 1500);
      } else vid.pause();
    }, { threshold: 0.15 });
    io.observe(vid);

    /* VIGILANTE PERSISTENTE (2026-07-13, reporte "el video de creative
       no corre de nuevo"): el hero tiene vigilancia continua + rescate +
       gesto y el cliente lo confirmó funcionando; esta sección solo
       tenía 3 reintentos en 1.5s al entrar a vista — si CUALQUIER
       condición del navegador real lo dejaba pausado después de eso
       (Chrome pausa al desmutear sin gesto y puede hacerlo DESPUÉS de
       nuestra verificación de 150ms; iOS en ahorro de energía rechaza
       el primer play; un atasco de buffer en un clip de 32MB), quedaba
       congelado para siempre. Mientras la sección esté a la vista y el
       clip pausado, se insiste cada 700ms; kick() re-verifica
       featVisible en cada tick, así que el pause() deliberado de salida
       nunca se pelea con esto. */
    let stuckSince = 0;
    const watch = setInterval(() => {
      if (!sec.isConnected) { clearInterval(watch); return; }
      if (!featVisible || !featReady || !vid.paused) { stuckSince = 0; return; }
      kick();
      const now = Date.now();
      if (!stuckSince) stuckSince = now;
      /* rescate (mismo que el hero): visible, pausado y sin UN cuadro
         decodificado tras 3s → recarga del elemento y reintento */
      if (now - stuckSince > 3000 && vid.currentTime === 0 && vid.readyState < 2) {
        stuckSince = now;
        vid.addEventListener('canplay', kick, { once: true });
        try { vid.load(); } catch {}
      }
    }, 700);

    /* arranque por gesto (Safari/iOS bloquean todo autoplay en ahorro
       de energía): el primer toque/click/tecla del usuario es una
       activación real y siempre autoriza el play — igual que el hero. */
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, () => { if (featVisible && vid.paused) kick(); }, { once: true, passive: true });
    }

    /* conexión del umbral del 90%: al cruzarlo hacia arriba se arranca
       (kick, con todos sus candados); al regresar por debajo se pausa —
       el clip solo corre con la pantalla expandida. */
    onFeatReady = () => kick();
    onFeatNotReady = () => vid.pause();

    /* enganche del intento automático al crecimiento: se dispara UNA vez
       al cruzar p ≥ 0.92 (el video ya está prácticamente a ancho
       completo — "al agrandarse debe comenzar con sonido"). */
    if (!reduced) {
      let autoTried = false;
      addEventListener('scroll', () => {
        if (autoTried || !sec.isConnected) return;
        const vh = innerHeight || 800;
        const r = sec.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)));
        if (p >= 0.92) { autoTried = true; tryUnmute(); }
      }, { passive: true });
    }
  }
  initSvcFeature();
  document.addEventListener('astro:page-load', initSvcFeature);
</script>
