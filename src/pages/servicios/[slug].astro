  .tech-stage-num { color: var(--pc, var(--accent)); font-weight: 700; font-size: 14px; letter-spacing: .08em; }
  .tech-stage-title { color: var(--fg); font-weight: 600; font-size: clamp(15px, 1.4vw, 18px); letter-spacing: .02em; }
  .tech-stage-cta {
