    transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .tech-menu-item:hover,
  .tech-menu-item.is-active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  /* tarjetas de videos de la técnica elegida (columna derecha) */
  .tech-videos { margin-top: 0; }
  .tech-videos[hidden] { display: none; }
  /* pantalla dominante: el video elegido proyectado a todo el ancho de
     la columna, como la rueda domina su columna en el home */
  .tech-stage {
    position: relative;
    display: block;
    /* la pantalla CEDE tamaño para que la tira de miniaturas SIEMPRE
       quepa debajo dentro del visor (reporte 2026-07-17 "se corta"):
       ancho tope = el que produce una altura de visor menos nav (92px)
       menos la reserva de la tira (~250px) a 16:9 */
    width: min(100%, calc((100vh - 342px) * 16 / 9));
    aspect-ratio: 16 / 9;
    background: var(--void-deep);
    border: 1px solid var(--hairline);
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    font: inherit;
  }
  .tech-stage-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* video vertical: entero (contain) sobre fondo void, sin recorte brutal */
  .tech-stage.is-vertical .tech-stage-video { object-fit: contain; }
  .tech-stage-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 30px 22px 16px;
