---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../../data/engine.js';

export function getStaticPaths() {
  return EDGES.map((e) => ({
    params: { slug: e.slug.split('/').filter(Boolean).pop() },
    props: { edge: e },
  }));
}
const { edge } = Astro.props;
const phase = phaseOfEdge(edge);
/* el otro servicio de la misma fase — botón "Explorar …" bajo el
   statement (pedido 2026-07-14) */
const sibling = EDGES.find((e) => e.phase === edge.phase && e.id !== edge.id);
/* Muestra del rediseño del landing de servicios (pedido 2026-07-13),
   empezando por el hero: video de fondo + el lockup horneado centrado
   encima, con su plancha negra exacta debajo (mismo patrón que el logo
   del hero del home: la plancha se genera del propio mapa de alfa del
   PNG — cuerpo sólido de los glifos en negro, halo y anti-alias sin
   tocar — y va como background del MISMO <img>, así la alineación es
   exacta por construcción). Un servicio entra al mapa cuando el cliente
   entrega su video (w/h = tamaño real de su PNG horneado); los que aún
   no lo tienen conservan el hero anterior. */
/* f = factor de ancho que iguala el TAMAÑO VISUAL de los 6 logos
   (reporte 2026-07-13: "logos de diferentes tamaños"): a ancho fijo,
   "flow" (4 letras) renderiza glifos enormes e "intelligence" (12)
   diminutos, porque cada PNG trae su propia escala interna. El factor
   se calculó midiendo la altura en píxeles del glifo ">_" de cada PNG
   (mismo elemento de marca en los 6, proporcional a la escala del
   lockup: strategy 228px, intelligence 226, readiness 236, flow 322,
   systems 234, creative 259) y despejando el ancho que deja esa altura
   RENDERIZADA idéntica a la de creative (la muestra aprobada) a 560px:
   f = (259 × Wᵢ) / (1284 × promptHᵢ). */
const VIDEO_HEROES = {
  creative: { w: 1284, h: 465, f: 1 },
  intelligence: { w: 1302, h: 482, f: 1.1621 },
  readiness: { w: 1323, h: 449, f: 1.1308 },
  systems: { w: 1182, h: 438, f: 1.0189 },
  flow: { w: 1279, h: 634, f: 0.8012 },
  strategy: { w: 1416, h: 566, f: 1.2528 },
};
const videoHero = VIDEO_HEROES[edge.id]
  ? {
      ...VIDEO_HEROES[edge.id],
      src: `/assets/video/svc-${edge.id}-hero.mp4`,
      poster: `/assets/video/svc-${edge.id}-hero-poster.jpg`,
      logo: `/assets/logos/logo-${edge.id}.png`,
      plate: `/assets/logos/logo-${edge.id}-plate.png`,
    }
  : null;
/* Sección de video con animación disparada por scroll (pedido
   2026-07-13, técnica de referencia descrita por el cliente): el video
   empieza chico, centrado y semitransparente; conforme se baja crece
   (scale) y se aclara (opacity) hasta ocupar el ancho completo, y
   arranca solo al hacerse visible (autoplay muted). SOLO el video —
   el cliente pidió explícitamente quitar cualquier otra imagen o
   miniatura de esta sección (2026-07-13). Hoy solo creative la tiene. */
const FEATURE_VIDEOS = {
  creative: {
    /* nombre VERSIONADO (fix definitivo 2026-07-17): el archivo se cachea
       1 semana por vercel.json; con el mismo nombre, el navegador seguía
       sirviendo la versión vieja (1440p) aunque se subiera una nueva — por
       eso el reel "se arreglaba y se volvía a trabar". Un nombre nuevo
       invalida TODAS las capas de caché. Si se sustituye el video, subir
       el número de versión. */
    src: '/assets/video/svc-creative-feature-v2.mp4',
    poster: '/assets/video/svc-creative-feature-poster.jpg',
  },
};
const featureVideo = FEATURE_VIDEOS[edge.id] ?? null;
/* Galería de técnicas (2026-07-17): los 13 videos del cliente asignados a
   las 6 técnicas (asignación editorial propia — el cliente corrige lo que
   no cuadre). El primer video de cada técnica da el frame de su tarjeta. */
/* APAGADO hasta subir los encodes web de los 13 videos a
   /assets/work/v/ (quedaron a medias al pausar el trabajo 2026-07-17):
   con true, el click en una técnica despliega sus tarjetas de video y
   cada tarjeta abre la pantalla con el reproductor nativo. */
const WORK_VIDEOS_READY = false;
/* Las 5 fases del proceso de video (banda al dar click en "Video",
   2026-07-17). Copy editorial propia — el cliente ajusta lo que quiera. */
const PHASES_5 = [
  { title: 'Brief', desc: 'Objetivo, audiencia y mensaje. Todo empieza con una conversación corta.' },
  { title: 'Concepto', desc: 'Guion, estilo visual y storyboard aprobados antes de producir un solo frame.' },
  { title: 'Producción', desc: 'Escenas, personajes y mundos generados con IA bajo dirección humana.' },
  { title: 'Postproducción', desc: 'Edición, color, música y sonido con acabado de estudio.' },
  { title: 'Final cut', desc: 'Master listo para publicar en días, no en meses.' },
];
const TECHS = featureVideo
  ? [
      { key: 'documental', label: 'Documental', word: 'Documental', videos: [
        { title: 'Bacalar', slug: 'bacalar' },
        { title: 'Cardumen en Bacalar', slug: 'cardumen-en-bacalar' },
      ] },
      { key: 'personaje', label: 'Personaje', word: 'Personaje', videos: [
        { title: 'Santa de vacaciones', slug: 'santa-de-vacaciones' },
        { title: 'Me enamoré en Acolman', slug: 'me-enamore-en-acolman' },
      ] },
      { key: 'animacion', label: 'Animación', word: 'Animación', videos: [
        { title: 'León de fuego', slug: 'leon-de-fuego' },
      ] },
      { key: 'publicidad', label: 'Publicidad', word: 'Publicidad', videos: [
        { title: 'Felicidades México', slug: 'sw-felicidades-mexico' },
        { title: 'El riesgo es no intentarlo', slug: 'sw-el-riesgo' },
        { title: 'Experiencia futbolera', slug: 'sw-experiencia-futbolera' },
        { title: 'Nos renovamos por ti', slug: 'sw-nos-renovamos' },
        { title: 'Sports World Mix', slug: 'sports-world-mix' },
        { title: 'Navidad en Vlu', slug: 'navidad-en-vlu' },
      ] },
      { key: 'control-movimiento', label: 'Control de movimiento', word: 'Control de movimiento', videos: [
        { title: 'Explosión en Hong Kong', slug: 'explosion-en-hong-kong' },
      ] },
      { key: 'comida', label: 'Comida', word: 'Comida', videos: [
        { title: 'Buffet', slug: 'buffet' },
      ] },
    ]
  : [];
---
<Base
  title={`${edge.service} — Final Edge`}
  description={edge.summary}
>
  {videoHero ? (
    <section class="svc-vhero" style={`--pc:${phase.color}; --plate:url('${videoHero.plate}'); --logo-f:${videoHero.f}`}>
      <video
        class="svc-vhero-video"
        data-svc-hero-video
        src={videoHero.src}
        poster={videoHero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <img
        class="svc-vhero-logo"
        src={videoHero.logo}
        alt={`${edge.id} [AI]`}
        width={videoHero.w}
        height={videoHero.h}
      />
      {edge.statement && (
        <div class="svc-vhero-copy reveal">
          <p class="svc-statement">{edge.statement}</p>
          <!-- CTA bajo el statement: en creative "Conoce lo que podemos
               hacer" abre DIRECTO el reel (expandido); en el resto
               "Conoce más" baja a la siguiente lámina (pedido
               2026-07-16). Flecha hacia abajo. -->
          <button class="svc-more" type="button" data-svc-more>
            {featureVideo ? 'Conoce lo que podemos hacer' : 'Conoce más'}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
          </button>
        </div>
      )}
      <!-- Flechas de navegación (pedido 2026-07-15, sustituyen a los dos
           botones): IZQUIERDA regresa a la fase; DERECHA lleva al otro
           servicio de la fase. Escritorio y móvil por igual. -->
      {edge.statement && (
        <div class="svc-vhero-actions reveal">
          <a class="svc-arrow" href={phase.slug} aria-label={`Regresar a ${phase.name}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
          </a>
          {sibling && (
            <a class="svc-arrow" href={sibling.slug} aria-label={`Siguiente servicio: ${sibling.service}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </a>
          )}
        </div>
      )}
    </section>
  ) : (
  <section class="svc-hero" style={`--pc:${phase.color}`}>
    <div class="svc-grid">
      <div class="svc-wheel">
        <EngineWheel compact />
      </div>
      <div>
        <p class="svc-crumb reveal">
          <a href={phase.slug}>FASE {phase.num} · {phase.label}</a>
        </p>
        <h1 class="svc-title reveal">
          <LockupMark word={edge.id} tag="[AI]" color={phase.color} variant="big" transition:name={`edge-${edge.id}`} />
        </h1>
        <p class="svc-service reveal">{edge.service}</p>
        <p class="svc-hook reveal">{edge.hook}</p>
        <p class="lead reveal">{edge.summary}</p>
        <div class="svc-actions reveal">
          <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        </div>
      </div>
    </div>
  </section>
  )}

  {featureVideo && (
    <!-- REEL REHECHO DE CERO (2026-07-17, pedido explícito): reproductor
         NATIVO del navegador — controls estándar con play, línea de tiempo
         y volumen. Cero JS de reproducción propio. Póster negro sólido:
         no se ve ningún frame del video hasta dar play. -->
    <section class="svc-feature" data-svc-feature data-state="idle" data-reel="ready" style={`--pc:${phase.color}`}>
      <div class="svc-feature-stage">
        <p class="svc-feature-label" aria-hidden="true">Conoce lo que podemos hacer:</p>
        <div class="svc-feature-frame" data-svc-frame>
          <video
            class="svc-feature-video"
            data-svc-feature-video
            src={featureVideo.src}
            poster="/assets/video/reel-poster-black.jpg"
            controls
            loop
            playsinline
            preload="metadata"
          ></video>
          <!-- PLAY grande (pedido 2026-07-16, restaurado sobre el player
               nativo): entra deslizándose desde fuera por la izquierda;
               click = play con sonido; desaparece al reproducir y vuelve
               al salir del visor (video reiniciado a 0). -->
          <button class="svc-feature-play" data-svc-bigplay type="button" aria-label="Reproducir el video">Play</button>
        </div>
        <!-- CTA bajo la pantalla (pedido 2026-07-16): baja a la lámina de
             manifiesto donde las palabras se iluminan al hacer scroll. -->
        <button class="svc-feature-cta" data-svc-next type="button">
          Conoce nuestro trabajo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
        </button>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Lámina de manifiesto (pedido 2026-07-16): al hacer scroll down las
         palabras se iluminan una a una en el color de la fase, con el aire
         de los landings de fase. -->
    <section class="reel-manifesto" data-reel-manifesto style={`--pc:${phase.color}`}>
      <div class="reel-manifesto-stage">
        <!-- mismo fondo que el landing de la fase (pedido 2026-07-16): el
             efecto Blue Edge sobre la base oscura del tono de fase. -->
        <canvas class="reel-manifesto-bg" data-blue-edge aria-hidden="true"></canvas>
        <p class="reel-manifesto-text">
          {'Probablemente la mejor productora impulsada por IA de América Latina'.split(' ').map((w) => (
            <span class="reel-word">{w}</span>
          ))}
        </p>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Galería de trabajo (pedido 2026-07-16): 3 tarjetas — Video,
         Imágenes, Música — en fila (layout de referencia del cliente). -->
    <section class="section reel-gallery" style={`--pc:${phase.color}`}>
      <header class="section-head reveal">
        <p class="eyebrow"><span class="prompt">&gt;_</span>nuestro trabajo</p>
        <hr />
      </header>
      <div class="reel-gallery-grid reveal">
        {/* Video: botón que despliega abajo los 3 títulos (pedido 2026-07-17) */}
        <button class="reel-card" type="button" data-video-toggle aria-expanded="false" aria-controls="video-detail">
          <span class="reel-card-media"><img src="/assets/gallery/gal-video.jpg" alt="Video" width="800" height="450" loading="lazy" /></span>
          <span class="reel-card-body">
            <span class="reel-card-title"><span class="prompt">&gt;_</span>Video</span>
            <span class="reel-card-desc">Reels, comerciales y contenido en movimiento.</span>
          </span>
        </button>
        {[
          { label: 'Imágenes', img: '/assets/gallery/gal-imagenes.jpg', desc: 'Fotografía y arte visual generado a medida.' },
          { label: 'Música', img: '/assets/gallery/gal-musica.jpg', desc: 'Bandas sonoras y audio original.' },
        ].map((c) => (
          <a class="reel-card" href="/#valoracion" aria-label={c.label}>
            <span class="reel-card-media"><img src={c.img} alt={c.label} width="800" height="450" loading="lazy" /></span>
            <span class="reel-card-body">
              <span class="reel-card-title"><span class="prompt">&gt;_</span>{c.label}</span>
              <span class="reel-card-desc">{c.desc}</span>
            </span>
          </a>
        ))}
      </div>
      {/* Al dar click en la tarjeta de Video (rediseño 2026-07-17, con
         banda de referencia del cliente): banda en el color del servicio
         con las 5 fases — solo el título; hover/click enciende la tarjeta
         y muestra la explicación — y abajo las técnicas como tarjetas
         premium con frames reales de los videos. */}
      <div class="reel-video-detail" id="video-detail" data-video-detail hidden>
        <div class="phase-band">
          <canvas class="phase-band-bg" data-blue-edge aria-hidden="true"></canvas>
          <div class="phase-band-inner">
            <p class="phase-band-title"><span class="prompt">&gt;_</span>Del concepto al final cut en días</p>
            <div class="phase-grid">
              {PHASES_5.map((f) => (
                <button class="phase-card" type="button" data-phase-card>
                  <span class="phase-card-title">{f.title}</span>
                  <span class="phase-card-desc">{f.desc}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* técnicas: tarjetas premium con frame real; hover cambia la
           palabra de la frase; click desplegará sus videos */}
        <div class="tech-gallery is-open" id="tech-gallery" data-tech-gallery>
          <p class="tech-phrase">Inteligencia artificial<br /><span class="tech-word" data-tech-word>Documental</span> real</p>
          <div class="tech-grid">
            {TECHS.map((t, i) => (
              <button class={`tech-thumb${i === 0 ? ' is-active' : ''}`} type="button" data-tech-word-set={t.word} data-tech-key={t.key}>
                <span class="tech-thumb-media"><img src={`/assets/gallery/tech2/${t.key}.jpg`} alt={t.label} width="600" height="800" loading="lazy" /></span>
                <span class="tech-thumb-label">{t.label}</span>
              </button>
            ))}
          </div>
          {/* tarjetas de videos por técnica (se muestran al hacer click) */}
          {WORK_VIDEOS_READY && (
            <div class="tech-videos" data-tech-videos hidden>
              {TECHS.map((t) => (
                <div class="tech-videos-group" data-tech-group={t.key} hidden>
                  {t.videos.map((v) => (
                    <button class="work-card" type="button" data-video-src={`/assets/work/v/${v.slug}.mp4`} data-video-title={v.title}>
                      <span class="work-card-media"><img src={`/assets/work/thumbs/${v.slug}.jpg`} alt={v.title} width="640" height="360" loading="lazy" /></span>
                      <span class="work-card-title">{v.title}</span>
                    </button>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Pantalla de reproducción (2026-07-17): overlay con el reproductor
         NATIVO (play, línea de tiempo, volumen, pantalla completa). -->
    <div class="work-player" data-work-player hidden>
      <button class="work-player-close" data-work-close type="button" aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" style="width:20px;height:20px"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg></button>
      <p class="work-player-title" data-work-title></p>
      <video class="work-player-video" data-work-video controls playsinline preload="metadata"></video>
    </div>
  )}

  <section class="section" style={`--pc:${phase.color}`}>
    <div class="hairline-grid grid-3 reveal">
      {edge.stats.map(([num, txt]) => (
        <div>
          <p class="svc-stat-num" style={`color:${phase.color}`}>{num}</p>
          <p class="svc-stat-txt">{txt}</p>
        </div>
      ))}
    </div>
    <blockquote class="svc-quote reveal">«{edge.quote}»</blockquote>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>¿para qué sirve?</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.uses.map(([t, d], i) => (
        <div>
          <p class="svc-use-num prompt">{String(i + 1).padStart(2, '0')}</p>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <header class="section-head reveal">
      <p class="eyebrow"><span class="prompt">&gt;_</span>entregables reales</p>
      <hr />
    </header>
    <div class="hairline-grid grid-2 reveal">
      {edge.proof.map(([t, d]) => (
        <div>
          <p class="svc-use-title">{t}</p>
          <p class="svc-use-desc">{d}</p>
        </div>
      ))}
    </div>
    <p class="svc-closing reveal">{edge.closing}</p>
    <div class="svc-actions reveal" style="margin-top:40px">
      <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
      <a class="btn btn--ghost" href={phase.slug}>Volver a {phase.name}</a>
    </div>
  </section>
</Base>

<style>
  /* hero de video (muestra del rediseño, hoy solo creative): pantalla
     completa bajo el nav, video sangrado a los bordes, logo horneado
     centrado. La plancha negra exacta va como background del MISMO
     <img> estirado a 100% 100% — misma caja y malla de píxeles que el
     logo, alineación exacta por construcción (ver el patrón original
     en .hero-logo de index.astro). */
  .svc-vhero {
    position: relative;
    min-height: calc(100vh - 92px);
    display: flex;
    /* columna: logo arriba, statement + botones debajo (mock 2026-07-14) */
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    overflow: hidden;
  }
  .svc-vhero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-vhero-logo {
    position: relative;
    /* base común min(560px, 70vw) multiplicada por el factor de
       igualación visual de cada logo (--logo-f, ver VIDEO_HEROES): el
       factor va FUERA del min() a propósito — así en pantallas chicas
       los 6 se encogen por el mismo múltiplo y siguen viéndose del
       mismo tamaño entre sí, en vez de que el min() recorte antes a
       los factores grandes.
       × 0.41 = reducción del 59% pedida explícitamente 2026-07-13
       ("reduzcas todos los logos de los heros de los servicios en un
       59%") — multiplica a los 6 por igual, así la igualación visual
       recién calibrada se conserva intacta. */
    width: calc(var(--logo-f, 1) * min(560px, 70vw) * 0.41);
    height: auto;
    background: var(--plate) center / 100% 100% no-repeat;
  }

  /* Animación disparada por scroll (técnica de referencia del cliente):
     la sección mide 260vh — el visor (sticky) se queda clavado bajo el
     nav mientras el usuario "recorre" esos 260vh, y ese progreso de
     scroll ES la línea de tiempo (mapeo posicional directo, sin easing
     — mismo principio que initCosmosScroll en el home): el video pasa
     de scale .35 / opacity .35 a 1 / 1, y las miniaturas del fondo se
     desvanecen y abren paso. El script solo escribe transform/opacity
     (nunca layout) vía requestAnimationFrame. */
  /* Arranque tipo "pestaña" (diagrama del cliente 2026-07-14): la
     sección sube sobre el hero con margen negativo, de modo que al
     cargar la página se vean DENTRO del hero la leyenda "Conoce lo que
     podemos hacer:" y el borde superior del video chico — una pestaña
     que invita a bajar. Por eso el visor dejó de centrar el video:
     leyenda y video van anclados arriba (columna), y el video crece
     hacia abajo desde su borde superior (transform-origin: top). */
  /* -14vh (antes -26vh): la pestaña se redujo 60% a pedido (2026-07-14)
     — en el hero solo asoma la leyenda y un rectángulo del borde
     superior del video. */
  /* Sección de video con SCROLL-LOCK por gestos (rediseño 2026-07-15):
     un flick hacia abajo expande el video al 100% y TRABA el scroll;
     otro flick lo destraba y pausa; click alterna play/pausa. El stage
     se fija (sticky) durante un rango de scroll (la sección mide 160vh)
     para que el gesto de expansión siempre tenga dónde engancharse. */
  /* sin peek en el hero (2026-07-16): el reel se alcanza con el botón
     "Conoce lo que podemos hacer" (o bajando) — así las flechas del
     hero quedan en la misma posición que en los otros servicios. */
  .svc-feature { height: 160vh; position: relative; z-index: 2; margin-top: 0; }
  .svc-feature-stage {
    position: sticky;
    top: 92px;
    height: calc(100vh - 92px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    overflow: hidden;
  }
  /* misma voz que "Conoce más:" en los hubs (Geist Mono 600 —
     tipografía aprobada del brand book), en blanco sobre el hero.
     Desaparece cuando el video se expande. */
  .svc-feature-label {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 18.2px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent);
    white-space: nowrap;
    transition: opacity var(--t-ui) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-label { opacity: 0; }
  /* CTA bajo la pantalla: baja al manifiesto. Aparece al expandir. */
  .svc-feature-cta {
    margin: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--fg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-ui) var(--ease), color var(--t-hover) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-cta { opacity: 1; pointer-events: auto; }
  .svc-feature-cta:hover { color: var(--pc, var(--accent)); }
  .svc-feature-cta svg { width: 20px; height: 20px; animation: svc-bob 1.8s var(--ease) infinite; }
  @keyframes svc-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  /* el frame contiene el video + los controles y es lo que escala */
  .svc-feature-frame {
    position: relative;
    display: block;
    /* 16:9 SIEMPRE: el ancho también se limita por la altura disponible,
       para que el marco no quede más ancho que el video nativo */
    width: min(1180px, 84vw, calc((100vh - 250px) * 16 / 9));
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 250px);
    transform: scale(0.92);
    transform-origin: center;
    opacity: 0.5;
    overflow: hidden;
    /* marco 3D minimalista premium (rediseño 2026-07-16): un bisel oscuro
       maquinado (padding con degradado iluminado desde arriba-izq), una
       línea de fase finísima al borde interior de la "pantalla", y una
       sombra de elevación en dos capas para que flote. Excepción de
       sombra autorizada por pedido explícito. */
    padding: 12px;
    background:
      linear-gradient(152deg,
        color-mix(in srgb, var(--fg) 13%, var(--void-deep)) 0%,
        var(--void-deep) 44%,
        var(--void-deep) 100%);
    border: 1px solid color-mix(in srgb, var(--fg) 9%, transparent);
    box-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (marco 3D pedido) */
      inset 0 1px 0 color-mix(in srgb, #FFFFFF 14%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--void-deep) 60%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--void-deep) 55%, transparent),
      0 2px 4px color-mix(in srgb, var(--void-deep) 50%, transparent),
      0 42px 90px -28px color-mix(in srgb, var(--void-deep) 78%, transparent);
    transition: transform var(--t-enter) var(--ease), opacity var(--t-enter) var(--ease);
    will-change: transform, opacity;
  }
  .svc-feature[data-state='expanded'] .svc-feature-frame {
    transform: scale(1);
    opacity: 1;
  }
  /* la "pantalla" (video): hairline de fase al borde interior del bisel */
  .svc-feature-video {
    box-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (borde interior de pantalla) */
      inset 0 0 0 1px color-mix(in srgb, var(--pc, var(--accent)) 45%, transparent),
      0 0 0 1px color-mix(in srgb, var(--void-deep) 70%, transparent);
  }
  /* PLAY grande a la izquierda (pedido 2026-07-16, restaurado): empieza
     FUERA del marco (recortado por overflow:hidden) y entra deslizándose,
     visible, hasta quedar dentro al expandir; se va al reproducir. Va
     arriba del centro para no tapar la barra nativa de controles. */
  .svc-feature-play {
    position: absolute;
    top: 44%;
    left: 8%;
    transform: translate(-190%, -50%);   /* fuera del marco, por la izquierda */
    z-index: 4;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(56px, 9vw, 136px);
    font-weight: 600;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (legibilidad sobre video) */ 0 2px 22px color-mix(in srgb, var(--void-deep) 78%, transparent);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    /* opacity casi instantánea: se vuelve visible mientras aún está fuera
       (recortada) para que se PERCIBA entrar deslizándose, no aparecer. */
    transition: transform var(--t-enter) var(--ease), opacity 120ms var(--ease);
  }
  .svc-feature[data-state='expanded'][data-reel='ready'] .svc-feature-play {
    transform: translate(0, -50%);       /* dentro del marco */
    opacity: 1;
    pointer-events: auto;
  }
  .svc-feature-play:hover { color: var(--pc, var(--accent)); }
  /* --- Lámina de manifiesto: las palabras se encienden en el color de la
     fase al hacer scroll (pedido 2026-07-16), con el aire de los landings
     de fase (fondo oscuro + halo de fase). --- */
  .reel-manifesto { position: relative; height: 250vh; z-index: 2; }
  .reel-manifesto-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6vw;
    overflow: hidden;
    /* MISMA base que el landing de la fase: tono de fase mezclado a negro
       (fallback void). El canvas Blue Edge pinta encima. */
    background: var(--void-deep);
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
  }
  /* efecto Blue Edge al fondo (igual que .hub-static del landing de fase) */
  .reel-manifesto-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .reel-manifesto-text {
    position: relative;
    z-index: 1;
    margin: 0 auto 0 0;              /* bloque a la izquierda */
    max-width: 22ch;
    text-align: left;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(30px, 5.2vw, 72px);
    line-height: 1.18;
    letter-spacing: -0.4px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;     /* palabras alineadas a la izquierda */
    gap: 0.1em 0.34em;
  }
  .reel-word {
    color: color-mix(in srgb, var(--fg) 13%, transparent);   /* apagada */
    transition: color 340ms var(--ease), text-shadow 340ms var(--ease);
  }
  .reel-word.lit {
    color: var(--pc, var(--accent));                          /* encendida */
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (palabras que se encienden) */
      0 0 28px color-mix(in srgb, var(--pc, var(--accent)) 55%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .reel-manifesto { height: auto; }
    .reel-manifesto-stage { position: static; height: auto; padding: 96px 6vw; }
    .reel-word { color: var(--fg); }
  }
  /* --- Galería de trabajo: 3 tarjetas en fila (Video/Imágenes/Música) --- */
  .reel-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .reel-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    background: var(--panel);
    color: var(--fg);
    text-decoration: none;
    /* normaliza el <button> para que se vea igual que los <a> */
    text-align: left;
    font: inherit;
    padding: 0;
    width: 100%;
    cursor: pointer;
    appearance: none;
    transition: border-color var(--t-hover) var(--ease), transform var(--t-hover) var(--ease);
  }
  .reel-card:hover { border-color: var(--pc, var(--accent)); transform: translateY(-4px); }
  .reel-card[aria-expanded='true'] { border-color: var(--pc, var(--accent)); }
  .reel-card-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--hairline); }
  .reel-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-enter) var(--ease); }
  .reel-card:hover .reel-card-media img { transform: scale(1.04); }
  .reel-card-body { padding: 18px 20px 22px; display: flex; flex-direction: column; gap: 7px; }
  .reel-card-title { font-family: 'Geist Mono', ui-monospace, monospace; font-weight: 600; font-size: 18px; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
  .reel-card-desc { font-size: 14px; color: var(--fg-muted); line-height: 1.42; }
  @media (max-width: 860px) {
    .reel-gallery-grid { grid-template-columns: 1fr; gap: 18px; }
  }
  /* 3 títulos que se despliegan al dar click en la tarjeta de Video */
  .reel-video-detail {
    margin-top: 30px;
    padding-top: 30px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .reel-video-detail[hidden] { display: none; }
  .reel-detail-title {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(22px, 3.4vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.3px;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 14px;
    /* entrada escalonada al abrir */
    opacity: 0;
    transform: translateY(10px);
  }
  .reel-detail-title svg { width: clamp(22px, 2.6vw, 30px); height: clamp(22px, 2.6vw, 30px); color: var(--pc, var(--accent)); flex: none; }
  /* --- BANDA de las 5 fases (referencia "La Presión" del home, en el
     color del servicio): base oscura del tono de fase + efecto Blue Edge
     pintando encima, retícula de tarjetas con hairlines. --- */
  .phase-band {
    position: relative;
    overflow: hidden;
    background: var(--void-deep);
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
  }
  .phase-band-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .phase-band-inner {
    position: relative;
    z-index: 1;
    padding: 56px 48px 60px;
  }
  .phase-band-title {
    margin: 0 0 40px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 28px);
    letter-spacing: 0.6px;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .phase-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
  }
  .phase-card {
    min-height: 240px;
    padding: 26px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    background: none;
    border: none;
    border-left: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition: background var(--t-ui) var(--ease), color var(--t-ui) var(--ease);
  }
  .phase-card:first-child { border-left: none; }
  .phase-card-title {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(15px, 1.35vw, 20px);
    letter-spacing: 0.3px;
    white-space: nowrap;
  }
  .phase-card-desc {
    font-size: 14px;
    line-height: 1.5;
    max-width: 26ch;
    min-height: 90px;               /* misma reserva en las 5: títulos alineados */
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--t-ui) var(--ease), transform var(--t-ui) var(--ease);
  }
  /* encendida (hover o click): se llena del color de la fase y aparece
     la explicación; el texto pasa a oscuro para contraste */
  .phase-card:hover,
  .phase-card.is-open {
    background: var(--pc, var(--accent));
    color: var(--void-deep);
  }
  .phase-card:hover .phase-card-desc,
  .phase-card.is-open .phase-card-desc { opacity: 1; transform: none; }
  /* galería de técnicas: frase central que cambia + miniaturas */
  .tech-gallery {
    margin-top: 44px;
  }
  .tech-gallery[hidden] { display: none; }
  .tech-gallery.is-open {
    opacity: 1;
    transform: none;
    transition: opacity var(--t-ui) var(--ease), transform var(--t-ui) var(--ease);
  }
  .tech-phrase {
    margin: 0 0 34px;
    text-align: center;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(28px, 5vw, 62px);
    line-height: 1.08;
    letter-spacing: -0.4px;
    color: var(--fg);
  }
  .tech-word { color: var(--pc, var(--accent)); transition: color var(--t-hover) var(--ease); }
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }
  .tech-thumb {
    position: relative;
    display: block;
    background: none;
    border: 1px solid var(--hairline);
    padding: 0;
    cursor: pointer;
    color: var(--fg);
    font: inherit;
    overflow: hidden;
    transition: border-color var(--t-hover) var(--ease), transform var(--t-hover) var(--ease);
  }
  .tech-thumb:hover,
  .tech-thumb.is-active { border-color: var(--pc, var(--accent)); transform: translateY(-4px); }
  .tech-thumb-media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .tech-thumb-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.35) brightness(0.8);
    transition: filter var(--t-ui) var(--ease), transform var(--t-enter) var(--ease);
  }
  .tech-thumb:hover .tech-thumb-media img,
  .tech-thumb.is-active .tech-thumb-media img { filter: none; transform: scale(1.06); }
  /* degradado inferior para que el nombre viva DENTRO de la imagen */
  .tech-thumb::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--void-deep) 88%, transparent) 100%);
    pointer-events: none;
  }
  .tech-thumb-label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 11px;
    z-index: 2;
    text-align: left;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  /* tarjetas de videos de la técnica elegida */
  .tech-videos { margin-top: 34px; }
  .tech-videos[hidden] { display: none; }
  .tech-videos-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .tech-videos-group[hidden] { display: none; }
  .work-card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--hairline);
    padding: 0;
    cursor: pointer;
    color: var(--fg);
    font: inherit;
    text-align: left;
    transition: border-color var(--t-hover) var(--ease), transform var(--t-hover) var(--ease);
  }
  .work-card:hover { border-color: var(--pc, var(--accent)); transform: translateY(-4px); }
  .work-card-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--hairline); }
  .work-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-enter) var(--ease); }
  .work-card:hover .work-card-media img { transform: scale(1.05); }
  .work-card-title {
    padding: 12px 14px 14px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.4px;
  }
  /* pantalla de reproducción: overlay oscuro con el player nativo */
  .work-player {
    position: fixed;
    inset: 0;
    z-index: 220;
    background: color-mix(in srgb, var(--void-deep) 96%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 4vh 4vw;
  }
  .work-player[hidden] { display: none; }
  .work-player-video {
    width: min(1400px, 92vw);
    max-height: 80vh;
    background: var(--void-deep);
    border: 1px solid var(--hairline);
  }
  .work-player-title {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 1.4px;
    color: var(--fg);
  }
  .work-player-close {
    position: absolute;
    top: 22px;
    right: 26px;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--hairline);
    color: var(--fg);
    font-size: 19px;
    cursor: pointer;
    transition: border-color var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
  }
  .work-player-close:hover { border-color: var(--pc, var(--accent)); color: var(--pc, var(--accent)); }
  @media (max-width: 860px) {
    .tech-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tech-videos-group { grid-template-columns: 1fr; }
    /* banda de fases apilada en móvil */
    .phase-band-inner { padding: 36px 20px 40px; }
    .phase-grid { grid-template-columns: 1fr; }
    .phase-card { border-left: none; border-top: 1px solid color-mix(in srgb, var(--fg) 22%, transparent); min-height: 0; padding: 22px 18px; }
    .phase-card:first-child { border-top: none; }
    .phase-card-desc { display: none; }
    .phase-card.is-open .phase-card-desc { display: block; }
  }
  .reel-video-detail.is-open .reel-detail-title {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--t-ui) var(--ease), transform var(--t-ui) var(--ease);
  }
  .reel-video-detail.is-open .reel-detail-title:nth-child(2) { transition-delay: 90ms; }
  .reel-video-detail.is-open .reel-detail-title:nth-child(3) { transition-delay: 180ms; }
  @media (prefers-reduced-motion: reduce) {
    .reel-detail-title { opacity: 1; transform: none; }
  }
  .svc-feature-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* con movimiento reducido no hay scroll-lock: el video se muestra
     completo y los controles siempre visibles. */
  @media (prefers-reduced-motion: reduce) {
    .svc-feature { height: auto; margin-top: 0; }
    .svc-feature-stage { position: static; height: auto; padding: 96px 24px; }
    .svc-feature-frame { transform: none; opacity: 1; }
    .svc-feature-play { display: none; }
    .svc-feature-label { display: none; }
  }

  /* statement del servicio (copy del cliente 2026-07-14) DENTRO del
     hero, abajo del logo (pedido 2026-07-14 con mock): mismo font que
     los statements de las fases (la referencia .engine-h2 del home:
     clamp(14px, 1.3vw, 16px), peso 400, espaciado normal, interlineado
     1.12), en blanco y con sombra oscura debajo del texto para
     garantizar la legibilidad sobre el video — pedido explícito. */
  .svc-vhero-copy {
    position: relative;
    max-width: 62ch;
    padding: 0 24px;
  }
  .svc-statement {
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.12;
    /* centrado (pedido explícito 2026-07-14) */
    text-align: center;
    color: color-mix(in srgb, var(--fg) 92%, transparent);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 70%, transparent),
                 0 3px 14px color-mix(in srgb, var(--void-deep) 55%, transparent);
  }
  /* botones del hero de servicio (pedido 2026-07-14): uno al lado del
     otro, cerca del borde inferior de la lámina, con fondo SÓLIDO del
     color de la fase y tinta oscura encima. En creative suben por
     encima de la pestaña del video que asoma en el hero (-14vh). */
  .svc-vhero-actions {
    position: absolute;
    /* 14px (antes 30): "mucho menos prominentes y más cerca al borde
       inferior del slide" — pedido 2026-07-15 */
    bottom: 14px;
    /* centrado sin transform: .reveal anima transform y lo pisaría */
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    width: max-content;
    max-width: calc(100vw - 48px);
  }
  .svc-vhero-actions--tabbed { bottom: calc(14vh + 8px); }
  /* Flechas de navegación (pedido 2026-07-15, sustituyen a los dos
     botones): chip cuadrado con el hex exacto de la fase, trazo oscuro,
     hover invertido a blanco — mismo lenguaje que las flechas de los
     hubs. Área táctil de 52px. */
  .svc-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--pc, var(--accent));
    border: 1px solid var(--pc, var(--accent));
    color: var(--void-deep);
    transition: background var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .svc-arrow svg { width: 24px; height: 24px; }
  .svc-arrow:hover,
  .svc-arrow:active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--void-deep);
  }
  /* "Conoce más" + flecha hacia abajo, centrado bajo el statement
     (pedido 2026-07-15): misma voz tipográfica del texto, con la sombra
     ya exceptuada para leerse sobre el video. */
  .svc-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 26px auto 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 600;
    letter-spacing: normal;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 70%, transparent);
    transition: color var(--t-hover) var(--ease);
  }
  .svc-more svg { width: 22px; height: 22px; }
  .svc-more:hover { color: var(--pc, var(--accent)); }

  .svc-hero { padding: 150px 72px 88px; }
  .svc-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .svc-crumb a { font-size: 14px; letter-spacing: .24em; color: var(--pc); }
  .svc-crumb a:hover { color: var(--fg); }
  .svc-title { margin-top: 20px; width: min(560px, 100%); }
  .svc-service { margin-top: 18px; font-size: var(--text-subtitle); color: var(--fg); font-weight: 500; }
  .svc-hook { margin: 12px 0 16px; font-size: var(--text-manifesto); letter-spacing: -.025em; color: var(--fg-2); }
  .svc-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  .svc-stat-num { font-size: clamp(30px, 3.4vw, 46px); font-weight: 600; letter-spacing: -.04em; }
  .svc-stat-txt { margin-top: 10px; font-size: 14px; color: var(--fg-muted); }
  .svc-quote {
    margin-top: 56px;
    border-left: 2px solid var(--pc, var(--accent));
    padding-left: 28px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .svc-use-num { font-size: 14px; letter-spacing: .2em; }
  .svc-use-title { margin-top: 10px; color: var(--fg); font-weight: 500; font-size: var(--text-body); }
  .svc-use-desc { margin-top: 8px; color: var(--fg-muted); font-size: 14px; }
  .svc-closing { margin-top: 48px; font-size: var(--text-subtitle); color: var(--fg-2); max-width: 62ch; }
  @media (max-width: 980px) {
    .svc-hero { padding: 120px 24px 64px; }
    .svc-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 40px; }
    /* MÓVIL (auditoría 2026-07-14): los botones anclados al fondo se
       encimaban con el statement centrado (creative, medido en captura
       390×844) y el segundo se recortaba bajo el chip del asistente.
       En pantallas angostas vuelven al flujo, apilados y centrados
       bajo el texto. */
    .svc-vhero { padding: 32px 20px 84px; gap: 24px; }
    /* las flechas son un par compacto de 52px: se quedan ancladas al
       borde inferior también en móvil (el padding de 84px del hero les
       reserva la franja bajo el contenido centrado). */
    .svc-feature-frame { padding: 8px; }
    .svc-feature-play { font-size: clamp(40px, 13vw, 72px); left: 7%; }
  }
</style>

<script>
  /* Fondo Blue Edge del manifiesto (mismo del landing de fase). Se importa
     DENTRO de este script único (no como <script> aparte): Astro deduplica
     los <script> idénticos entre páginas y lo dejaba fuera del bundle de
     servicios — por eso el efecto no cargaba aquí. */
  import '../../scripts/blue-edge-bg.js';
  /* Arranque del video del hero de servicio — MISMO patrón blindado que
     el video del hero del home (index.astro), duplicado a propósito: el
     del home está verificado con reproducción real y congelado; una
     abstracción compartida ahora arriesgaría regresarlo. Capas:
     reconstrucción del elemento en cada regreso SPA, reintentos con
     vigilancia, load() de rescate y arranque por gesto (Safari). */
  /* Conecta el blob precargado (window.__videoWarm, ver Base.astro) al
     <video> del hero: cero red al llegar — MEDIDO que el <video> jamás
     reutiliza la caché HTTP del prefetch (fix 2026-07-15, "los videos
     tardan mucho en comenzar de nuevo"). Solo si el clip aún no corre:
     si el blob resuelve tarde y el clip ya avanza por red, no se
     reinicia. */
  function applyWarmSrc(v: HTMLVideoElement) {
    const src = v.getAttribute('src');
    const warm = (window as any).__videoWarm;
    const p = warm && src ? warm[src] : null;
    if (!p) return;
    Promise.resolve(p).then((url) => {
      if (url && v.isConnected && !v.dataset.warmed && v.currentTime < 0.3) {
        v.dataset.warmed = '1';
        v.src = url;
        v.muted = true;
        v.play().catch(() => {});
      }
    }).catch(() => {});
  }

  document.addEventListener('astro:after-swap', () => {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (v) {
      const n = v.cloneNode(false) as HTMLVideoElement;
      n.muted = true;
      n.defaultMuted = true;
      v.replaceWith(n);
      applyWarmSrc(n);
      n.play().catch(() => {});
    }
  });

  let svcWatch = 0;
  function playSvcHeroVideo() {
    const v = document.querySelector('[data-svc-hero-video]') as HTMLVideoElement | null;
    if (!v) return;
    applyWarmSrc(v);
    const kick = () => { if (v.isConnected && v.paused) { v.muted = true; v.play().catch(() => {}); } };
    kick();
    v.addEventListener('loadeddata', kick, { once: true });
    clearInterval(svcWatch);
    const t0 = Date.now();
    let reloaded = false;
    svcWatch = setInterval(() => {
      if (!v.isConnected || v.currentTime > 0.2 || Date.now() - t0 > 10000) { clearInterval(svcWatch); return; }
      if (!reloaded && Date.now() - t0 > 3000 && v.currentTime === 0) {
        reloaded = true;
        v.addEventListener('canplay', kick, { once: true });
        try { v.load(); } catch {}
        return;
      }
      kick();
    }, 500);
    const gesture = () => { kick(); };
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      addEventListener(ev, gesture, { once: true, passive: true });
    }
  }
  playSvcHeroVideo();
  document.addEventListener('astro:page-load', playSvcHeroVideo);

  /* "Conoce más" del hero (pedido 2026-07-15): baja a la SIGUIENTE
     lámina de la página del servicio — la sección que sigue al hero
     (en creative es la sección del video; en el resto, estadísticas).
     scrollIntoView nativo, sin easing propio (R3.4 no aplica a scroll
     del navegador). */
  function initSvcMore() {
    const btn = document.querySelector('[data-svc-more]') as HTMLElement | null;
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      /* si hay sección de reel, ir DIRECTO a la pantalla del video ya
         agrandada (con el PLAY grande listo) — la expone initSvcFeature
         como _openReel (pedido 2026-07-16). Si no, bajar a la siguiente
         lámina como antes. */
      const feat = document.querySelector('[data-svc-feature]') as any;
      if (feat && typeof feat._openReel === 'function') { feat._openReel(); return; }
      const hero = document.querySelector('.svc-vhero');
      const next = hero?.nextElementSibling;
      next?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
  initSvcMore();
  document.addEventListener('astro:page-load', initSvcMore);

  /* Sección de reel — REHECHA DE CERO (2026-07-17, pedido explícito):
     el video usa los controles NATIVOS del navegador (play, línea de
     tiempo, volumen). Aquí solo queda lo visual y defensivo:
     1) el <video> se recrea con createElement en cada llegada — los
        <video> del HTML servido, al entrar por el swap SPA del
        ClientRouter, no arrancan su carga (readyState 0, póster fijo);
     2) escala del marco al fijarse la lámina (data-state);
     3) pausa al salir del visor;
     4) si el elemento reporta un error real, muestra su código en una
        esquina para diagnóstico en el navegador del usuario. */
  function initSvcFeature() {
    const sec = document.querySelector('[data-svc-feature]') as HTMLElement | null;
    if (!sec) return;
    if (sec.dataset.featureInit === '1') return;
    sec.dataset.featureInit = '1';
    const frame = sec.querySelector('[data-svc-frame]') as HTMLElement | null;

    /* cloneNode (no createElement): el clon conserva TODOS los atributos,
       incluido el data-astro-cid del scope de estilos — con createElement
       el video quedaba SIN estilos (tamaño natural, desbordado). El clon
       nuevo en el documento vivo + load() re-arranca la carga que el swap
       SPA deja muerta. */
    const seed = sec.querySelector('[data-svc-feature-video]') as HTMLVideoElement;
    const vid = seed.cloneNode(false) as HTMLVideoElement;
    seed.replaceWith(vid);
    try { vid.load(); } catch (_) {}

    /* diagnóstico SOLO ante un error real del elemento */
    vid.addEventListener('error', () => {
      if (!frame) return;
      const d = document.createElement('div');
      d.style.cssText = 'position:absolute;left:14px;top:14px;z-index:5;font-family:ui-monospace,monospace;font-size:14px;color:#A0A0A8;background:rgba(8,8,10,0.8);padding:4px 8px;pointer-events:none;';
      d.textContent = `video err:${vid.error ? vid.error.code : '?'}`;
      frame.appendChild(d);
    });

    /* PLAY grande (restaurado): click = play con sonido (gesto directo);
       si el navegador lo bloquea, cae a mudo. Desaparece al reproducir
       (data-reel=live) y vuelve al reiniciar. */
    const bigPlay = sec.querySelector('[data-svc-bigplay]') as HTMLElement | null;
    bigPlay?.addEventListener('click', () => {
      vid.play().catch(() => { vid.muted = true; vid.play().catch(() => {}); });
    });
    vid.addEventListener('play', () => { sec.dataset.reel = 'live'; });

    /* al salir del visor: pausa + reinicio a 0 y el PLAY reaparece */
    new IntersectionObserver((es) => {
      if (!es[es.length - 1].isIntersecting) {
        if (!vid.paused) vid.pause();
        try { vid.currentTime = 0; } catch (_) {}
        sec.dataset.reel = 'ready';
      }
    }, { threshold: 0.15 }).observe(vid);

    const vh = () => innerHeight || 800;

    /* escala del marco al fijarse la lámina + ocultar el chip del
       asistente mientras el reel llena el visor */
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      sec.dataset.state = 'expanded';
    } else {
      let inZone = false, raf = 0;
      const evalZone = () => {
        raf = 0;
        const r = sec.getBoundingClientRect();
        const c = r.top <= 96 && r.bottom >= vh() - 4;
        if (c === inZone) return;
        inZone = c;
        sec.dataset.state = c ? 'expanded' : 'idle';
        document.body.classList.toggle('reel-open', c);
      };
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(evalZone); };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      evalZone();
    }

    /* botón "Conoce lo que podemos hacer": llevar la lámina al visor */
    (sec as any)._openReel = () => {
      const absTop = sec.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: Math.round(absTop + vh() * 0.35), behavior: 'smooth' });
    };
  }
  initSvcFeature();
  document.addEventListener('astro:page-load', initSvcFeature);
  /* al navegar fuera (SPA), restaurar el chip del asistente */
  document.addEventListener('astro:before-swap', () => document.body.classList.remove('reel-open'));

  /* CTA "Conoce nuestro trabajo": baja a la lámina de manifiesto */
  function initSvcNext() {
    const btn = document.querySelector('[data-svc-next]') as HTMLElement | null;
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      document.querySelector('[data-reel-manifesto]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
  initSvcNext();
  document.addEventListener('astro:page-load', initSvcNext);

  /* Manifiesto: enciende las palabras una a una según el avance del scroll
     mientras la lámina está fijada (pedido 2026-07-16). */
  function initReelManifesto() {
    const sec = document.querySelector('[data-reel-manifesto]') as HTMLElement | null;
    if (!sec || sec.dataset.mfInit === '1') return;
    sec.dataset.mfInit = '1';
    const words = Array.from(sec.querySelectorAll('.reel-word')) as HTMLElement[];
    if (!words.length) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      words.forEach((w) => w.classList.add('lit'));
      return;
    }
    let raf = 0;
    const update = () => {
      raf = 0;
      const total = sec.offsetHeight - innerHeight;                 // recorrido con la lámina fijada
      const scrolled = Math.min(Math.max(-sec.getBoundingClientRect().top, 0), total);
      const p = total > 0 ? scrolled / total : 0;
      /* todas encendidas al 82% del recorrido: se ven completas antes de salir */
      const lit = Math.round(Math.min(p / 0.82, 1) * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
  initReelManifesto();
  document.addEventListener('astro:page-load', initReelManifesto);

  /* Tarjeta de Video: despliega/oculta los 3 títulos (pedido 2026-07-17) */
  function initVideoDetail() {
    const btn = document.querySelector('[data-video-toggle]') as HTMLElement | null;
    const panel = document.querySelector('[data-video-detail]') as HTMLElement | null;
    if (!btn || !panel || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      if (panel.hidden) {
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-open'));
        btn.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
      } else {
        panel.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        setTimeout(() => { if (!panel.classList.contains('is-open')) panel.hidden = true; }, 340);
      }
    });
  }
  initVideoDetail();
  document.addEventListener('astro:page-load', initVideoDetail);

  /* Galería de técnicas (pedido 2026-07-17): el título 1 la abre (hover o
     click); al pasar/hacer click en una miniatura, la palabra central
     cambia por el nombre de esa técnica. */
  function initTechGallery() {
    const gallery = document.querySelector('[data-tech-gallery]') as HTMLElement | null;
    const word = document.querySelector('[data-tech-word]') as HTMLElement | null;
    if (!gallery || gallery.dataset.techBound === '1') return;
    gallery.dataset.techBound = '1';
    /* tarjetas de las 5 fases: hover enciende; click fija/apaga (móvil) */
    const phaseCards = Array.from(document.querySelectorAll('[data-phase-card]')) as HTMLElement[];
    phaseCards.forEach((c) => {
      c.addEventListener('click', () => {
        const on = c.classList.contains('is-open');
        phaseCards.forEach((o) => o.classList.remove('is-open'));
        if (!on) c.classList.add('is-open');
      });
    });
    const thumbs = Array.from(gallery.querySelectorAll('[data-tech-word-set]')) as HTMLElement[];
    const videosWrap = gallery.querySelector('[data-tech-videos]') as HTMLElement | null;
    const groups = videosWrap ? (Array.from(videosWrap.querySelectorAll('[data-tech-group]')) as HTMLElement[]) : [];
    const pick = (el: HTMLElement) => {
      if (word) word.textContent = el.getAttribute('data-tech-word-set') || '';
      thumbs.forEach((t) => t.classList.toggle('is-active', t === el));
    };
    /* CLICK: además de la palabra, despliega las tarjetas de esa técnica */
    const openVideos = (el: HTMLElement) => {
      const key = el.getAttribute('data-tech-key');
      if (!videosWrap || !key) return;
      videosWrap.hidden = false;
      groups.forEach((g) => { g.hidden = g.getAttribute('data-tech-group') !== key; });
      requestAnimationFrame(() => videosWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    };
    thumbs.forEach((el) => {
      el.addEventListener('mouseenter', () => pick(el));
      el.addEventListener('click', () => { pick(el); openVideos(el); });
    });
  }
  initTechGallery();
  document.addEventListener('astro:page-load', initTechGallery);

  /* Pantalla de reproducción (2026-07-17): al hacer click en una tarjeta
     de video se abre el overlay con el reproductor NATIVO (línea de
     tiempo incluida). Cierra con el botón, click en el fondo o Escape. */
  let workPlayerBound = false;
  function initWorkPlayer() {
    if (workPlayerBound) return;
    workPlayerBound = true;
    const closePlayer = () => {
      const ov = document.querySelector('[data-work-player]') as HTMLElement | null;
      if (!ov || ov.hidden) return;
      const v = ov.querySelector('[data-work-video]') as HTMLVideoElement | null;
      if (v) { v.pause(); v.removeAttribute('src'); try { v.load(); } catch (_) {} }
      ov.hidden = true;
    };
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const card = t.closest('[data-video-src]');
      if (card) {
        const ov = document.querySelector('[data-work-player]') as HTMLElement | null;
        const v = ov?.querySelector('[data-work-video]') as HTMLVideoElement | null;
        const title = ov?.querySelector('[data-work-title]') as HTMLElement | null;
        if (!ov || !v) return;
        if (title) title.textContent = card.getAttribute('data-video-title') || '';
        v.src = card.getAttribute('data-video-src') || '';
        ov.hidden = false;
        v.play().catch(() => {});
        return;
      }
      if (t.closest('[data-work-close]')) { closePlayer(); return; }
      const ov = t.closest('[data-work-player]');
      if (ov && t === ov) closePlayer();   // click en el fondo oscuro
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePlayer(); });
    document.addEventListener('astro:before-swap', closePlayer);
  }
  initWorkPlayer();
</script>
