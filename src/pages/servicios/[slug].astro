  .tech-back:hover { color: var(--pc, var(--accent)); }
  .tech-back svg { width: 16px; height: 16px; }
  /* menú de técnicas: chips CALCADOS de .engine-menu-item del home,
     en COLUMNA vertical como en el slide de la rueda */
  .tech-menu {
    /* mismo respiro que .engine-menu del home (24px tras el hairline) */
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    /* recuadros TODOS del mismo tamaño (pedido): estiran al ancho de la
       columna en lugar de medir cada uno su texto */
    align-items: stretch;
    gap: 10px;
