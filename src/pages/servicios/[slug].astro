---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../../data/engine.js';

export function getStaticPaths() {
  return EDGES.map((e) => ({
    params: { slug: e.slug.split('/').filter(Boolean).pop() },
    props: { edge: e },
  }));
}
const { edge } = Astro.props;
const phase = phaseOfEdge(edge);
/* el otro servicio de la misma fase — botón "Explorar …" bajo el
   statement (pedido 2026-07-14) */
const sibling = EDGES.find((e) => e.phase === edge.phase && e.id !== edge.id);
/* Muestra del rediseño del landing de servicios (pedido 2026-07-13),
   empezando por el hero: video de fondo + el lockup horneado centrado
   encima, con su plancha negra exacta debajo (mismo patrón que el logo
   del hero del home: la plancha se genera del propio mapa de alfa del
   PNG — cuerpo sólido de los glifos en negro, halo y anti-alias sin
   tocar — y va como background del MISMO <img>, así la alineación es
   exacta por construcción). Un servicio entra al mapa cuando el cliente
   entrega su video (w/h = tamaño real de su PNG horneado); los que aún
   no lo tienen conservan el hero anterior. */
/* f = factor de ancho que iguala el TAMAÑO VISUAL de los 6 logos
   (reporte 2026-07-13: "logos de diferentes tamaños"): a ancho fijo,
   "flow" (4 letras) renderiza glifos enormes e "intelligence" (12)
   diminutos, porque cada PNG trae su propia escala interna. El factor
   se calculó midiendo la altura en píxeles del glifo ">_" de cada PNG
   (mismo elemento de marca en los 6, proporcional a la escala del
   lockup: strategy 228px, intelligence 226, readiness 236, flow 322,
   systems 234, creative 259) y despejando el ancho que deja esa altura
   RENDERIZADA idéntica a la de creative (la muestra aprobada) a 560px:
   f = (259 × Wᵢ) / (1284 × promptHᵢ). */
const VIDEO_HEROES = {
  creative: { w: 1284, h: 465, f: 1 },
  intelligence: { w: 1302, h: 482, f: 1.1621 },
  readiness: { w: 1323, h: 449, f: 1.1308 },
  systems: { w: 1182, h: 438, f: 1.0189 },
  flow: { w: 1279, h: 634, f: 0.8012 },
  strategy: { w: 1416, h: 566, f: 1.2528 },
};
const videoHero = VIDEO_HEROES[edge.id]
  ? {
      ...VIDEO_HEROES[edge.id],
      src: `/assets/video/svc-${edge.id}-hero.mp4`,
      poster: `/assets/video/svc-${edge.id}-hero-poster.jpg`,
      logo: `/assets/logos/logo-${edge.id}.png`,
      plate: `/assets/logos/logo-${edge.id}-plate.png`,
    }
  : null;
/* Sección de video con animación disparada por scroll (pedido
   2026-07-13, técnica de referencia descrita por el cliente): el video
   empieza chico, centrado y semitransparente; conforme se baja crece
   (scale) y se aclara (opacity) hasta ocupar el ancho completo, y
   arranca solo al hacerse visible (autoplay muted). SOLO el video —
   el cliente pidió explícitamente quitar cualquier otra imagen o
   miniatura de esta sección (2026-07-13). Hoy solo creative la tiene. */
const FEATURE_VIDEOS = {
  creative: {
    /* nombre VERSIONADO (fix definitivo 2026-07-17): el archivo se cachea
       1 semana por vercel.json; con el mismo nombre, el navegador seguía
       sirviendo la versión vieja (1440p) aunque se subiera una nueva — por
       eso el reel "se arreglaba y se volvía a trabar". Un nombre nuevo
       invalida TODAS las capas de caché. Si se sustituye el video, subir
       el número de versión. */
    src: '/assets/video/svc-creative-feature-v2.mp4',
    poster: '/assets/video/svc-creative-feature-poster.jpg',
  },
};
const featureVideo = FEATURE_VIDEOS[edge.id] ?? null;
/* Galería de técnicas (2026-07-17): los 13 videos del cliente asignados a
   las 6 técnicas (asignación editorial propia — el cliente corrige lo que
   no cuadre). El primer video de cada técnica da el frame de su tarjeta. */
/* APAGADO hasta subir los encodes web de los 13 videos a
   /assets/work/v/ (quedaron a medias al pausar el trabajo 2026-07-17):
   con true, el click en una técnica despliega sus tarjetas de video y
   cada tarjeta abre la pantalla con el reproductor nativo. */
const WORK_VIDEOS_READY = true;
/* Las fases del proceso de video (banda al dar click en "Video") —
   copy DICTADO por el cliente 2026-07-17, no se edita sin su visto. */
const PHASES_BAND = [
  { title: 'Estrategia de Comunicación', desc: 'Brief, análisis estratégico y concepto creativo.' },
  { title: 'Pre producción', desc: 'Storyboard, investigación de física y mecánica, y scene cards con rigor de producción tradicional.' },
  { title: 'Dirección creativa', desc: 'Expertos en producción con IA definen dirección de arte, secuencia de tomas, personajes y locaciones.' },
  { title: 'Producción con IA', desc: 'Lo que antes tomaba semanas ahora toma algunos días.' },
  { title: 'Post producción', desc: 'Edición de color, música, efectos de sonido e iluminación.' },
  { title: 'Final cut', desc: 'Formatos finales producidos de forma impecable.' },
];
const TECHS = featureVideo
  ? [
      { key: 'documental', label: 'Documental', word: 'Documental', videos: [
        { title: 'Bacalar', slug: 'bacalar' },
        { title: 'Cardumen en Bacalar', slug: 'cardumen-en-bacalar' },
      ] },
      { key: 'personaje', label: 'Personaje', word: 'Personaje', videos: [
        { title: 'Me enamoré en Acolman', slug: 'me-enamore-en-acolman' },
      ] },
      { key: 'animacion', label: 'Animación', word: 'Animación', videos: [
        { title: 'León de fuego', slug: 'leon-de-fuego' },
        { title: 'Felicidades México', slug: 'sw-felicidades-mexico' },
      ] },
      { key: 'publicidad', label: 'Publicidad', word: 'Publicidad', videos: [
        { title: 'El riesgo es no intentarlo', slug: 'sw-el-riesgo' },
        { title: 'Experiencia futbolera', slug: 'sw-experiencia-futbolera' },
        { title: 'Nos renovamos por ti', slug: 'sw-nos-renovamos' },
        { title: 'Sports World Mix', slug: 'sports-world-mix' },
      ] },
      { key: 'efectos-especiales', label: 'Efectos especiales', word: 'Efectos especiales', videos: [
        { title: 'Explosión en Hong Kong', slug: 'explosion-en-hong-kong' },
        { title: 'Santa de vacaciones', slug: 'santa-de-vacaciones' },
        { title: 'Navidad en Vlu', slug: 'navidad-en-vlu' },
      ] },
      { key: 'comida', label: 'Comida', word: 'Comida', videos: [
        { title: 'Buffet', slug: 'buffet' },
      ] },
    ]
  : [];
---
<Base
  title={`${edge.service} — Final Edge`}
  description={edge.summary}
>
  {videoHero ? (
    <section class="svc-vhero" style={`--pc:${phase.color}; --plate:url('${videoHero.plate}'); --logo-f:${videoHero.f}`}>
      <video
        class="svc-vhero-video"
        data-svc-hero-video
        src={videoHero.src}
        poster={videoHero.poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <img
        class="svc-vhero-logo"
        src={videoHero.logo}
        alt={`${edge.id} [AI]`}
        width={videoHero.w}
        height={videoHero.h}
      />
      {edge.statement && (
        <div class="svc-vhero-copy reveal">
          <p class="svc-statement">{edge.statement}</p>
          <!-- CTA bajo el statement: en creative "Conoce lo que podemos
               hacer" abre DIRECTO el reel (expandido); en el resto
               "Conoce más" baja a la siguiente lámina (pedido
               2026-07-16). Flecha hacia abajo. -->
          <button class="svc-more" type="button" data-svc-more>
            {featureVideo ? 'Conoce lo que podemos hacer' : 'Conoce más'}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
          </button>
        </div>
      )}
      <!-- Flechas de navegación (pedido 2026-07-15, sustituyen a los dos
           botones): IZQUIERDA regresa a la fase; DERECHA lleva al otro
           servicio de la fase. Escritorio y móvil por igual. -->
      {edge.statement && (
        <div class="svc-vhero-actions reveal">
          <a class="svc-arrow" href={phase.slug} aria-label={`Regresar a ${phase.name}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
          </a>
          {sibling && (
            <a class="svc-arrow" href={sibling.slug} aria-label={`Siguiente servicio: ${sibling.service}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </a>
          )}
        </div>
      )}
    </section>
  ) : (
  <section class="svc-hero" style={`--pc:${phase.color}`}>
    <div class="svc-grid">
      <div class="svc-wheel">
        <EngineWheel compact />
      </div>
      <div>
        <p class="svc-crumb reveal">
          <a href={phase.slug}>FASE {phase.num} · {phase.label}</a>
        </p>
        <h1 class="svc-title reveal">
          <LockupMark word={edge.id} tag="[AI]" color={phase.color} variant="big" transition:name={`edge-${edge.id}`} />
        </h1>
        <p class="svc-service reveal">{edge.service}</p>
        <p class="svc-hook reveal">{edge.hook}</p>
        <p class="lead reveal">{edge.summary}</p>
        <div class="svc-actions reveal">
          <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        </div>
      </div>
    </div>
  </section>
  )}

  {featureVideo && (
    <!-- REEL REHECHO DE CERO (2026-07-17, pedido explícito): reproductor
         NATIVO del navegador — controls estándar con play, línea de tiempo
         y volumen. Cero JS de reproducción propio. Póster negro sólido:
         no se ve ningún frame del video hasta dar play. -->
    <section class="svc-feature" data-svc-feature data-state="idle" data-reel="ready" style={`--pc:${phase.color}`}>
      <div class="svc-feature-stage">
        <p class="svc-feature-label" aria-hidden="true">Conoce lo que podemos hacer:</p>
        <div class="svc-feature-frame" data-svc-frame>
          <video
            class="svc-feature-video"
            data-svc-feature-video
            src={featureVideo.src}
            poster="/assets/video/reel-poster-black.jpg"
            controls
            loop
            playsinline
            preload="metadata"
          ></video>
          <!-- PLAY grande (pedido 2026-07-16, restaurado sobre el player
               nativo): entra deslizándose desde fuera por la izquierda;
               click = play con sonido; desaparece al reproducir y vuelve
               al salir del visor (video reiniciado a 0). -->
          <button class="svc-feature-play" data-svc-bigplay type="button" aria-label="Reproducir el video">Play</button>
        </div>
        <!-- CTA bajo la pantalla (pedido 2026-07-16): baja a la lámina de
             manifiesto donde las palabras se iluminan al hacer scroll. -->
        <button class="svc-feature-cta" data-svc-next type="button">
          Conoce nuestro trabajo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
        </button>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Lámina de manifiesto (pedido 2026-07-16): al hacer scroll down las
         palabras se iluminan una a una en el color de la fase, con el aire
         de los landings de fase. -->
    <section class="reel-manifesto" data-reel-manifesto style={`--pc:${phase.color}`}>
      <div class="reel-manifesto-stage">
        <!-- mismo fondo que el landing de la fase (pedido 2026-07-16): el
             efecto Blue Edge sobre la base oscura del tono de fase. -->
        <canvas class="reel-manifesto-bg" data-blue-edge aria-hidden="true"></canvas>
        <p class="reel-manifesto-text">
          {'Probablemente la mejor productora impulsada por IA de América Latina'.split(' ').map((w) => (
            <span class="reel-word">{w}</span>
          ))}
        </p>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Galería de trabajo (pedido 2026-07-16): 3 tarjetas — Video,
         Imágenes, Música — en fila (layout de referencia del cliente). -->
    <section class="section reel-gallery" style={`--pc:${phase.color}`}>
      <header class="section-head reveal">
        <p class="eyebrow"><span class="prompt">&gt;_</span>nuestro trabajo</p>
        <hr />
      </header>
      <div class="reel-gallery-grid reveal">
        {/* Tarjetas 9:16 (pedido 2026-07-17): imagen a sangre completa,
           SOLO el título dentro, >_ en el color del servicio. Video abre
           el detalle; las otras dos van a valoración. */}
        <button class="reel-card" type="button" data-video-toggle aria-expanded="false" aria-controls="video-detail">
          <span class="reel-card-media"><img src="/assets/gallery/gal-video-v.jpg" alt="Video" width="1080" height="1920" loading="lazy" /></span>
          <span class="reel-card-title"><span class="reel-card-prompt">&gt;_</span>Video</span>
        </button>
        {[
          { label: 'Imágenes', img: '/assets/gallery/gal-imagenes-v.jpg' },
          { label: 'Música', img: '/assets/gallery/gal-musica-v.jpg' },
        ].map((c) => (
          <a class="reel-card" href="/#valoracion" aria-label={c.label}>
            <span class="reel-card-media"><img src={c.img} alt={c.label} width="1080" height="1920" loading="lazy" /></span>
            <span class="reel-card-title"><span class="reel-card-prompt">&gt;_</span>{c.label}</span>
          </a>
        ))}
      </div>
      {/* Al dar click en la tarjeta de Video (rediseño 2026-07-17, con
         banda de referencia del cliente): banda en el color del servicio
         con las 5 fases — solo el título; hover/click enciende la tarjeta
         y muestra la explicación — y abajo las técnicas como tarjetas
         premium con frames reales de los videos. */}
      <div class="reel-video-detail" id="video-detail" data-video-detail hidden>
        {/* PANTALLA propia (pedido 2026-07-17): al abrir Video solo se ve
           la banda con las 5 tarjetas y el CTA de la galería — la galería
           queda fuera del visor hasta el scroll/click, y en UN movimiento
           la banda se esconde y la galería llena la pantalla. */}
        <div class="phase-screen" data-phase-screen>
        <div class="phase-band">
          <canvas class="phase-band-bg" data-blue-edge aria-hidden="true"></canvas>
          <div class="phase-band-inner">
            <p class="phase-band-title">
              <img class="phase-band-prompt-img" src="/assets/logos/symbol-prompt-silver.png" alt="" width="260" height="200" />
              del concepto a la producción final en días
            </p>
            <div class="phase-grid">
              {PHASES_BAND.map((f) => (
                <button class="phase-card" type="button" data-phase-card>
                  <span class="phase-card-title">{f.title}</span>
                  <span class="phase-card-desc">{f.desc}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* CTA bajo la banda (pedido 2026-07-17): click o UN scroll
           hacia abajo lleva a la pantalla completa de la galería */}
        <button class="phase-band-cta" type="button" data-gallery-cta>
          Visita nuestra galería
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></svg>
        </button>
        </div>

        {/* técnicas al estilo del menú de la rueda del home (pedido
           2026-07-17): título >_ + menú de chips; hover o click en una
           técnica muestra las tarjetas de sus videos */}
        <div class="tech-gallery" id="tech-gallery" data-tech-gallery>
          {/* mismo layout que el slide de la rueda del home: columna de
             texto con el menú VERTICAL a la izquierda, gráfico (las
             tarjetas de videos) a la derecha */}
          <div class="tech-col-text">
            {/* título CALCADO del slide de la rueda del home (pedido
               2026-07-17): misma anatomía que el lockup >_ final edge
               [ENGINE] — >_ 35px/700 en el color del servicio (fondo
               oscuro), texto 28px/600 alineado por línea base, hairline
               debajo como .section-head */}
            <header class="tech-head">
              <p class="tech-lockup">
                <span class="tech-title-prompt" aria-hidden="true">&gt;_</span>
                <span class="tech-lockup-text">dominamos todas las técnicas</span>
              </p>
              <hr />
            </header>
            <nav class="tech-menu" aria-label="Técnicas" data-tech-menu>
              {TECHS.map((t, i) => (
                <button class={`tech-menu-item${i === 0 ? ' is-active' : ''}`} type="button" data-tech-key={t.key}>{t.label}</button>
              ))}
            </nav>
            {/* regreso al menú de Video / Imágenes / Música (el scroll
               hacia arriba también regresa: nada se secuestra) */}
            <button class="tech-back" type="button" data-tech-back>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 19V5" /><path d="M6 11l6-6 6 6" /></svg>
              Nuestro trabajo
            </button>
          </div>
          {WORK_VIDEOS_READY && (
            <div class="tech-videos" data-tech-videos>
              {/* PANTALLA dominante (misma jerarquía que la rueda en el
                 slide del home): el video elegido se proyecta ENORME a
                 todo el ancho, reproduciéndose mudo en loop como preview
                 vivo por HLS. Click = se abre con sonido y controles
                 (mismo overlay). Debajo, la tira numerada con el resto
                 de los videos de la técnica: hover = pasa a la pantalla
                 grande, click = abre directo. */}
              <button class="tech-stage" type="button" data-tech-stage data-video-title="">
                <video class="tech-stage-video" data-stage-video muted loop playsinline preload="metadata" aria-hidden="true"></video>
                <span class="tech-stage-bar">
                  <span class="tech-stage-num" data-stage-num>01</span>
                  <span class="tech-stage-title" data-stage-title></span>
                  <span class="tech-stage-cta">
                    Ver con sonido
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 4l14 8-14 8z" /></svg>
                  </span>
                </span>
              </button>
              <div class="tech-strip">
                {TECHS.map((t, i) => (
                  <div class="tech-videos-group" data-tech-group={t.key} hidden={i !== 0}>
                    {t.videos.map((v, j) => (
                      <button class="work-card" type="button" data-video-src={`/assets/work/v/${v.slug}.mp4?v=2`} data-video-hls={`/assets/stream/v1/${v.slug}/master.m3u8`} data-video-title={v.title} data-video-num={String(j + 1).padStart(2, '0')}>
                        <span class="work-card-media"><img src={`/assets/work/thumbs/${v.slug}.jpg?v=2`} alt={v.title} width="1280" height="720" loading="lazy" /></span>
                        <span class="work-card-title"><span class="work-card-num">{String(j + 1).padStart(2, '0')}</span>{v.title}</span>
                      </button>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {featureVideo && (
    <!-- Pantalla de reproducción (2026-07-17): overlay con el reproductor
         NATIVO (play, línea de tiempo, volumen, pantalla completa). -->
    <div class="work-player" data-work-player hidden>
      <button class="work-player-close" data-work-close type="button" aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" style="width:20px;height:20px"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg></button>
      <p class="work-player-title" data-work-title></p>
      <video class="work-player-video" data-work-video controls playsinline preload="metadata"></video>
    </div>
  )}

  {/* en creative el trabajo ya se cuenta con el reel + la banda de fases
     + la galería — la lámina genérica de cifras sobraba y seguía
     apareciendo debajo (reporte 2026-07-17): solo va en los servicios
     sin reel */}
  {!featureVideo && (
    <section class="section" style={`--pc:${phase.color}`}>
      <div class="hairline-grid grid-3 reveal">
        {edge.stats.map(([num, txt]) => (
          <div>
            <p class="svc-stat-num" style={`color:${phase.color}`}>{num}</p>
            <p class="svc-stat-txt">{txt}</p>
          </div>
        ))}
      </div>
      <blockquote class="svc-quote reveal">«{edge.quote}»</blockquote>
    </section>
  )}

  {/* "¿para qué sirve?" fuera de creative (pedido 2026-07-17: eliminar
     esa lámina de la página) — las fases ya viven en la banda del reel */}
  {!featureVideo && (
    <section class="section" style="padding-top:0">
      <header class="section-head reveal">
        <p class="eyebrow"><span class="prompt">&gt;_</span>¿para qué sirve?</p>
        <hr />
      </header>
      <div class="hairline-grid grid-2 reveal">
        {edge.uses.map(([t, d], i) => (
          <div>
            <p class="svc-use-num prompt">{String(i + 1).padStart(2, '0')}</p>
            <p class="svc-use-title">{t}</p>
            <p class="svc-use-desc">{d}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* "entregables reales" también fuera de creative (pedido 2026-07-17,
     tercera lámina genérica eliminada): el trabajo real ya se muestra en
     la galería de técnicas con los videos */}
  {!featureVideo && (
    <section class="section" style="padding-top:0">
      <header class="section-head reveal">
        <p class="eyebrow"><span class="prompt">&gt;_</span>entregables reales</p>
        <hr />
      </header>
      <div class="hairline-grid grid-2 reveal">
        {edge.proof.map(([t, d]) => (
          <div>
            <p class="svc-use-title">{t}</p>
            <p class="svc-use-desc">{d}</p>
          </div>
        ))}
      </div>
      <p class="svc-closing reveal">{edge.closing}</p>
      <div class="svc-actions reveal" style="margin-top:40px">
        <a class="btn" href="/#valoracion">Agenda tu reunión de valoración</a>
        <a class="btn btn--ghost" href={phase.slug}>Volver a {phase.name}</a>
      </div>
    </section>
  )}
</Base>

<style>
  /* hero de video (muestra del rediseño, hoy solo creative): pantalla
     completa bajo el nav, video sangrado a los bordes, logo horneado
     centrado. La plancha negra exacta va como background del MISMO
     <img> estirado a 100% 100% — misma caja y malla de píxeles que el
     logo, alineación exacta por construcción (ver el patrón original
     en .hero-logo de index.astro). */
  .svc-vhero {
    position: relative;
    min-height: calc(100vh - 92px);
    display: flex;
    /* columna: logo arriba, statement + botones debajo (mock 2026-07-14) */
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    overflow: hidden;
  }
  .svc-vhero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-vhero-logo {
    position: relative;
    /* base común min(560px, 70vw) multiplicada por el factor de
       igualación visual de cada logo (--logo-f, ver VIDEO_HEROES): el
       factor va FUERA del min() a propósito — así en pantallas chicas
       los 6 se encogen por el mismo múltiplo y siguen viéndose del
       mismo tamaño entre sí, en vez de que el min() recorte antes a
       los factores grandes.
       × 0.41 = reducción del 59% pedida explícitamente 2026-07-13
       ("reduzcas todos los logos de los heros de los servicios en un
       59%") — multiplica a los 6 por igual, así la igualación visual
       recién calibrada se conserva intacta. */
    width: calc(var(--logo-f, 1) * min(560px, 70vw) * 0.41);
    height: auto;
    background: var(--plate) center / 100% 100% no-repeat;
  }

  /* Animación disparada por scroll (técnica de referencia del cliente):
     la sección mide 260vh — el visor (sticky) se queda clavado bajo el
     nav mientras el usuario "recorre" esos 260vh, y ese progreso de
     scroll ES la línea de tiempo (mapeo posicional directo, sin easing
     — mismo principio que initCosmosScroll en el home): el video pasa
     de scale .35 / opacity .35 a 1 / 1, y las miniaturas del fondo se
     desvanecen y abren paso. El script solo escribe transform/opacity
     (nunca layout) vía requestAnimationFrame. */
  /* Arranque tipo "pestaña" (diagrama del cliente 2026-07-14): la
     sección sube sobre el hero con margen negativo, de modo que al
     cargar la página se vean DENTRO del hero la leyenda "Conoce lo que
     podemos hacer:" y el borde superior del video chico — una pestaña
     que invita a bajar. Por eso el visor dejó de centrar el video:
     leyenda y video van anclados arriba (columna), y el video crece
     hacia abajo desde su borde superior (transform-origin: top). */
  /* -14vh (antes -26vh): la pestaña se redujo 60% a pedido (2026-07-14)
     — en el hero solo asoma la leyenda y un rectángulo del borde
     superior del video. */
  /* Sección de video con SCROLL-LOCK por gestos (rediseño 2026-07-15):
     un flick hacia abajo expande el video al 100% y TRABA el scroll;
     otro flick lo destraba y pausa; click alterna play/pausa. El stage
     se fija (sticky) durante un rango de scroll (la sección mide 160vh)
     para que el gesto de expansión siempre tenga dónde engancharse. */
  /* sin peek en el hero (2026-07-16): el reel se alcanza con el botón
     "Conoce lo que podemos hacer" (o bajando) — así las flechas del
     hero quedan en la misma posición que en los otros servicios. */
  .svc-feature { height: 160vh; position: relative; z-index: 2; margin-top: 0; }
  .svc-feature-stage {
    position: sticky;
    top: 92px;
    height: calc(100vh - 92px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    overflow: hidden;
  }
  /* misma voz que "Conoce más:" en los hubs (Geist Mono 600 —
     tipografía aprobada del brand book), en blanco sobre el hero.
     Desaparece cuando el video se expande. */
  .svc-feature-label {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 18.2px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent);
    white-space: nowrap;
    transition: opacity var(--t-ui) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-label { opacity: 0; }
  /* CTA bajo la pantalla: baja al manifiesto. Aparece al expandir. */
  .svc-feature-cta {
    margin: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--fg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-ui) var(--ease), color var(--t-hover) var(--ease);
  }
  .svc-feature[data-state='expanded'] .svc-feature-cta { opacity: 1; pointer-events: auto; }
  .svc-feature-cta:hover { color: var(--pc, var(--accent)); }
  .svc-feature-cta svg { width: 20px; height: 20px; animation: svc-bob 1.8s var(--ease) infinite; }
  @keyframes svc-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  /* el frame contiene el video + los controles y es lo que escala */
  .svc-feature-frame {
    position: relative;
    display: block;
    /* 16:9 SIEMPRE: el ancho también se limita por la altura disponible,
       para que el marco no quede más ancho que el video nativo */
    width: min(1180px, 84vw, calc((100vh - 250px) * 16 / 9));
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - 250px);
    transform: scale(0.92);
    transform-origin: center;
    opacity: 0.5;
    overflow: hidden;
    /* marco 3D minimalista premium (rediseño 2026-07-16): un bisel oscuro
       maquinado (padding con degradado iluminado desde arriba-izq), una
       línea de fase finísima al borde interior de la "pantalla", y una
       sombra de elevación en dos capas para que flote. Excepción de
       sombra autorizada por pedido explícito. */
    padding: 12px;
    background:
      linear-gradient(152deg,
        color-mix(in srgb, var(--fg) 13%, var(--void-deep)) 0%,
        var(--void-deep) 44%,
        var(--void-deep) 100%);
    border: 1px solid color-mix(in srgb, var(--fg) 9%, transparent);
    box-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (marco 3D pedido) */
      inset 0 1px 0 color-mix(in srgb, #FFFFFF 14%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--void-deep) 60%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--void-deep) 55%, transparent),
      0 2px 4px color-mix(in srgb, var(--void-deep) 50%, transparent),
      0 42px 90px -28px color-mix(in srgb, var(--void-deep) 78%, transparent);
    transition: transform var(--t-enter) var(--ease), opacity var(--t-enter) var(--ease);
    will-change: transform, opacity;
  }
  .svc-feature[data-state='expanded'] .svc-feature-frame {
    transform: scale(1);
    opacity: 1;
  }
  /* la "pantalla" (video): hairline de fase al borde interior del bisel */
  .svc-feature-video {
    box-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (borde interior de pantalla) */
      inset 0 0 0 1px color-mix(in srgb, var(--pc, var(--accent)) 45%, transparent),
      0 0 0 1px color-mix(in srgb, var(--void-deep) 70%, transparent);
  }
  /* PLAY grande a la izquierda (pedido 2026-07-16, restaurado): empieza
     FUERA del marco (recortado por overflow:hidden) y entra deslizándose,
     visible, hasta quedar dentro al expandir; se va al reproducir. Va
     arriba del centro para no tapar la barra nativa de controles. */
  .svc-feature-play {
    position: absolute;
    top: 44%;
    left: 8%;
    transform: translate(-190%, -50%);   /* fuera del marco, por la izquierda */
    z-index: 4;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(56px, 9vw, 136px);
    font-weight: 600;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (legibilidad sobre video) */ 0 2px 22px color-mix(in srgb, var(--void-deep) 78%, transparent);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    /* opacity casi instantánea: se vuelve visible mientras aún está fuera
       (recortada) para que se PERCIBA entrar deslizándose, no aparecer. */
    transition: transform var(--t-enter) var(--ease), opacity 120ms var(--ease);
  }
  .svc-feature[data-state='expanded'][data-reel='ready'] .svc-feature-play {
    transform: translate(0, -50%);       /* dentro del marco */
    opacity: 1;
    pointer-events: auto;
  }
  .svc-feature-play:hover { color: var(--pc, var(--accent)); }
  /* --- Lámina de manifiesto: las palabras se encienden en el color de la
     fase al hacer scroll (pedido 2026-07-16), con el aire de los landings
     de fase (fondo oscuro + halo de fase). --- */
  .reel-manifesto { position: relative; height: 250vh; z-index: 2; }
  .reel-manifesto-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6vw;
    overflow: hidden;
    /* MISMA base que el landing de la fase: tono de fase mezclado a negro
       (fallback void). El canvas Blue Edge pinta encima. */
    background: var(--void-deep);
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
  }
  /* efecto Blue Edge al fondo (igual que .hub-static del landing de fase) */
  .reel-manifesto-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .reel-manifesto-text {
    position: relative;
    z-index: 1;
    margin: 0 auto 0 0;              /* bloque a la izquierda */
    max-width: 22ch;
    text-align: left;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(30px, 5.2vw, 72px);
    line-height: 1.18;
    letter-spacing: -0.4px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;     /* palabras alineadas a la izquierda */
    gap: 0.1em 0.34em;
  }
  .reel-word {
    color: color-mix(in srgb, var(--fg) 13%, transparent);   /* apagada */
    transition: color 340ms var(--ease), text-shadow 340ms var(--ease);
  }
  .reel-word.lit {
    color: var(--pc, var(--accent));                          /* encendida */
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-16 (palabras que se encienden) */
      0 0 28px color-mix(in srgb, var(--pc, var(--accent)) 55%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .reel-manifesto { height: auto; }
    .reel-manifesto-stage { position: static; height: auto; padding: 96px 6vw; }
    .reel-word { color: var(--fg); }
  }
  /* --- Galería de trabajo: 3 tarjetas en fila (Video/Imágenes/Música) --- */
  .reel-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .reel-card {
    position: relative;
    display: block;
    border: 1px solid var(--hairline);
    background: var(--panel);
    color: var(--fg);
    text-decoration: none;
    padding: 0;
    width: 100%;
    cursor: pointer;
    appearance: none;
    font: inherit;
    overflow: hidden;
    transition: border-color var(--t-hover) var(--ease), transform var(--t-hover) var(--ease);
  }
  .reel-card:hover { border-color: var(--pc, var(--accent)); transform: translateY(-4px); }
  .reel-card[aria-expanded='true'] { border-color: var(--pc, var(--accent)); }
  .reel-card-media { display: block; aspect-ratio: 9 / 16; overflow: hidden; }
  .reel-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-enter) var(--ease); }
  .reel-card:hover .reel-card-media img { transform: scale(1.04); }
  /* degradado inferior: el título vive DENTRO de la imagen */
  .reel-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--void-deep) 88%, transparent) 100%);
    pointer-events: none;
  }
  .reel-card-title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 15px;
    z-index: 2;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  .reel-card-prompt { color: var(--pc, var(--accent)); }
  @media (max-width: 860px) {
    .reel-gallery-grid { grid-template-columns: 1fr; gap: 18px; }
  }
  /* 3 títulos que se despliegan al dar click en la tarjeta de Video */
  .reel-video-detail {
    margin-top: 30px;
    padding-top: 30px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .reel-video-detail[hidden] { display: none; }
  .reel-detail-title {
    margin: 0;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(22px, 3.4vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.3px;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 14px;
    /* entrada escalonada al abrir */
    opacity: 0;
    transform: translateY(10px);
  }
  .reel-detail-title svg { width: clamp(22px, 2.6vw, 30px); height: clamp(22px, 2.6vw, 30px); color: var(--pc, var(--accent)); flex: none; }
  /* --- BANDA de las 5 fases (rediseño 2026-07-17 con video de
     referencia del cliente): SIN fondo de efecto — sobre el fondo de la
     página, retícula hairline. El encendido es un RELLENO del color de
     fase que SUBE desde la base de la tarjeta (como el video); el título
     vive clavado al centro (no se mueve) y la explicación aparece
     debajo. --- */
  /* pantalla propia de la banda: ocupa el visor completo — la galería
     que sigue queda debajo del pliegue hasta el scroll/click */
  .phase-screen {
    min-height: calc(100vh - 92px);
    scroll-margin-top: 92px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .phase-band {
    position: relative;
    overflow: hidden;
    /* a lo ancho de TODA la pantalla, igual que .presion-band del home:
       rompe el contenedor de 1080px de .section y sangra de borde a
       borde del viewport (el overflow-x del documento ya recorta el
       exceso del ancho de la barra de scroll) */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    /* fondo con el efecto (pedido 2026-07-17): base oscura del tono de
       fase + Blue Edge pintando encima, como los hubs */
    background: var(--void-deep);
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
  }
  .phase-band-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .phase-band-inner {
    position: relative;
    z-index: 1;
    /* misma caja interior que .presion-inner del home (1180px centrados
       con 72px de piso lateral): la retícula de las 5 tarjetas ocupa el
       mismo ancho que la de los 3 datos de La Presión */
    max-width: 1180px;
    margin: 0 auto;
    /* título más arriba (pedido): menos aire encima */
    padding: 34px 72px 52px;
  }
  /* mismo título que .presion-h2 del home, receta IDÉNTICA valor por
     valor: >_ plateado horneado + texto, mismo clamp, peso, tracking,
     mismo blanco sobre acento y la misma sombra ligera aprobada */
  .phase-band-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(20px, 6vw, 29px);
    letter-spacing: -.02em;
    color: var(--on-accent);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (misma sombra que .presion-inner) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent),
                 0 3px 14px color-mix(in srgb, var(--void-deep) 40%, transparent);
  }
  .phase-band-prompt-img { height: 0.78em; width: auto; display: block; }
  .phase-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 34px;
    border: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
  }
  .phase-card {
    position: relative;
    overflow: hidden;
    /* vidrio translúcido en reposo (pedido 2026-07-17): la estática del
       fondo se percibe A TRAVÉS de la tarjeta desenfocada, con luz de
       arriba que se apaga hacia abajo — relieve 3D real sin sombras */
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--fg) 10%, transparent) 0%,
      color-mix(in srgb, var(--fg) 4%, transparent) 45%,
      color-mix(in srgb, var(--void-deep) 30%, transparent) 100%);
    backdrop-filter: blur(4px);
    border: none;
    border-inline-start: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
    /* la celda más exigente: título de 2 líneas + desc de ~7 líneas a
       6 columnas — todo cabe sin tocar el borde inferior */
    min-height: 322px;
    padding: 0;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition: transform var(--t-ui) var(--ease);
  }
  /* levantamiento sutil al encender: profundidad sin perder la retícula */
  .phase-card:hover,
  .phase-card.is-open { transform: translateY(-4px); z-index: 2; }
  .phase-card:first-child { border-inline-start: none; }
  /* el relleno que sube desde abajo (video de referencia) */
  .phase-card::before {
    content: '';
    position: absolute;
    inset: 0;
    /* tinte PROFUNDO del color de fase, iluminado desde arriba (no el
       plano saturado): pensado para leerse con tipografía blanca */
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--pc, var(--accent)) 72%, var(--void-deep)) 0%,
      color-mix(in srgb, var(--pc, var(--accent)) 38%, var(--void-deep)) 100%);
    transform: translateY(101%);
    transition: transform 340ms var(--ease);
    z-index: 0;
  }
  .phase-card:hover::before,
  .phase-card.is-open::before { transform: translateY(0); }
  /* título CLAVADO a una altura FIJA e IGUAL en las 5 celdas: jamás se
     mueve y la primera línea de todos queda alineada (con el centrado
     vertical, "Post/producción" a dos líneas arrancaba más arriba que
     los demás — reporte 2026-07-17) */
  .phase-card-title {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 88px;
    z-index: 1;
    text-align: center;
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0.2px;
    line-height: 1.25;
    color: var(--fg);
    transition: color var(--t-ui) var(--ease);
  }
  /* la explicación aparece DEBAJO del título, sin moverlo */
  /* la explicación arranca DEBAJO del título más alto (2 líneas) y cabe
     completa dentro de la celda — nunca se sale de la tarjeta */
  .phase-card-desc {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 148px;
    z-index: 1;
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    color: color-mix(in srgb, var(--on-accent) 88%, transparent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--t-ui) var(--ease) 120ms, transform var(--t-ui) var(--ease) 120ms;
  }
  /* tipografía en BLANCO sobre la tarjeta encendida (pedido 2026-07-17) */
  .phase-card:hover .phase-card-title,
  .phase-card.is-open .phase-card-title { color: var(--on-accent); }
  .phase-card:hover .phase-card-desc,
  .phase-card.is-open .phase-card-desc { opacity: 1; transform: none; }
  /* galería de técnicas: frase central que cambia + miniaturas */
  /* CTA bajo la banda: misma voz que el CTA del reel */
  .phase-band-cta {
    margin: 30px auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--fg);
    transition: color var(--t-hover) var(--ease);
  }
  .phase-band-cta:hover { color: var(--pc, var(--accent)); }
  .phase-band-cta svg { width: 20px; height: 20px; animation: svc-bob 1.8s var(--ease) infinite; }
  .tech-gallery {
    margin-top: 56px;
    /* pantalla entera al llegar (pedido): llena el visor */
    min-height: calc(100vh - 92px);
    scroll-margin-top: 92px;
    align-content: start;
    /* mismo esqueleto Y MISMO ANCHO que .engine-split del home: rompe el
       contenedor de 1080px y usa el viewport completo, con los mismos
       pisos laterales (izquierda alineada a la cuadrícula de 1180px,
       derecha sangrando hacia el borde como la rueda) */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-left: max(72px, calc(50vw - 590px));
    padding-right: max(40px, calc(50vw - 910px));
    display: grid;
    grid-template-columns: minmax(260px, 360px) 1fr;
    gap: 32px;
    align-items: start;
  }
  /* el título envuelve en 2 líneas: el >_ se ancla a la PRIMERA línea
     (flex-start), en el color del servicio por ir sobre fondo oscuro */
  /* encabezado CALCADO del slide de la rueda (.section-head + lockup):
     >_ 35px/700 en el color del servicio (fondo oscuro), texto 28px/600
     por línea base, hairline debajo — mismos números que .brand-lockup */
  .tech-head { margin: 0; }
  .tech-lockup {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 9px;
  }
  .tech-title-prompt {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 700;
    font-size: 35px;
    line-height: 1;
    color: var(--pc, var(--accent));
  }
  .tech-lockup-text {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -.02em;
    line-height: 1.18;
    color: var(--fg);
  }
  .tech-head hr { border: 0; border-top: 1px solid var(--hairline); margin: 14px 0 0; }
  /* botón de regreso al menú de Video/Imágenes/Música: misma voz que el
     CTA de la galería, alineado a la columna del menú */
  .tech-back {
    margin-top: 26px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.4px;
    color: var(--fg-muted);
    transition: color var(--t-hover) var(--ease);
