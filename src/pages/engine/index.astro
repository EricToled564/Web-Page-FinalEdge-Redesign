---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import LockupMark from '../../components/LockupMark.astro';
---
<Base
  title="El Final Edge Engine — consultoría de inteligencia artificial en México"
  description="Un sistema de tres fases —Evaluación, Capacidades y Ejecución— que lleva la IA de «no sé por dónde empezar» a operar tu negocio, sin contratar más."
>
  <section class="section" style="padding-top:150px">
    <header class="section-head reveal">
      <p class="section-num">ENGINE™</p>
      <p class="eyebrow eyebrow--lockup">
        <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" class="brand-lockup" />
      </p>
      <hr />
    </header>
    <h1 class="h2 engine-title reveal"><span class="prompt">&gt;_</span><span class="engine-title-text">un sistema de tres fases. no una lista de servicios.</span></h1>
    <p class="lead reveal" style="margin-top:24px">
      Cada fase construye sobre la anterior y te lleva de no saber por dónde empezar a tenerlo
      operando tu negocio, sin contratar más.
    </p>
    <div class="reveal wheel-card" style="margin-top:40px">
      <EngineWheel />
    </div>
    <a class="btn reveal" href="/#valoracion" style="margin-top:48px">Agenda tu reunión de valoración</a>
  </section>
</Base>

<style>
  /* pedido 2026-07-19: si envuelve a un segundo renglón, debe arrancar
     donde arranca la primera letra del anterior, nunca debajo del >_
     (que tampoco debe quedar tapado nunca) — el >_ en su propia
     columna de flex logra exactamente eso. */
  .engine-title { display: flex; align-items: baseline; gap: .3em; }
  .engine-title-text { flex: 1; }
</style>
