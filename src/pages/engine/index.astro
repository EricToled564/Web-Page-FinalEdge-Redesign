---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import { PHASES, EDGES } from '../../data/engine.js';
---
<Base
  title="El Final Edge Engine — consultoría de inteligencia artificial en México"
  description="Un sistema de tres fases —Evaluación, Capacidades y Ejecución— que lleva la IA de «no sé por dónde empezar» al motor de tu negocio."
>
  <section class="section" style="padding-top:150px">
    <header class="section-head reveal">
      <p class="section-num">ENGINE™</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>el final edge engine</p>
      <hr />
    </header>
    <h1 class="h2 reveal">Un sistema de tres fases. No una lista de servicios.</h1>
    <p class="lead reveal" style="margin-top:24px">
      Cada fase construye sobre la anterior y te lleva de no saber por dónde empezar a tener la
      inteligencia artificial funcionando como el motor de tu negocio, sin contratar más.
    </p>
    <div class="reveal wheel-card" style="margin-top:64px">
      <EngineWheel />
    </div>
    <div class="hairline-grid grid-3 reveal" style="margin-top:64px">
      {PHASES.map((p) => (
        <a class="phase-card" href={p.slug} style={`--pc:${p.color}`}>
          <p class="phase-tag">FASE {p.num}</p>
          <p class="phase-name">{p.name}</p>
          <p class="phase-tagline">{p.tagline}</p>
          <p class="phase-edges">
            {EDGES.filter((e) => e.phase === p.id).map((e) => (
              <span class="lockup"><span class="prompt">&gt;_</span><span class="lockup-name">{e.id}</span><span class="tag-ai">[AI]</span></span>
            ))}
          </p>
        </a>
      ))}
    </div>
    <a class="btn reveal" href="/#valoracion" style="margin-top:64px">Agenda tu reunión de valoración</a>
  </section>
</Base>

<style>
  .phase-card { display: grid; gap: 12px; align-content: start; color: inherit; }
  .phase-card:hover .phase-name { color: var(--pc); }
  .phase-tag { font-size: 14px; letter-spacing: .24em; color: var(--pc); }
  .phase-name { font-size: clamp(23px, 2.9vw, 38px); font-weight: 500; letter-spacing: -.025em; color: var(--fg); transition: color var(--t-hover) var(--ease); }
  .phase-tagline { font-size: 14px; color: var(--fg-muted); }
  .phase-edges { display: grid; gap: 6px; margin-top: 8px; }
</style>
