---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import { PHASES } from '../../data/engine.js';

export function getStaticPaths() {
  return PHASES.map((p) => ({ params: { phase: p.id }, props: { phase: p } }));
}
const { phase } = Astro.props;
/* Landing con estática aprobado 2026-07-11 (ver registro en brand/RULES.md):
   fondo en el color de la fase + estática de glifos, y desde el rediseño
   del mismo día: título centrado SIN numeración, statement corto aprobado
   debajo, la rueda como único menú de servicios (con "Conoce más:" en vez
   de repetir el nombre de la fase — ver apply() en engine-wheel.js) y dos
   botones en tinta (contraste elegante, sin rellenos de color). */
/* Los CTA del hub llevan a las DOS fases que no son la actual (pedido
   2026-07-11, sustituye al botón "Regresar al Engine"): la siguiente en
   el ciclo primero, la restante después. */
const otherPhases = [
  PHASES.find((p) => p.slug === phase.next.slug),
  PHASES.find((p) => p.id !== phase.id && p.slug !== phase.next.slug),
];
/* La rueda-menú debe medir lo que mide la PALABRA del título (pedido
   explícito). Geist Mono es monoespaciada: el ancho de la palabra es una
   función cerrada del font-size — avance por carácter (0.594em, medido
   en runtime contra la fuente real: 529.2px de palabra / 98px de fs) por número de caracteres, menos el
   tracking de -.06em entre caracteres. Así el ancho del carril queda en
   CSS puro (función del viewport vía --text-opener), idéntico en carga
   directa y en navegación SPA — la misma garantía determinista que
   mantiene la animación de la fase terminando exactamente en su
   posición final en ambos caminos. */
const titleEm = phase.name.length * 0.594 - (phase.name.length - 1) * 0.06;
---
<Base
  title={`${phase.name} — Final Edge Engine`}
  description={phase.lead}
>
  <section class="hub-hero hub-hero--static" style={`--pc:${phase.color}; --title-em:${titleEm}`}>
    <canvas class="hub-static" data-phase-static aria-hidden="true"></canvas>
    <div class="hub-stack">
      <h1 class="hub-name reveal" transition:name={`phase-${phase.id}`}>{phase.name}<span class="cursor hub-cursor">▌</span></h1>
      <p class="hub-statement reveal">
        {phase.statement[0]}<br />{phase.statement[1]}
      </p>
      <!-- la fase que giró e iluminó se queda como menú vivo del hub:
           los dos servicios se abren tocando los edges de la rueda.
           SIN fitHeight: ese es un contrato del split del home (y la
           isla persistente lo trae pegado al navegar, pero resize() lo
           ignora en rutas compactas — ver engine-wheel.js); aquí la
           rueda se dimensiona SOLO por el ancho del carril, que es
           función pura del viewport. -->
      <div class="hub-wheel reveal">
        <EngineWheel compact />
      </div>
      <div class="hub-actions reveal">
        {otherPhases.map((p) => (
          <a class="btn hub-btn-next" href={p.slug}>Explorar {p.name}</a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Landing del hub (las 3 fases, cada una en su color) ────────────────
     Fondo = color de la fase (excepción a R1.3 aprobada por el cliente,
     registrada en brand/RULES.md R7.3) + canvas de estática de glifos
     detrás del contenido (src/scripts/phase-static.js). Tinta void sobre
     el color de fase: #08080A rinde ~8.5:1 sobre ámbar, ~11:1 sobre cian
     y ~6.2:1 sobre magenta — todas arriba del 4.5:1 exigido. Colores solo
     via tokens/color-mix — ningún hex nuevo (R1.1). */
  .hub-hero--static {
    position: relative;
    background: var(--pc); /* fallback si el navegador no soporta color relativo */
    /* −15% de saturación (pedido explícito): se reduce el chroma del
       token de fase en oklch manteniendo luz y matiz exactos — color
       DERIVADO del token, no un hex nuevo (R1.1). El arco 3D de la
       rueda conserva el color pleno: el contraste sutil entre arco y
       fondo es parte del efecto. */
    background: oklch(from var(--pc) l calc(c * 0.85) h);
    min-height: 100vh;
    display: flex;
    /* flex-start, no center: el centrado vertical metía ~220px de aire
       muerto entre el nav y el título y hundía los botones al fondo del
       viewport (se cortaban en pantallas más bajas que la de prueba —
       queja explícita). Anclado arriba, el título queda a un paso del
       nav y los botones suben ~200px: visibles incluso en laptops de
       ~790px de alto útil. El fondo de estática sigue llenando el 100vh. */
    align-items: flex-start;
    justify-content: center;
    padding: 108px 24px 36px;
  }
  .hub-static { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* pila centrada: título → statement → rueda-menú → acciones */
  .hub-stack {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hub-name {
    font-size: var(--text-opener);
    font-weight: 600;
    letter-spacing: -.06em;
    line-height: .95;
    color: var(--void-deep);
  }
  /* mismo cursor parpadeante del hero ("Tu ventaja definitiva▌") tras el
     nombre de la fase (pedido explícito, las 3). .cursor global ya trae
     el parpadeo (blink 1.2s steps); aquí la barra se PINTA por CSS
     (background) en vez de confiar en el glifo ▌: a este tamaño de
     título (98px) cualquier sistema sin ese carácter en su fuente
     mostraría un hueco parpadeante invisible. El color es la tinta void
     del propio título (el azul accent del hero se pierde sobre cian). */
  .hub-cursor {
    color: transparent;            /* el glifo queda de respaldo, invisible */
    background: var(--void-deep);
    width: .34em;                  /* ▌ es medio bloque: barra, no cuadrado */
    height: .74em;
    vertical-align: 0;
    margin-left: .08em;
  }
  .hub-statement {
    margin-top: 16px;
    font-size: var(--text-subtitle);
    line-height: 1.45;
    color: color-mix(in srgb, var(--void-deep) 88%, transparent);
    max-width: 60ch;
  }
  /* Ancho del carril = ancho de la palabra del título (--title-em, ver
     frontmatter) × 1.0335 (el ×1.59 original reducido un 35% — pedido
     explícito de esta ronda) + los 2×26px de BUFFER que la rueda
     reserva alrededor del canvas (engine-wheel.js resize(): canvas =
     carril − 52). Crece/encoge con la palabra a cualquier viewport;
     min(100%…) protege pantallas angostas.

     Los márgenes NEGATIVOS recortan el aire interno del canvas, no la
     rueda: el encuadre de fase deja vacía la parte del círculo donde
     viven las piezas ocultas (arriba del chip "Conoce más:" y todo el
     semicírculo inferior), y ese vacío transparente empujaba el
     statement y los botones lejos del abanico (quejas explícitas:
     "no veo los botones", "no dejes tanto espacio entre el texto y la
     sección"). Los factores son proporciones del alto del stage
     (mismas a cualquier tamaño: el encuadre de cámara es fijo), NO
     píxeles sueltos — medidos con Playwright contra el chip y la base
     real del abanico. El canvas transparente se encima sobre statement
     y botones sin taparlos: los botones vienen DESPUÉS en el DOM (se
     pintan y clickean encima) y el statement no es interactivo. */
  .hub-wheel {
    --rail-w: min(100%, calc(var(--text-opener) * var(--title-em) * 1.0335 + 52px));
    --stage-h: calc((var(--text-opener) * var(--title-em) * 1.0335) * 0.9032 + 52px);
    width: var(--rail-w);
    margin-top: calc(var(--stage-h) * -0.215 + 12px);
    margin-bottom: calc(var(--stage-h) * -0.375 + 16px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hub-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 12px; }

  /* Botones en tinta fantasma (el cliente descartó los rellenos de
     color): borde y texto void sobre el color de fase, hover invertido
     que revela el color. Ambos CTA son pares — las dos fases que no
     están representadas en esta lámina. */
  .hub-btn-next {
    background: transparent;
    border-color: color-mix(in srgb, var(--void-deep) 55%, transparent);
    color: var(--void-deep);
    font-weight: 600;
  }
  .hub-btn-next:hover,
  .hub-btn-next:active {
    background: var(--void-deep);
    border-color: var(--void-deep);
    color: var(--pc);
  }

  @media (max-width: 980px) {
    .hub-hero--static { padding: 120px 16px 72px; }
  }
</style>

<!-- Astro empaqueta los <script> procesados por página; las 3 páginas de
     fase comparten esta plantilla y las 3 llevan la estática. -->
<script>import '../../scripts/phase-static.js';</script>
