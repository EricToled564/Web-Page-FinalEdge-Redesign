---
import Base from '../../layouts/Base.astro';
import EngineWheel from '../../components/EngineWheel.astro';
import { PHASES } from '../../data/engine.js';

export function getStaticPaths() {
  return PHASES.map((p) => ({ params: { phase: p.id }, props: { phase: p } }));
}
const { phase } = Astro.props;
/* Landing con estática aprobado 2026-07-11 (ver registro en brand/RULES.md):
   fondo en el color de la fase + estática de glifos, y desde el rediseño
   del mismo día: título centrado SIN numeración, statement corto aprobado
   debajo, la rueda como único menú de servicios (con "Conoce más:" en vez
   de repetir el nombre de la fase — ver apply() en engine-wheel.js) y dos
   botones en tinta (contraste elegante, sin rellenos de color). */
/* Navegación del hub (pedido 2026-07-15): dos flechas bajo el abanico —
   izquierda a la rueda, derecha a la siguiente fase del ciclo
   (phase.next ya trae el orden evaluación→capacidades→ejecución→
   evaluación desde el modelo). */
/* La rueda-menú debe medir lo que mide la PALABRA del título (pedido
   original). Geist Mono es monoespaciada: el ancho de la palabra es una
   función cerrada del font-size — avance por carácter (0.594em, medido
   en runtime contra la fuente real: 529.2px de palabra / 98px de fs) por
   número de caracteres, menos el tracking de -.06em entre caracteres.
   Corrección de esta ronda (pedido explícito): calcularlo por FASE (10
   caracteres "Evaluación" vs 11 "Capacidades" vs 9 "Ejecución") producía
   3 tamaños de rueda distintos — en Evaluación, la más chica de las 3,
   el label "intelligence" se salía del gajo (confirmado con captura:
   el texto cruzaba el borde diagonal del sector hacia el fondo). Se fija
   el cálculo a la palabra de Capacidades (la más larga → la rueda más
   grande) para las 3 páginas por igual — mismo tamaño de rueda en las
   3 fases, título de cada una sigue mostrando su propio nombre. Sigue en
   CSS puro (función del viewport vía --text-opener), idéntico en carga
   directa y en navegación SPA — la misma garantía determinista que
   mantiene la animación de la fase terminando exactamente en su
   posición final en ambos caminos. */
const sizeRefName = PHASES.find((p) => p.id === 'capacidades').name;
const titleEm = sizeRefName.length * 0.594 - (sizeRefName.length - 1) * 0.06;
/* Fondo aprobado 2026-07-12 tras iteración de experimentos: malla de
   puntos deformable (phase-dotgrid.js) — el cliente pidió aplicar el
   mismo formato a los TRES hubs de fase (sustituye a la estática de
   glifos en todos). */
---
<Base
  title={`${phase.name} — Final Edge Engine`}
  description={phase.lead}
>
  <section class="hub-hero hub-hero--static" style={`--pc:${phase.color}; --title-em:${titleEm}`}>
    <canvas class="hub-static" data-blue-edge aria-hidden="true"></canvas>
    <div class="hub-stack">
      <h1 class="hub-name reveal" transition:name={`phase-${phase.id}`}>{phase.name}<span class="cursor hub-cursor">▌</span></h1>
      <p class="hub-statement reveal">
        {phase.statement}
      </p>
      <!-- la fase que giró e iluminó se queda como menú vivo del hub:
           los dos servicios se abren tocando los edges de la rueda.
           SIN fitHeight: ese es un contrato del split del home (y la
           isla persistente lo trae pegado al navegar, pero resize() lo
           ignora en rutas compactas — ver engine-wheel.js); aquí la
           rueda se dimensiona SOLO por el ancho del carril, que es
           función pura del viewport. -->
      <div class="hub-wheel reveal">
        <p class="hub-cta-label" aria-hidden="true">Elige un servicio:</p>
        <EngineWheel compact />
      </div>
      <!-- Flechas de navegación (pedido 2026-07-15, sustituyen a los
           dos botones "Explorar …"), debajo de donde termina el
           abanico: la IZQUIERDA regresa a la rueda del home; la
           DERECHA lleva a la siguiente fase del ciclo (evaluación →
           capacidades → ejecución → evaluación). Aplica en escritorio
           y en móvil por igual (confirmado 2026-07-15). -->
      <div class="hub-actions reveal">
        <a class="hub-arrow" href="/#engine" aria-label="Regresar a la rueda">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></svg>
        </a>
        <a class="hub-arrow" href={phase.next.slug} aria-label={`Siguiente fase: ${phase.next.name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Landing del hub (las 3 fases, cada una en su color) ────────────────
     Fondo = color de la fase (excepción a R1.3 aprobada por el cliente,
     registrada en brand/RULES.md R7.3) + canvas de estática de glifos
     detrás del contenido (src/scripts/phase-static.js). Tinta void sobre
     el color de fase: #08080A rinde ~8.5:1 sobre ámbar, ~11:1 sobre cian
     y ~6.2:1 sobre magenta — todas arriba del 4.5:1 exigido. Colores solo
     via tokens/color-mix — ningún hex nuevo (R1.1). */
  .hub-hero--static {
    position: relative;
    /* red de contención final: las etiquetas ocultas de fase/edge que no
       están enfocadas (opacity:0) siguen ocupando su caja real, proyectada
       por el radio de la rueda 3D — puede caer fuera de .wheel-stage, que
       ya las recorta visualmente, y de .wheel-overlay (mismo recorte
       reforzado); ninguno de los dos evitaba que esa caja empujara el
       scrollWidth del documento 2px más allá del viewport a 360px (medido
       con Playwright: scroll horizontal real y forzable, aunque invisible).
       Cortar aquí, en el contenedor de sección más alto de la lámina,
       es la garantía definitiva de que ninguna etiqueta produce scroll de
       página — mismo principio que .wheel-stage ya declara, un nivel más
       arriba en la cadena. */
    overflow-x: hidden;
    /* base OSCURA del efecto Blue Edge (código de referencia del
       cliente 2026-07-13): el canvas pinta su propia base (token de
       fase mezclado a negro, ver blue-edge-bg.js); la sección replica
       ese tono para que no haya destello claro antes del primer cuadro.
       Fallback sin color relativo: void. Texto en BLANCO (pedido
       explícito). */
    background: var(--void-deep);
    background: oklch(from var(--pc) calc(l * 0.28) calc(c * 0.7) h);
    /* 100vh - 92px de nav (igual que .svc-vhero): con 100vh plenos los
       últimos 92px del hero cuelgan FUERA de la lámina visible — el
       ancla inferior de los botones quedaba a 956px en un viewport de
       900 (medido) y el reveal nunca los alcanzaba. */
    min-height: calc(100vh - 92px);
    display: flex;
    /* flex-start, no center: el centrado vertical metía ~220px de aire
       muerto entre el nav y el título y hundía los botones al fondo del
       viewport (se cortaban en pantallas más bajas que la de prueba —
       queja explícita). Anclado arriba, el título queda a un paso del
       nav y los botones suben ~200px: visibles incluso en laptops de
       ~790px de alto útil. El fondo de estática sigue llenando el 100vh. */
    /* stretch (antes flex-start): la pila ocupa todo el alto útil de la
       lámina para poder repartirse con márgenes auto — título+statement
       lo más cerca posible del centro vertical, rueda+botones como
       grupo abajo, pegados al borde inferior (pedido 2026-07-14). */
    align-items: stretch;
    justify-content: center;
    padding: 108px 24px 36px;
  }
  /* CAPAS EXPLÍCITAS (reporte 2026-07-13 de efecto cubriendo texto):
     el canvas decorativo va al FONDO por z-index declarado — nunca por
     orden implícito de pintado, que varía con posicionamientos y es
     frágil entre motores — y jamás intercepta el puntero (el hover 3D
     de la rueda no puede perder eventos contra la decoración). */
  /* el efecto Blue Edge es opaco y pinta su propia base oscura — sin
     opacidad encima: la legibilidad la da el texto en blanco. */
  .hub-static { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  /* "Conoce más:" es TEXTO DE LA PÁGINA, ya no el rótulo interno de la
     rueda (reporte repetido 2026-07-13 de la frase tapada): fuera de la
     isla persistente — se renueva con cada deploy — y por encima de
     TODO el carril por z-index declarado: ni el efecto ni los segmentos
     expandidos pueden tocarla, y ya no viaja con el hover. Mismos 18.2px
     Geist Mono del rótulo que sustituye (R2.1 ok). */
  .hub-cta-label {
    position: absolute;
    top: 23.5%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    font-family: 'Geist Mono', ui-monospace, monospace;
    /* mismo tamaño que el statement de la fase (pedido 2026-07-14) */
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--fg);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent);
    background: var(--void-deep);
    background: oklch(from var(--pc, var(--accent)) calc(l * 0.28) calc(c * 0.7) h);
    padding: 4px 12px;
    white-space: nowrap;
  }

  /* pila centrada: título → statement → rueda-menú → acciones */
  .hub-stack {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* reserva la franja de los botones (anclados en absoluto al fondo:
       bottom:0 apunta al borde de la caja, no al padding, así que no se
       mueven): el contenido en flujo — incluida la rueda — sube y el
       abanico deja de empalmarse con los botones (pedido 2026-07-14).
       Un padding aquí es lo ÚNICO que funciona: mover la rueda con
       márgenes lo cancelan exactamente los márgenes auto (Δ medido: 0). */
    padding-bottom: 84px;
  }
  .hub-name {
    /* margen auto arriba: junto con el auto de .hub-wheel reparte el
       aire libre en dos — el bloque título+statement queda lo más
       cercano posible al centro vertical de la lámina. */
    margin-top: auto;
    /* mitad del tamaño original (pedido explícito 2026-07-14) */
    font-size: calc(var(--text-opener) / 2);
    font-weight: 600;
    letter-spacing: -.06em;
    line-height: .95;
    color: var(--fg); /* blanco sobre la base oscura del efecto (pedido explícito) */
    /* sombra reforzada para que el blanco resalte sobre el campo
       animado — pedidos explícitos 2026-07-13/14; excepción a R3.2
       registrada en brand/RULES.md. Tinta derivada de void, nunca un
       hex nuevo. */
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 3px color-mix(in srgb, var(--void-deep) 78%, transparent),
                 0 3px 16px color-mix(in srgb, var(--void-deep) 60%, transparent);
  }
  /* mismo cursor parpadeante del hero ("Tu ventaja definitiva▌") tras el
     nombre de la fase (pedido explícito, las 3). .cursor global ya trae
     el parpadeo (blink 1.2s steps); aquí la barra se PINTA por CSS
     (background) en vez de confiar en el glifo ▌: a este tamaño de
     título (98px) cualquier sistema sin ese carácter en su fuente
     mostraría un hueco parpadeante invisible. El color es la tinta void
     del propio título (el azul accent del hero se pierde sobre cian). */
  /* pedido explícito: línea delgada (no bloque), que arranque a la misma
     altura que la palabra y mida lo mismo que ella. Medido con
     ctx.measureText() contra la fuente/peso/tamaño real del título
     ("Evaluación", sin descendentes): el trazo visible va de 0.745em
     sobre la línea base hasta ~la propia línea base — 0.755em de alto
     total. vertical-align:0 ancla el borde inferior del cursor a la
     línea base (igual que el pie de la palabra); height:0.755em hace
     que el borde superior quede a la misma altura que el techo de la
     palabra — sin eso, ambos extremos quedarían desalineados. */
  .hub-cursor {
    color: transparent;            /* el glifo queda de respaldo, invisible */
    /* la sombra del título NO se hereda aquí: text-shadow se dibuja
       incluso para texto transparente y el glifo ▌ invisible proyectaba
       un bloque oscuro junto al título (detectado en captura). */
    text-shadow: none;
    background: var(--fg); /* tinta del título, ahora blanca */
    width: .09em;
    /* pedido explícito: alineado exacto con la base Y el techo de la
       palabra — vertical-align:0 ya clava el borde inferior en la línea
       base (coincide con la base real de "E"/"n", sin descendentes en
       "Evaluación"/"Capacidades"/"Ejecución"), así que SOLO falta que el
       alto sea igual a la distancia real línea-base→techo-de-mayúscula.
       Medido por escaneo de píxeles del render real (no de metadatos de
       fuente, que en pruebas anteriores dieron valores contradictorios
       entre canvas measureText y Range — ninguno coincidía con el
       render): capturando el título aislado y buscando la primera/última
       fila con tinta sólida por letra, la "E" va de la fila 11 a la 80
       de una caja de 93px (fuente 98px, line-height .95) → 69px de
       techo-a-base = 0.704em. */
    height: .704em;
    /* vertical-align:0 (baseline "teórico") NO clavó el borde inferior en
       la línea base real: verificado con escaneo de píxeles del render
       (no de metadatos de fuente) que el cursor quedaba 12px arriba de
       donde de verdad se apoyan "E"/"n" — un inline-block VACÍO (sin
       contenido de texto propio, solo background) no siempre calcula su
       baseline igual que un carácter real en todos los motores. Corrección
       empírica, medida y re-verificada con el mismo escaneo: -12px a
       98px de fuente = -.1224em; en em para que la corrección escale
       proporcional con --text-opener (clamp) en cualquier viewport. */
    vertical-align: -.1224em;
    margin-left: .08em;
  }
  .hub-statement {
    margin-top: 16px;
    /* mismas características que "El sistema que potencializa tu
       productividad…" del home (.h2.engine-h2, la referencia anexada
       por el cliente 2026-07-14): clamp(14px, 1.3vw, 16px), peso 400,
       espaciado normal, interlineado 1.12. El color se queda blanco
       con sombra ligera — pedido explícito previo para leer sobre el
       efecto. */
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.12;
    color: color-mix(in srgb, var(--fg) 92%, transparent);
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 3px color-mix(in srgb, var(--void-deep) 78%, transparent),
                 0 3px 16px color-mix(in srgb, var(--void-deep) 60%, transparent);
    max-width: 60ch;
    /* auto: junto con el auto de .hub-name reparte el aire libre en dos
       — el bloque título+statement queda lo más cercano posible al
       centro vertical y empuja rueda+botones hacia el borde inferior. */
    margin-bottom: auto;
  }
  /* Ancho del carril = ancho de la palabra del título (--title-em, ver
     frontmatter) × 1.0335 (el ×1.59 original reducido un 35% — pedido
     explícito de esta ronda) + los 2×26px de BUFFER que la rueda
     reserva alrededor del canvas (engine-wheel.js resize(): canvas =
     carril − 52). Crece/encoge con la palabra a cualquier viewport;
     min(100%…) protege pantallas angostas.

     Los márgenes NEGATIVOS recortan el aire interno del canvas, no la
     rueda: el encuadre de fase deja vacía la parte del círculo donde
     viven las piezas ocultas (arriba del chip "Conoce más:" y todo el
     semicírculo inferior), y ese vacío transparente empujaba el
     statement y los botones lejos del abanico (quejas explícitas:
     "no veo los botones", "no dejes tanto espacio entre el texto y la
     sección"). Los factores son proporciones del alto del stage
     (mismas a cualquier tamaño: el encuadre de cámara es fijo), NO
     píxeles sueltos — medidos con Playwright contra el chip y la base
     real del abanico. El canvas transparente se encima sobre statement
     y botones sin taparlos: los botones vienen DESPUÉS en el DOM (se
     pintan y clickean encima) y el statement no es interactivo. */
  .hub-wheel {
    --rail-w: min(100%, calc(var(--text-opener) * var(--title-em) * 1.0335 + 52px));
    --stage-h: calc((var(--text-opener) * var(--title-em) * 1.0335) * 0.9032 + 52px);
    width: var(--rail-w);
    /* el recorte negativo del vacío superior del canvas se queda (sin
       él la pila desborda la lámina — medido: botones a 976px en un
       viewport de 900); el empuje hacia abajo lo hace el margen auto
       de .hub-statement. El negativo inferior mantiene a los botones
       abrazando al abanico, bajando con él como grupo. */
    margin-top: calc(var(--stage-h) * -0.215 + 12px);
    margin-bottom: calc(var(--stage-h) * -0.375 + 16px);
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* botones anclados al borde inferior de la lámina (pedido 2026-07-14):
     absolutos al fondo de la pila (que ya es relative y mide el alto
     útil completo) — quedan a los 36px del padding inferior del hero,
     debajo del abanico, sin empujar el layout. */
  .hub-actions {
    position: absolute;
    bottom: 0;
    /* centrado horizontal sin transform: .reveal anima transform y
       pisaría un translateX aquí (detectado midiendo: el grupo quedaba
       56px abajo y fuera de lámina hasta el reveal). */
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    width: max-content;
    max-width: calc(100vw - 48px);
  }

  /* Flechas de navegación (pedido 2026-07-15, sustituyen a los botones):
     chip cuadrado con el hex exacto de la fase (--pc directo del modelo)
     y trazo oscuro; hover invertido a blanco, mismo lenguaje que tenían
     los botones. Área táctil de 52px. */
  .hub-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--pc, var(--accent));
    border: 1px solid var(--pc, var(--accent));
    color: var(--void-deep);
    transition: background var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .hub-arrow svg { width: 24px; height: 24px; }
  .hub-arrow:hover,
  .hub-arrow:active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--void-deep);
  }

  @media (max-width: 980px) {
    .hub-hero--static { padding: 108px 16px 48px; }
    /* MÓVIL (auditoría 2026-07-14): los botones anclados al fondo se
       apilaban ENCIMA del abanico (los gajos — el menú de servicios —
       quedaban tapados, medido en captura 390×844). En pantallas
       angostas vuelven al flujo natural bajo la rueda y la página crece
       lo que necesite. Los márgenes auto del título/statement SÍ se
       conservan (pedido 2026-07-15): texto lo más cercano al centro y
       rueda+botones hacia el borde inferior; si el contenido no cabe,
       los autos colapsan a 0 y todo fluye — sin empalmes posibles. */
    .hub-stack { padding-bottom: 0; }
    .hub-actions {
      position: static;
      margin: 16px auto 0;
    }
    /* abanico a sangre completa (pedido 2026-07-15: sección de los
       servicios mucho mayor): carril = 100vw y margen interno mínimo
       (BUFFER móvil 2px, engine-wheel.js) → canvas de ~386px (antes
       306: +26% lineal, +59% de área). --stage-h se recalibra a la
       misma fórmula con el buffer móvil para que los recortes
       negativos sigan siendo proporcionales al abanico real. */
    .hub-wheel {
      --rail-w: 100vw;
      --stage-h: calc((100vw - 2px) * 0.9032 + 2px);
      margin-inline: calc(50% - 50vw);
    }
  }
</style>

<script>import '../../scripts/blue-edge-bg.js';</script>
