---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
---
<Base>
  <!-- 00 · HERO — video de fondo (fotograma clave: filamento del foco en
       forma de cerebro, se enciende en azul acento — misma paleta que
       la marca) con velo oscuro para garantizar contraste con el texto,
       texto centrado en toda la pantalla. -->
  <section class="hero" id="inicio">
    <video
      class="hero-video"
      src="/assets/video/hero-bg.mp4"
      poster="/assets/video/hero-bg-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    ></video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow hero-eyebrow reveal">
        <span class="prompt hero-eyebrow-prompt">&gt;_</span> Tu ventaja definitiva<span class="cursor">▌</span>
      </p>
      <img
        class="hero-logo reveal"
        src="/assets/logos/logo-mono-light.png"
        alt="final edge [AI]"
        width="300"
      />
      <h1 class="hero-h1 reveal">
        30 años de experiencia dirigen.<br />Nuestros flujos de trabajo propietarios de IA ejecutan.
      </h1>
      <p class="hero-sub reveal">Haz más. Sin contratar más.</p>
    </div>
  </section>

  <!-- 01 · LA PRESIÓN — franja Edge Blue full-bleed, mismo tratamiento
       que la placa final ("Tu ventaja final"): sin número de sección,
       solo el heading y las tres cifras. El >_ hereda el font-size del
       heading (mismo elemento), así queda exactamente a la altura de
       la "L" de "La", nunca más chico. -->
  <section class="presion-band" id="presion">
    <!-- misma estática de glifos que los hubs de fase (pedido explícito:
         "el mismo estilo de background en las barras azules edge") — el
         canvas es transparente, la barra pone el Edge Blue; los glifos
         van en --void-deep como en los hubs (phase-static.js los lee de
         los tokens computados en runtime, es agnóstico al color). -->
    <canvas class="band-static" data-phase-dotgrid aria-hidden="true"></canvas>
    <div class="presion-inner">
      <p class="presion-h2 reveal">
        <img class="presion-prompt-img" src="/assets/logos/symbol-prompt-silver.png" alt="" width="260" height="200" />
        La Presión
      </p>
      <div class="presion-facts reveal">
        <div class="presion-fact">
          <p class="presion-fact-num">48<span class="presion-fact-arrow">→</span>40</p>
          <p class="presion-fact-txt">horas de jornada laboral semanal hacia 2030</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+26.6<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">acumulado en el salario mínimo en los últimos dos años</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+52<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">impacto acumulado en el costo laboral</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · EL ENGINE — pantalla completa, a dos columnas, usando todo el
       ancho de la ventana (referencia: las páginas anexas, no el
       contenedor centrado de 1080px que usan las demás secciones). La
       rueda es la única fuente de los nombres de servicio: no se repiten
       en una lista aparte. Titular al tamaño del hero (R5.8: el nombre
       del sistema nunca va como texto plano — el lockup de arriba ya lo
       muestra, el h2 solo continúa la frase). -->
  <section class="engine-split" id="engine">
    <div class="engine-col-text">
      <header class="section-head reveal">
        <p class="eyebrow eyebrow--lockup">
          <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" class="brand-lockup" />
        </p>
        <hr />
      </header>
      <h2 class="h2 engine-h2 reveal">El sistema que potencializa tu productividad y la convierte en una ventaja competitiva.</h2>
    </div>
    <div class="engine-col-wheel">
      <div class="wheel-card" id="wheel-entry">
        <EngineWheel fitHeight />
      </div>
    </div>
  </section>

  <!-- placa Edge Blue — cierre de la página principal. Mismo tratamiento
       de relieve 3D que logo-finaledge.png (R5.4: monocromos/marca
       siempre como PNG horneado con relieve 3D intacto, nunca
       CSS-simulado): el texto se generó como un asset real con bisel +
       iluminación calculada (tools/plate-3d — ver script fuente en el
       historial de commits), no con box-shadow/text-shadow (R3.2).
       Centrado en la misma cuadrícula de 1180px que usa "la presión".
       Sin animación (pedido explícito) — estática, tamaño de fuente
       igual al h1 del hero (ver .plate-img). -->
  <section class="plate" aria-label="Tu ventaja definitiva">
    <canvas class="band-static" data-phase-dotgrid aria-hidden="true"></canvas>
    <div class="plate-scene">
      <span class="plate-img-wrap">
        <img
          class="plate-img"
          src="/assets/plate-3d.png"
          width="9396"
          height="1225"
          alt="Tu ventaja definitiva."
        />
      </span>
      <!-- sin destino funcional todavía (pedido explícito) — <button>,
           no <a href="#">, para no simular una navegación que no existe. -->
      <div class="plate-ctas">
        <button type="button" class="plate-cta">Por qué elegirnos</button>
        <button type="button" class="plate-cta">Test: ¿Estás preparado para trabajar con IA?</button>
        <button type="button" class="plate-cta">Bitácora [AI]</button>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/phase-dotgrid.js'; // malla de puntos de las dos barras Edge Blue (mismo formato que los hubs, pedido 2026-07-12)
  </script>

  <script>
    /* Transición hero → rueda ligada al scroll (lenguaje cosmos.so):
       el hero se eleva y desvanece; la rueda entra escalando y subiendo.
       Mapeo posicional directo (sin easing: el scroll ES la línea de tiempo). */
    function initCosmosScroll() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const hero = document.querySelector('.hero-inner') as HTMLElement | null;
      const card = document.getElementById('wheel-entry');
      if (!hero && !card) return;
      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight || 800;
        if (hero) {
          const p = Math.min(1, scrollY / (vh * 0.9));
          hero.style.transform = `translateY(${scrollY * 0.14}px)`;
          hero.style.opacity = String(1 - p * 0.4);
        }
        if (card) {
          const r = card.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
          card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.94 + p * 0.06})`;
          card.style.opacity = String(0.35 + p * 0.65);
        }
      }
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    initCosmosScroll();
    document.addEventListener('astro:page-load', initCosmosScroll);

    /* El atributo autoplay del <video> del hero solo actúa en la carga
       de DOCUMENTO: al regresar al home por navegación SPA (p. ej. click
       al logo del nav), el ClientRouter inserta un <video> nuevo en el
       swap y el navegador NO lo arranca solo — el hero quedaba congelado
       en el poster (bug reportado). play() explícito en cada
       astro:page-load; al ir muted, el navegador lo permite sin gesto.
       UN SOLO intento no basta (bug reportado por segunda vez ya con el
       play() puesto): en el swap el <video> recién insertado apenas está
       arrancando su carga, y un play() puede morir en la carrera con esa
       carga (AbortError "interrupted by a new load request") — el catch
       se lo tragaba en silencio y nada volvía a intentar. Por eso se
       insiste: al instante, cuando el video ya tiene datos (loadeddata)
       y dos reintentos con margen. Todos los intentos son idempotentes
       (si ya está corriendo, paused es false y no se hace nada), así que
       insistir nunca reinicia ni traba nada. */
    function playHeroVideo() {
      const v = document.querySelector('.hero-video');
      if (!v) return;
      const kick = () => { if (v.isConnected && v.paused) v.play().catch(() => {}); };
      kick();
      v.addEventListener('loadeddata', kick, { once: true });
      setTimeout(kick, 350);
      setTimeout(kick, 1400);
    }
    playHeroVideo();
    document.addEventListener('astro:page-load', playHeroVideo);
  </script>
</Base>

<style>
  /* el hero mantiene su peso completo (logotipo, titular, párrafo, dos
     CTA) pero SIN el hueco muerto de ~150px que dejaba entre el nav y el
     primer texto — el contenido arranca inmediatamente bajo el nav. */
  /* fondo de video: cubre el hero entero, recortado sin distorsión
     (object-fit:cover) y siempre detrás del velo + el texto. */
  .hero {
    position: relative;
    padding: 48px 72px 64px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(100vh - 92px);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: saturate(1.5) brightness(1.08);
  }
  /* velo oscuro UNIFORME: garantiza contraste de texto sin importar el
     fotograma del video (pasa de campo claro al atardecer a foco
     encendido en azul) — el texto está centrado en TODA la pantalla,
     así que el oscurecimiento tiene que ser parejo, no solo detrás de
     un bloque de texto en una esquina. Opacidad reducida a la mitad
     (82% → 41%) para que el foco se vea más brillante. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--bg) 41%, transparent);
  }
  .hero-inner { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .hero-eyebrow { color: var(--fg); }
  .hero-eyebrow-prompt { color: var(--silver); }
  .hero-logo { width: min(220px, 55vw); height: auto; margin: 28px 0 24px; }
  .hero-h1 {
    font-size: clamp(17px, 2.3vw, 32px);
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: var(--fg);
  }
  .hero-sub {
    margin-top: 24px;
    font-size: clamp(14px, 1.45vw, 19px);
    letter-spacing: -.025em;
    color: var(--fg);
  }
  /* franja "la presión" — mismo tratamiento full-bleed que .plate (placa
     final): fondo Edge Blue sólido, contenido acotado y centrado, texto
     en --on-accent (blanco) porque azul sobre azul no se leería. */
  .presion-band { position: relative; background: var(--accent); padding: 96px 72px; overflow: hidden; }
  /* la estática vive detrás del contenido de ambas barras azules; los
     CTA de la placa siguen clickeables porque vienen después en el DOM */
  .band-static { position: absolute; inset: 0; width: 100%; height: 100%; }
  .presion-inner { position: relative; }
  .presion-inner { max-width: 1180px; margin: 0 auto; }
  .presion-h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    /* equivalente al lockup >_ FINAL EDGE [ENGINE] de la sección
       siguiente (18px base × escala 1.6 = 28.8px) — antes crecía hasta
       48px con el viewport y quedaba mucho más grande que ese logo. */
    font-size: clamp(20px, 6vw, 29px);
    letter-spacing: -.02em;
    color: var(--on-accent);
  }
  /* >_ con relieve 3D real (R5.4: "siempre los PNG horneados, relieve 3D
     intacto") — recorte exacto del símbolo de logo-mono-light.png, la
     variante plata aprobada para fondos accent/void. Nunca CSS
     box-shadow/text-shadow para simular volumen (R3.2 los prohíbe). La
     altura sigue el font-size del heading (em), así se mantiene a la
     altura de la "L" de "La" en cualquier tamaño de pantalla. */
  .presion-prompt-img { height: 0.78em; width: auto; display: block; }
  /* bloques con delimitación clara: misma retícula hairline que el
     resto del sitio (gap:1px + fondo de línea), adaptada a superficie
     accent — cada bloque es un rectángulo vertical con el número
     centrado arriba del texto, nunca a la izquierda. */
  /* pedido explícito: los cuadros SIN fondo sólido — la estática de la
     barra se ve a través de ellos. El hairline interior ya no puede
     venir del fondo del wrapper visto por el gap de 1px (sin relleno en
     las celdas se vería el wrapper completo, no una línea): las
     divisiones pasan a ser bordes de las propias celdas. */
  .presion-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 56px;
    border: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent);
  }
  .presion-fact + .presion-fact { border-inline-start: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent); }
  .presion-fact {
    background: transparent;
    padding: 40px 28px;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .presion-fact-num { font-size: clamp(28px, 3.2vw, 44px); font-weight: 600; letter-spacing: -.03em; color: var(--on-accent); white-space: nowrap; }
  .presion-fact-unit { font-size: 0.55em; }
  .presion-fact-arrow { display: inline-block; margin: 0 .2em; font-weight: 400; font-size: .7em; }
  .presion-fact-txt { margin-top: 16px; font-size: var(--text-body); line-height: 1.5; color: color-mix(in srgb, var(--on-accent) 78%, transparent); }

  /* El Engine — pantalla completa a dos columnas, ancho real de la
     ventana (no el contenedor de 1080px de .section), igual que las
     referencias: texto corto a la izquierda, gráfico dominante a la
     derecha, sangrado hacia el borde. La rueda se dimensiona a sí misma
     en engine-wheel.js para NUNCA exceder el alto disponible de esta
     fila — así siempre cabe entera en una sola pantalla. */
  .engine-split {
    display: grid;
    /* columna de texto 280→360 (antes 420): la rueda pidió +30% de
       tamaño explícito y a partir de ~900px de ancho de viewport ya no
       hay espacio de sobra — se le quita a la columna de texto (sigue
       siendo perfectamente legible a 360px, 2 líneas cortas) para
       dárselo a la rueda, que es la prioridad ("el objetivo es
       visibilidad"). */
    grid-template-columns: minmax(260px, 360px) 1fr;
    align-items: center;
    gap: 24px;
    /* un poco más de aire arriba que abajo — empuja el contenido
       ligeramente hacia abajo dentro de la sección, en vez de quedar
       pegado justo debajo del nav. */
    padding-top: 104px;
    padding-bottom: 72px;
    /* Antes esta sección alineaba su ancho de contenido (1180px) con
       .presion-inner, para que el borde derecho de la rueda coincidiera
       con el de esa cuadrícula. Se rompe esa alineación a propósito: la
       rueda +30% (ver wheel-card/refW en engine-wheel.js) necesita más
       ancho de contenido (1320px) del que esa cuadrícula compartida
       permite — el piso de 72px por lado (pensado para 1180px) dejaba
       la rueda comprimida de vuelta a su tamaño viejo en viewports
       típicos de escritorio (1400px).
       IZQUIERDA: alineada EXACTAMENTE con la cuadrícula de la lámina
       anterior (pedido explícito 2026-07-12) — .presion-inner es una
       caja de 1180px centrada dentro de 72px de padding, así que su
       borde izquierdo vive en max(72px, 50vw − 590px); el lockup
       ">_ final edge [ENGINE]" arranca en ese mismo borde.
       DERECHA: lo mínimo que preserva la rueda a tamaño completo
       (1083px de card) en pantallas anchas — 50vw − 910px sale de
       despejar: vw − padIzq − 360 de texto − 24 de gap − 16 de padding
       de columna − padDer ≥ 1083. Asimétrico a propósito: la rueda
       sangra hacia el borde derecho por diseño (ver .engine-col-wheel),
       la retícula manda solo del lado del texto. */
    padding-left: max(72px, calc(50vw - 590px));
    padding-right: max(40px, calc(50vw - 910px));
  }
  .engine-col-text { padding-right: 24px; }
  /* mismo font-size y letter-spacing que .hero-sub ("Haz más. Sin
     contratar más.") — no --text-h2 genérico ni el tamaño del h1. Sin
     text-transform: mayúsculas y minúsculas normales, como el copy. */
  .engine-h2 { font-size: clamp(14px, 1.3vw, 16px); font-weight: 400 !important; letter-spacing: normal; margin-top: 20px; color: var(--fg-muted); }
  .engine-col-wheel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    padding: 8px 16px 8px 0;
  }
  /* dentro del split, la rueda flota libre — sin el marco de "tarjeta"
     (borde + fondo + padding) que usa en otras páginas: en las
     referencias el gráfico sangra al borde, no vive dentro de una caja.
     Alto FIJO (no 100%/100vh): con fitHeight, engine-wheel.js lee este
     alto para limitar el tamaño de la rueda — un valor fijo la mantiene
     legible (nombres de servicio a tamaño normal) sin depender de la
     altura de la ventana ni desbordar la sección. */
  /* 1083px = 833px × 1.3 (pedido explícito: rueda 30% más grande).
     El alto NO es fijo: min(1083px, 100vh − 116px) es la garantía dura
     de que la rueda NUNCA se corta — en pantallas altas gana el tamaño
     completo (canvas de 1031px = 1083 − 52 de BUFFER), y en pantallas
     bajas gana el alto real disponible bajo el nav, donde fitHeight
     (engine-wheel.js) redimensiona el canvas al alto del card y el
     círculo entero cabe siempre. 116 = 92 de nav + 24 de respiro
     visible repartido arriba/abajo — a propósito lo MÍNIMO: cada píxel
     de reserva extra es un píxel menos de rueda justo en las pantallas
     bajas donde más cuesta el tamaño (el card ya trae 26px de aire
     interno por lado, el BUFFER del carril de etiquetas). Un solo min()
     en vez de un media query aparte: no hay punto de corte que mantener
     sincronizado con el tamaño de la rueda.
     Ancho y alto con el mismo techo (cuadrado) para que ninguno de los
     dos limite al otro por separado en el cálculo de engine-wheel.js. */
  .engine-col-wheel .wheel-card {
    display: flex;
    width: 100%;
    max-width: 1083px;
    height: min(1083px, calc(100vh - 116px));
    align-items: center;
    justify-content: flex-end;
    border: none;
    background: transparent;
    padding: 0;
  }
  @media (max-width: 900px) {
    .engine-split {
      grid-template-columns: 1fr;
      /* misma alineación con la cuadrícula de "La Presión" también en la
         columna apilada: su padding lateral es 72px hasta 760px y 24px
         de ahí para abajo (ver el media query de .presion-band). */
      padding: 56px 72px;
      gap: 32px;
    }
    .engine-col-text { padding-right: 0; }
    .engine-col-wheel { justify-content: center; padding: 0; }
    .engine-col-wheel .wheel-card { height: auto; max-width: 100%; }
  }

  /* placa Edge Blue de cierre — misma cuadrícula de 1180px que
     .presion-inner (arriba), texto centrado dentro de ella. */
  .plate {
    position: relative;
    background: var(--accent);
    padding: 120px 72px;
    overflow: hidden;
  }
  /* mismo lenguaje de relieve 3D que el logotipo horneado
     (logo-finaledge.png / R5.4 — monocromos SIEMPRE como PNG horneado
     con relieve 3D intacto, nunca CSS-simulado): asset real con bisel +
     iluminación calculada, mismo navy de canto (--hub-ring) que usa el
     logotipo. Escala con --text-plate para conservar el tamaño ya
     aprobado en cualquier ancho de viewport. */
  .plate-scene {
    position: relative; /* encima del canvas de estática */
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }
  /* envoltura al tamaño exacto de la imagen (inline-block se ajusta al
     contenido). */
  .plate-img-wrap { position: relative; display: inline-block; }
  /* pedido explícito: sin animación (se quitó el import de
     plate-pixel-reveal.js más abajo) y el mismo tamaño de fuente que el
     h1 del hero (.hero-h1: clamp(17px, 2.3vw, 32px)) — mismo multiplicador
     (11.5053) que ya traducía --text-plate al ancho real de la imagen
     horneada, solo que ahora aplicado sobre el clamp() del hero en vez
     del de la placa, para que escale proporcional igual que antes.
     Sigue centrada por .plate-scene (text-align:center), sin tocar. */
  .plate-img {
    display: block;
    width: calc(clamp(17px, 2.3vw, 32px) * 11.5053);
    max-width: 100%;
    height: auto;
  }
  /* 3 botones debajo de la frase, pedido explícito — mismo lenguaje que
     .btn (brand book: piso de 14px, sin border-radius R3.1, una sola
     curva de easing R3.4) pero invertido para fondo accent (azul): .btn
     usa color/borde accent sobre fondo claro, aquí sería azul sobre
     azul, ilegible — mismo patrón ya usado en esta página para texto
     sobre accent (--on-accent, ver .presion-*). Sin destino funcional
     todavía (pedido explícito), por eso son <button>, no enlaces. */
  .plate-ctas {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .plate-cta {
    font-family: var(--font-ui);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--on-accent);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--on-accent) 40%, transparent);
    padding: 16px 28px;
    cursor: pointer;
    transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease), border-color var(--t-hover) var(--ease);
  }
  .plate-cta:hover { background: var(--on-accent); color: var(--accent); border-color: var(--on-accent); }
  .plate-cta:active { background: color-mix(in srgb, var(--on-accent) 85%, transparent); }

  @media (max-width: 760px) {
    .hero { padding: 32px 24px 48px; }
    .plate { padding: 88px 24px; }
    .presion-band { padding: 64px 24px; }
    /* sigue a .presion-band: la cuadrícula baja a 24px de lateral aquí */
    .engine-split { padding-left: 24px; padding-right: 24px; }
    .presion-facts { grid-template-columns: 1fr; margin-top: 40px; }
    .presion-fact { min-height: 0; padding: 32px 24px; }
    /* en columna única el divisor es horizontal, no vertical */
    .presion-fact + .presion-fact { border-inline-start: none; border-block-start: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent); }
  }
</style>
