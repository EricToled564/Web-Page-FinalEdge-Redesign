---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
import { EDGES } from '../data/engine.js';
/* Items del menú de servicios (labels pedidos 2026-07-15, solo para el
   menú del home — los nombres canónicos de los servicios no cambian):
   "Planeación Estratégica" (antes Estrategia), "Inteligencia de
   Negocios" (antes Intelligence) MÁS una línea extra "Inteligencia de
   Mercados" que también lleva a intelligence, y "Creación de Software
   Personalizado" (antes Sistemas). */
const MENU_ITEMS = [
  { label: 'Planeación Estratégica', edge: 'strategy' },
  { label: 'Inteligencia de Negocios', edge: 'intelligence' },
  { label: 'Inteligencia de Mercados', edge: 'intelligence' },
  { label: 'Capacitación en IA', edge: 'readiness' },
  { label: 'Optimización de Procesos', edge: 'flow' },
  { label: 'Creación de Software Personalizado', edge: 'systems' },
  { label: 'Producción Creativa', edge: 'creative' },
].map((m) => ({ ...m, slug: EDGES.find((e) => e.id === m.edge).slug }));
---
<Base>
  <!-- 00 · HERO — video de fondo (fotograma clave: filamento del foco en
       forma de cerebro, se enciende en azul acento — misma paleta que
       la marca) con velo oscuro para garantizar contraste con el texto,
       texto centrado en toda la pantalla. -->
  <section class="hero" id="inicio">
    <video
      class="hero-video"
      src="/assets/video/hero-bg.mp4"
      poster="/assets/video/hero-bg-poster.webp"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow hero-eyebrow reveal">
        <span class="prompt hero-eyebrow-prompt">&gt;_</span> Tu ventaja definitiva<span class="cursor">▌</span>
      </p>
      <img
        class="hero-logo reveal"
        src="/assets/logos/logo-mono-light.png"
        alt="final edge [AI]"
        width="300"
      />
      <h1 class="hero-h1 reveal">
        30 años de experiencia dirigen.<br />Nuestros flujos de trabajo propietarios de IA ejecutan.
      </h1>
      <p class="hero-sub reveal">Haz más. Sin contratar más.</p>
    </div>
  </section>

  <!-- 01 · LA PRESIÓN — franja Edge Blue full-bleed, mismo tratamiento
       que la placa final ("Tu ventaja final"): sin número de sección,
       solo el heading y las tres cifras. El >_ hereda el font-size del
       heading (mismo elemento), así queda exactamente a la altura de
       la "L" de "La", nunca más chico. -->
  <section class="presion-band" id="presion">
    <!-- misma estática de glifos que los hubs de fase (pedido explícito:
         "el mismo estilo de background en las barras azules edge") — el
         canvas es transparente, la barra pone el Edge Blue; los glifos
         van en --void-deep como en los hubs (phase-static.js los lee de
         los tokens computados en runtime, es agnóstico al color). -->
    <canvas class="band-static" data-blue-edge aria-hidden="true"></canvas>
    <div class="presion-inner">
      <p class="presion-h2 reveal">
        <img class="presion-prompt-img" src="/assets/logos/symbol-prompt-silver.png" alt="" width="260" height="200" />
        La Presión
      </p>
      <div class="presion-facts reveal">
        <div class="presion-fact">
          <p class="presion-fact-num">48<span class="presion-fact-arrow">→</span>40</p>
          <p class="presion-fact-txt">horas de jornada laboral semanal hacia 2030</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+26.6<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">acumulado en el salario mínimo en los últimos dos años</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+52<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">impacto acumulado en el costo laboral</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · EL ENGINE — pantalla completa, a dos columnas, usando todo el
       ancho de la ventana (referencia: las páginas anexas, no el
       contenedor centrado de 1080px que usan las demás secciones). La
       rueda es la única fuente de los nombres de servicio: no se repiten
       en una lista aparte. Titular al tamaño del hero (R5.8: el nombre
       del sistema nunca va como texto plano — el lockup de arriba ya lo
       muestra, el h2 solo continúa la frase). -->
  <section class="engine-split" id="engine">
    <div class="engine-col-text">
      <header class="section-head reveal">
        <p class="eyebrow eyebrow--lockup">
          <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" class="brand-lockup" />
        </p>
        <hr />
      </header>
      <!-- Instrucción explícita (pedido 2026-07-18: "el menú no es
           intuitivo, dejar claro al usuario que ahí es para elegir los
           servicios") — el lockup de arriba nombra el SISTEMA, no dice
           qué hacer con él. Esta línea sí lo dice. -->
      <p class="engine-h2 reveal">Elige el servicio que necesitas:</p>
      <!-- Menú de servicios (pedido 2026-07-15, referencia visual de
           lista de chips): al POSAR el puntero sobre un item, el gajo
           de ese servicio se activa y se mueve en la rueda — el mismo
           hover real (evento wheel-glow → activateHover, engine-wheel
           .js). El CLICK — aquí o en el gajo — navega a la página del
           servicio. Chips rectangulares con hairline: las pastillas
           redondeadas de la referencia violarían R3.3 (border-radius
           prohibido). -->
      <nav class="engine-menu reveal" aria-label="Servicios del Engine" data-engine-menu>
        {MENU_ITEMS.map((m) => (
          <a class="engine-menu-item" href={m.slug} data-edge={m.edge}>{m.label}</a>
        ))}
      </nav>
    </div>
    <div class="engine-col-wheel">
      <div class="wheel-card" id="wheel-entry">
        <EngineWheel fitHeight />
      </div>
    </div>
  </section>

  <!-- Banda azul de cierre (pedido 2026-07-19: "quiero que la última
       banda azul quede igual en todas las otras páginas pero que
       cambie de color dependiendo de dónde esté"): se movió a
       Base.astro/ClosingBand.astro — sale en TODAS las páginas, no
       solo aquí. Ver Base.astro. -->

  <script>
    import '../scripts/blue-edge-bg.js'; // efecto Blue Edge (código de referencia del cliente 2026-07-13) en las dos barras
  </script>

  <script>
    /* Transición hero → rueda ligada al scroll (lenguaje cosmos.so):
       el hero se eleva y desvanece; la rueda entra escalando y subiendo.
       Mapeo posicional directo (sin easing: el scroll ES la línea de tiempo). */
    function initCosmosScroll() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const hero = document.querySelector('.hero-inner') as HTMLElement | null;
      const card = document.getElementById('wheel-entry');
      if (!hero && !card) return;
      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight || 800;
        if (hero) {
          const p = Math.min(1, scrollY / (vh * 0.9));
          hero.style.transform = `translateY(${scrollY * 0.14}px)`;
          hero.style.opacity = String(1 - p * 0.4);
        }
        if (card) {
          const r = card.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
          card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.94 + p * 0.06})`;
          card.style.opacity = String(0.35 + p * 0.65);
        }
      }
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    initCosmosScroll();
    document.addEventListener('astro:page-load', initCosmosScroll);

    /* Menú de servicios (pedido 2026-07-15): posar el puntero sobre un
       item activa el gajo de su servicio en la rueda por el mismo
       camino del hover real (evento wheel-glow → activateHover en
       engine-wheel.js) — se levanta, brilla y se mueve igual que
       tocándolo. Al salir se apaga. El click es un <a> normal a la
       página del servicio. */
    function initEngineMenu() {
      const box = document.querySelector('[data-engine-menu]') as HTMLElement | null;
      if (!box || box.dataset.bound === '1') return;
      box.dataset.bound = '1';
      const glow = (id: string | null) => document.dispatchEvent(new CustomEvent('wheel-glow', { detail: id }));
      for (const item of box.querySelectorAll('a[data-edge]')) {
        item.addEventListener('pointerenter', () => glow((item as HTMLElement).dataset.edge ?? null));
        item.addEventListener('pointerleave', () => glow(null));
      }
    }
    initEngineMenu();
    document.addEventListener('astro:page-load', initEngineMenu);

    /* El atributo autoplay del <video> del hero solo actúa en la carga
       de DOCUMENTO: al regresar al home por navegación SPA (p. ej. click
       al logo del nav), el ClientRouter inserta un <video> nuevo en el
       swap y el navegador NO lo arranca solo — el hero quedaba congelado
       en el poster (bug reportado). play() explícito en cada
       astro:page-load; al ir muted, el navegador lo permite sin gesto.
       UN SOLO intento no basta (bug reportado por segunda vez ya con el
       play() puesto): en el swap el <video> recién insertado apenas está
       arrancando su carga, y un play() puede morir en la carrera con esa
       carga (AbortError "interrupted by a new load request") — el catch
       se lo tragaba en silencio y nada volvía a intentar. Por eso se
       insiste: al instante, cuando el video ya tiene datos (loadeddata)
       y dos reintentos con margen. Todos los intentos son idempotentes
       (si ya está corriendo, paused es false y no se hace nada), así que
       insistir nunca reinicia ni traba nada. */
    /* RECONSTRUCCIÓN en cada regreso SPA (astro:after-swap, que solo
       dispara en navegaciones internas, nunca en la carga inicial): en
       vez de intentar resucitar el <video> que insertó el swap — que en
       Chrome real puede llegar con el pipeline de medios en un estado
       del que ningún play() lo despega — se reemplaza por un clon
       superficial: mismos atributos (incluida la clase scoped de Astro,
       el poster y el src), pero con la máquina de estados de media
       recién nacida, y con muted fijado por PROPIEDAD antes de tocar el
       DOM. Video de fondo creado por JS = el patrón más confiable entre
       navegadores (Chrome y Safari incluidos). El playHeroVideo de abajo
       corre después (astro:page-load) y ya opera sobre el clon. */
    document.addEventListener('astro:after-swap', () => {
      const v = document.querySelector('.hero-video') as HTMLVideoElement | null;
      if (!v) return;
      const n = v.cloneNode(false) as HTMLVideoElement;
      n.muted = true;
      n.defaultMuted = true;
      v.replaceWith(n);
      /* blob precargado (window.__videoWarm, ver Base.astro): en el
         regreso SPA el clip arranca de memoria, sin volver a la red
         (fix 2026-07-15 — medido que el <video> jamás reutiliza la
         caché HTTP del prefetch). */
      const warm = (window as any).__videoWarm;
      const p = warm ? warm[n.getAttribute('src') || ''] : null;
      if (p) Promise.resolve(p).then((url) => {
        if (url && n.isConnected && n.currentTime < 0.3) { n.src = url; n.muted = true; n.play().catch(() => {}); }
      }).catch(() => {});
      n.play().catch(() => {});
    });

    /* Además de los reintentos con timer: vigilancia de 10s (cada 500ms
       hasta verlo avanzar de verdad — currentTime, no solo !paused) y un
       plan C de GESTO. Safari puede bloquear TODO autoplay — incluso
       muted — por ajuste del usuario ("Never Auto-Play") o Low Power
       Mode; ahí ningún reintento programático sirve y la única vía es
       arrancarlo dentro de un gesto real: el primer pointerdown/scroll/
       tecla del usuario. Los listeners de gesto son once+passive y solo
       viven mientras el video siga sin correr. */
    let heroWatch = 0;
    function playHeroVideo() {
      const v = document.querySelector('.hero-video');
      if (!v) return;
      /* v.muted por PROPIEDAD antes de cada intento: el atributo muted
         del markup fija el estado solo al crear el elemento, y hay
         motores donde un <video> insertado por el swap puede quedar con
         la propiedad en false — y un play() no-muted sin gesto se
         rechaza SIEMPRE (NotAllowedError). Reafirmarla es gratis. */
      const kick = () => { if (v.isConnected && v.paused) { v.muted = true; v.play().catch(() => {}); } };
      kick();
      v.addEventListener('loadeddata', kick, { once: true });
      clearInterval(heroWatch);
      const t0 = Date.now();
      let reloaded = false;
      heroWatch = setInterval(() => {
        if (!v.isConnected || v.currentTime > 0.2 || Date.now() - t0 > 10000) { clearInterval(heroWatch); return; }
        /* último recurso (una sola vez, a los ~3s): si tras varios
           play() el video sigue clavado en 0, el elemento quedó con la
           carga atascada tras el swap (estado real observable en Chrome
           con media elements re-insertados) — load() resetea el
           pipeline de medios completo y canplay dispara el play()
           definitivo. */
        if (!reloaded && Date.now() - t0 > 3000 && v.currentTime === 0) {
          reloaded = true;
          v.addEventListener('canplay', kick, { once: true });
          try { v.load(); } catch {}
          return;
        }
        kick();
      }, 500);
      const gesture = () => { kick(); };
      for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
        addEventListener(ev, gesture, { once: true, passive: true });
      }
    }
    playHeroVideo();
    document.addEventListener('astro:page-load', playHeroVideo);
  </script>
</Base>

<style>
  /* el hero mantiene su peso completo (logotipo, titular, párrafo, dos
     CTA) pero SIN el hueco muerto de ~150px que dejaba entre el nav y el
     primer texto — el contenido arranca inmediatamente bajo el nav. */
  /* fondo de video: cubre el hero entero, recortado sin distorsión
     (object-fit:cover) y siempre detrás del velo + el texto. */
  .hero {
    position: relative;
    padding: 48px 72px 64px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(100vh - 92px);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: saturate(1.5) brightness(1.08);
  }
  /* velo oscuro UNIFORME: garantiza contraste de texto sin importar el
     fotograma del video (pasa de campo claro al atardecer a foco
     encendido en azul) — el texto está centrado en TODA la pantalla,
     así que el oscurecimiento tiene que ser parejo, no solo detrás de
     un bloque de texto en una esquina. Opacidad reducida a la mitad
     (82% → 41%) para que el foco se vea más brillante. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--bg) 41%, transparent);
  }
  .hero-inner { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .hero-eyebrow { color: var(--fg); }
  .hero-eyebrow-prompt { color: var(--silver); }
  .hero-logo { width: min(220px, 55vw); height: auto; margin: 28px 0 24px; }
  /* plancha negra DETRÁS del logo para que resalte sobre el video
     (pedido explícito 2026-07-12, sobre todo el ">_" y el "[AI]"):
     logo-mono-light-plate.png es el MISMO mapa de alfa del logo con el
     RGB en negro — mismo lienzo de 1368×370 píxel a píxel — pero solo
     el cuerpo sólido de los glifos (smoothstep sobre el alfa 0.55→0.90,
     generado con PIL): el halo suave y el anti-alias del borde quedan
     SIN negro detrás, así el contorno se sigue fundiendo con el video y
     no se ve ningún borde negro alrededor (verificado: 0 píxeles de
     plancha fuera del cuerpo sólido, bbox contenida). Como background
     del MISMO <img> estirado a 100% 100%, la alineación es exacta por
     construcción: comparten caja y malla de píxeles, no hay dos
     elementos que puedan desfasarse ni redondeos distintos. No es una
     sombra (R3.2): es un asset horneado, como manda R5.4. */
  .hero-logo { background: url('/assets/logos/logo-mono-light-plate.png') center / 100% 100% no-repeat; }
  .hero-h1 {
    font-size: clamp(17px, 2.3vw, 32px);
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: var(--fg);
  }
  .hero-sub {
    margin-top: 24px;
    font-size: clamp(14px, 1.45vw, 19px);
    letter-spacing: -.025em;
    color: var(--fg);
  }
  /* franja "la presión" — mismo tratamiento full-bleed que .plate (placa
     final): fondo Edge Blue sólido, contenido acotado y centrado, texto
     en --on-accent (blanco) porque azul sobre azul no se leería. */
  .presion-band { position: relative; padding: 96px 72px; overflow: hidden;
    /* base oscura del efecto Blue Edge (deriva del accent; fallback void) */
    background: var(--void-deep);
    background: oklch(from var(--accent) calc(l * 0.28) calc(c * 0.7) h); }
  /* la estática vive detrás del contenido de ambas barras azules; los
     CTA de la placa siguen clickeables porque vienen después en el DOM */
  /* capas explícitas: decoración al fondo, sin puntero (ver hub-static) */
  /* el efecto Blue Edge pinta su propia base oscura — sin opacidad */
  .band-static { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .presion-inner { position: relative; z-index: 1;
    /* sombra ligera al texto blanco sobre el campo animado (pedido
       explícito 2026-07-13; excepción a R3.2 en brand/RULES.md) */
    text-shadow: /* brand-ok:R3.2 excepción 2026-07-13 en RULES.md (pedido explícito) */ 0 1px 2px color-mix(in srgb, var(--void-deep) 55%, transparent),
                 0 3px 14px color-mix(in srgb, var(--void-deep) 40%, transparent); }
  .presion-inner { max-width: 1180px; margin: 0 auto; }
  .presion-h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    /* mismo tamaño que el texto de las tarjetas de abajo (pedido
       2026-07-19) — var(--text-body), igual que .presion-fact-txt. */
    font-size: var(--text-body);
    letter-spacing: -.02em;
    color: var(--on-accent);
  }
  /* >_ con relieve 3D real (R5.4: "siempre los PNG horneados, relieve 3D
     intacto") — recorte exacto del símbolo de logo-mono-light.png, la
     variante plata aprobada para fondos accent/void. Nunca CSS
     box-shadow/text-shadow para simular volumen (R3.2 los prohíbe). La
     altura sigue el font-size del heading (em), así se mantiene a la
     altura de la "L" de "La" en cualquier tamaño de pantalla. */
  .presion-prompt-img { height: 0.78em; width: auto; display: block; }
  /* bloques con delimitación clara: misma retícula hairline que el
     resto del sitio (gap:1px + fondo de línea), adaptada a superficie
     accent — cada bloque es un rectángulo vertical con el número
     centrado arriba del texto, nunca a la izquierda. */
  /* pedido explícito: los cuadros SIN fondo sólido — la estática de la
     barra se ve a través de ellos. El hairline interior ya no puede
     venir del fondo del wrapper visto por el gap de 1px (sin relleno en
     las celdas se vería el wrapper completo, no una línea): las
     divisiones pasan a ser bordes de las propias celdas. */
  .presion-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 56px;
    border: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent);
  }
  .presion-fact + .presion-fact { border-inline-start: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent); }
  .presion-fact {
    position: relative;
    overflow: hidden;
    /* mismo tratamiento que las tarjetas de fase de creative (pedido
       2026-07-17): vidrio translúcido con luz superior en reposo… */
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--on-accent) 10%, transparent) 0%,
      color-mix(in srgb, var(--on-accent) 4%, transparent) 45%,
      color-mix(in srgb, var(--void-deep) 30%, transparent) 100%);
    backdrop-filter: blur(4px);
    padding: 40px 28px;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: transform var(--t-ui) var(--ease);
  }
  /* …y al encender: levantamiento sutil + relleno profundo del acento
     que sube desde abajo, tipografía en blanco intacta */
  .presion-fact::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--accent) 72%, var(--void-deep)) 0%,
      color-mix(in srgb, var(--accent) 38%, var(--void-deep)) 100%);
    transform: translateY(101%);
    transition: transform 340ms var(--ease);
  }
  .presion-fact:hover { transform: translateY(-4px); z-index: 2; }
  .presion-fact:hover::before { transform: translateY(0); }
  .presion-fact > * { position: relative; z-index: 1; }
  .presion-fact-num { font-size: clamp(28px, 3.2vw, 44px); font-weight: 600; letter-spacing: -.03em; color: var(--on-accent); white-space: nowrap; }
  .presion-fact-unit { font-size: 0.55em; }
  .presion-fact-arrow { display: inline-block; margin: 0 .2em; font-weight: 400; font-size: .7em; }
  .presion-fact-txt { margin-top: 16px; font-size: var(--text-body); line-height: 1.5; color: color-mix(in srgb, var(--on-accent) 78%, transparent); }

  /* El Engine — pantalla completa a dos columnas, ancho real de la
     ventana (no el contenedor de 1080px de .section), igual que las
     referencias: texto corto a la izquierda, gráfico dominante a la
     derecha, sangrado hacia el borde. La rueda se dimensiona a sí misma
     en engine-wheel.js para NUNCA exceder el alto disponible de esta
     fila — así siempre cabe entera en una sola pantalla. */
  .engine-split {
    display: grid;
    /* columna de texto 280→360 (antes 420): la rueda pidió +30% de
       tamaño explícito y a partir de ~900px de ancho de viewport ya no
       hay espacio de sobra — se le quita a la columna de texto (sigue
       siendo perfectamente legible a 360px, 2 líneas cortas) para
       dárselo a la rueda, que es la prioridad ("el objetivo es
       visibilidad"). */
    grid-template-columns: minmax(260px, 360px) 1fr;
    align-items: center;
    gap: 24px;
    /* un poco más de aire arriba que abajo — empuja el contenido
       ligeramente hacia abajo dentro de la sección, en vez de quedar
       pegado justo debajo del nav. */
    padding-top: 104px;
    padding-bottom: 72px;
    /* Antes esta sección alineaba su ancho de contenido (1180px) con
       .presion-inner, para que el borde derecho de la rueda coincidiera
