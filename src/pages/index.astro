---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../data/engine.js';
---
<Base>
  <!-- remate corto — no una pantalla completa de texto -->
  <section class="intro">
    <div class="intro-inner">
      <p class="eyebrow reveal">
        <span class="prompt">&gt;_</span>inicializando ventaja<span class="cursor">▌</span>
      </p>
      <h1 class="intro-h1 reveal">La IA ejecuta. La experiencia <span class="prompt">decide.</span></h1>
      <p class="intro-sub reveal">Haz más. Sin contratar más.</p>
      <div class="intro-cta reveal">
        <a class="btn" href="mailto:eric@finalupgrade.ai?subject=Reuni%C3%B3n%20de%20valoraci%C3%B3n%20%E2%80%94%20Final%20Edge">Agenda tu reunión de valoración</a>
      </div>
    </div>
  </section>

  <!-- la rueda: pieza ancla de la retícula -->
  <section class="wheel-band reveal">
    <EngineWheel />
  </section>

  <!-- retícula de piezas — cada una dice una cosa y enlaza a su página -->
  <section class="grid" aria-label="Explora Final Edge">
    {EDGES.map((e) => {
      const phase = phaseOfEdge(e);
      return (
        <a class="piece piece--edge" href={e.slug} style={`--pc:${phase.color}`} transition:name={`edge-${e.id}`}>
          <img class="piece-icon" src={e.icon} alt="" width="40" height="40" loading="lazy" />
          <LockupMark word={e.id} tag="[AI]" color={phase.color} variant="section" />
          <p class="piece-service">{e.service}</p>
          <p class="piece-hook">{e.hook}</p>
        </a>
      );
    })}

    <div class="piece piece--stat">
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>la presión</p>
      <p class="piece-stat-num">+30<span class="piece-stat-unit">%</span></p>
      <p class="piece-txt">de encarecimiento de nómina con la reforma de 40 horas. La IA es la respuesta directa.</p>
    </div>

    <div class="piece piece--stat" style="--pc:var(--phase-cap)">
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>el mercado</p>
      <p class="piece-stat-num">38<span class="piece-stat-unit">%</span> <span class="piece-stat-arrow">→</span> 3<span class="piece-stat-unit">%</span></p>
      <p class="piece-txt">usa inteligencia artificial hoy; a esa fracción es a la que le funciona.</p>
    </div>

    <div class="piece piece--text" id="nosotros">
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>nosotros</p>
      <p class="piece-txt">
        30 años de experiencia de negocio del lado del cliente dirigen la IA. Eric Toledano fue
        vicepresidente de marketing en Mondelez, PepsiCo y Bacardi-Martini, en siete países.
      </p>
    </div>

    <div class="piece piece--text" id="como-trabajamos">
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>cómo trabajamos</p>
      <p class="piece-txt">
        Sin la estructura pesada de una agencia. Talento internacional seleccionado por habilidad,
        armado a la medida de cada proyecto.
      </p>
    </div>

    <div class="piece piece--text" id="casos">
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>casos</p>
      <p class="piece-txt">
        Sports World México, Tiendas Chedraui, Kanguru Beverages, hoteles VLU, Growth Hub.
        Trabajo real, entregado a clientes reales.
      </p>
    </div>

    <a
      class="piece piece--cta"
      id="valoracion"
      href="mailto:eric@finalupgrade.ai?subject=Reuni%C3%B3n%20de%20valoraci%C3%B3n%20%E2%80%94%20Final%20Edge"
    >
      <p class="piece-eyebrow"><span class="prompt">&gt;_</span>valoración</p>
      <p class="piece-cta-txt">La competencia te entrega promedio. Final Edge te entrega la ventaja.</p>
      <p class="piece-cta-link">Agenda tu reunión →</p>
    </a>
  </section>

  <!-- placa Edge Blue (la ÚNICA placa full-bleed de acento) -->
  <section class="plate" aria-label="Tu ventaja final">
    <p class="plate-text">Tu ventaja final<span class="plate-dot">.</span></p>
  </section>
</Base>

<style>
  .intro { padding: 132px 72px 56px; }
  .intro-inner { max-width: 900px; margin: 0 auto; }
  .intro-h1 {
    margin-top: 20px;
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: var(--fg);
  }
  .intro-sub { margin-top: 16px; font-size: var(--text-subtitle); color: var(--fg-2); }
  .intro-cta { margin-top: 32px; }

  /* la rueda vive en su propia banda, a todo lo ancho del contenido —
     una pieza más de la retícula, la más grande */
  .wheel-band {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 72px 56px;
  }

  /* retícula masonry: columnas de alturas irregulares (CSS columns, no
     grid-row a ciegas) — cada pieza decide su propia altura por contenido */
  .grid {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 71px 120px;
    columns: 3 300px;
    column-gap: 1px;
    background: var(--hairline);
  }
  .piece {
    display: block;
    break-inside: avoid;
    margin-bottom: 1px;
    background: var(--bg);
    padding: 28px;
    color: inherit;
    transition: background var(--t-hover) var(--ease);
  }
  a.piece:hover { background: var(--panel); }

  .piece-eyebrow {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: var(--fg-faint);
  }
  .piece-txt { margin-top: 14px; font-size: 14px; line-height: 1.6; color: var(--fg-muted); }

  .piece--edge { border-top: 2px solid var(--pc); }
  .piece-icon { width: 40px; height: 40px; margin-bottom: 18px; }
  .piece--edge .lm { margin-top: 4px; }
  .piece-service { margin-top: 16px; font-size: var(--text-body); font-weight: 500; color: var(--fg); }
  .piece-hook { margin-top: 6px; font-size: 14px; color: var(--fg-muted); }

  .piece--stat { border-top: 2px solid var(--pc, var(--phase-eval)); }
  .piece-stat-num { margin-top: 16px; font-size: clamp(30px, 3.4vw, 42px); font-weight: 600; letter-spacing: -.03em; color: var(--fg); white-space: nowrap; }
  .piece-stat-unit { font-size: 0.55em; color: var(--fg-muted); }
  .piece-stat-arrow { color: var(--accent); font-weight: 400; font-size: 0.6em; }

  .piece--cta {
    border-top: 2px solid var(--accent);
    background: var(--panel);
  }
  .piece-cta-txt { margin-top: 14px; font-size: var(--text-subtitle); letter-spacing: -.015em; color: var(--fg); }
  .piece-cta-link { margin-top: 18px; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  a.piece--cta:hover { background: var(--accent); }
  a.piece--cta:hover .piece-cta-txt, a.piece--cta:hover .piece-cta-link, a.piece--cta:hover .piece-eyebrow { color: var(--on-accent); }

  .plate { background: var(--accent); padding: 120px 72px; overflow: hidden; }
  .plate-text {
    max-width: 1180px;
    margin: 0 auto;
    font-size: var(--text-plate);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .95;
    color: var(--on-accent);
  }
  .plate-dot { color: var(--void-deep); }

  @media (max-width: 760px) {
    .intro { padding: 112px 24px 40px; }
    .wheel-band { padding: 0 20px 40px; }
    .grid { padding: 0 19px 88px; columns: 1; }
    .plate { padding: 88px 24px; }
  }
</style>
