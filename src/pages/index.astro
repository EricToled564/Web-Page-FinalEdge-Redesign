---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
import { EDGES, phaseOfEdge } from '../data/engine.js';
---
<Base>
  <!-- 00 · HERO -->
  <section class="hero" id="inicio">
    <div class="hero-inner">
      <p class="eyebrow reveal">
        <span class="prompt">&gt;_</span>inicializando ventaja<span class="cursor">▌</span>
      </p>
      <img
        class="hero-logo reveal"
        src="/assets/logos/logo-finaledge.png"
        alt="final edge [AI]"
        width="300"
      />
      <h1 class="hero-h1 reveal">
        La IA ejecuta.<br />La experiencia <span class="prompt">decide.</span>
      </h1>
      <p class="hero-sub reveal">Haz más. Sin contratar más.</p>
      <p class="lead reveal">
        Final Edge es una firma potenciada por inteligencia artificial y dirigida por visión humana.
        La IA hace el trabajo pesado; la dirección la pone más de 30 años de experiencia de negocio
        del lado del cliente.
      </p>
      <div class="hero-cta reveal">
        <a class="btn" href="#valoracion">Agenda tu reunión de valoración</a>
        <a class="btn btn--ghost" href="#engine">Conoce el Final Edge Engine</a>
      </div>
    </div>
  </section>

  <!-- 01 · LA PRESIÓN -->
  <section class="section" id="presion">
    <header class="section-head reveal">
      <p class="section-num">01</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>la presión · 01 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Tus costos suben por ley. Tu productividad, no.</h2>
    <p class="lead reveal" style="margin-top:24px">
      La jornada de 40 horas ya es ley. El salario mínimo sube cada año. Y quizá ya probaste la
      inteligencia artificial sin que moviera una sola cifra. El problema no fue la herramienta:
      fue que nadie la dirigió hacia tu negocio.
    </p>
    <p class="stat-lede reveal">Tres cifras del mismo problema:</p>
    <div class="stat-row reveal">
      <div class="stat">
        <p class="stat-num">+30<span class="stat-unit">%</span></p>
        <p class="stat-txt">de encarecimiento de nómina con la reforma de 40 horas</p>
      </div>
      <div class="stat">
        <p class="stat-num">38<span class="stat-unit">%</span> <span class="stat-arrow">→</span> 3<span class="stat-unit">%</span></p>
        <p class="stat-txt">usa inteligencia artificial hoy; a esa fracción es a la que le funciona</p>
      </div>
      <div class="stat">
        <p class="stat-num">+20<span class="stat-unit">%</span></p>
        <p class="stat-txt">crece cada año el mercado de IA en México — sin que la mayoría lo capture</p>
      </div>
    </div>
  </section>

  <!-- 02 · LA DIFERENCIA -->
  <section class="section" id="diferencia">
    <header class="section-head reveal">
      <p class="section-num">02</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>la diferencia · 02 / 07</p>
      <hr />
    </header>
    <div class="diff-mark reveal">
      <img src="/assets/logos/logo-finaledge.png" alt="final edge [AI]" width="520" height="140" />
    </div>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div>
        <p class="eyebrow" style="margin-bottom:16px"><span class="prompt">&gt;_</span>frente a agencias y consultoras</p>
        <p class="body-2">
          Ejecutamos con IA a una fracción del tiempo y del costo: lo que ellas hacen a mano en
          semanas, aquí ocurre en horas.
        </p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:16px"><span class="prompt">&gt;_</span>frente a proveedores técnicos</p>
        <p class="body-2">
          Dirigimos con 30 años de experiencia del lado del cliente, decidiendo qué mueve tu margen.
          No vendemos experimentos: entregamos resultados.
        </p>
      </div>
    </div>
  </section>

  <!-- 03 · EL ENGINE — pantalla A: encabezado + rueda (sola, sin el grid
       de servicios apilado debajo: eso es lo que hacía de esta sección la
       más larga del sitio, casi 2.5 pantallas) -->
  <section class="section section--engine" id="engine">
    <header class="section-head reveal">
      <p class="section-num">03</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>el Final Edge Engine · 03 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Un sistema, no una lista de servicios.</h2>
    <p class="body-2 reveal" style="margin-top:12px; max-width:62ch">
      Tres fases que te llevan de «no sé por dónde empezar» a tener el Final Edge Engine operando
      tu negocio. Toca una fase para entrar a su hub, o un edge para ir directo al servicio.
    </p>

    <div class="wheel-card" id="wheel-entry" style="margin-top:24px">
      <EngineWheel />
    </div>
  </section>

  <!-- 03 · EL ENGINE — pantalla B: los 6 servicios, en su propia pantalla
       (continuación de 03, no una sección numerada nueva) -->
  <section class="section section--services">
    <p class="eyebrow reveal"><span class="prompt">&gt;_</span>los seis edges del Final Edge Engine</p>
    <div class="hairline-grid grid-3 reveal edge-grid">
      {EDGES.map((e) => {
        const phase = phaseOfEdge(e);
        return (
          <a class="edge-card" href={e.slug} style={`--pc:${phase.color}`} transition:name={`edge-${e.id}`}>
            <img class="edge-card-icon" src={e.icon} alt="" width="36" height="36" loading="lazy" />
            <LockupMark word={e.id} tag="[AI]" color={phase.color} variant="section" />
            <p class="edge-card-service">{e.service}</p>
            <p class="edge-card-hook">{e.hook}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 04 · CÓMO TRABAJAMOS -->
  <section class="section" id="como-trabajamos">
    <header class="section-head reveal">
      <p class="section-num">04</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>cómo trabajamos · 04 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">El mejor talento del mundo, reunido para tu proyecto.</h2>
    <p class="lead reveal" style="margin-top:24px">
      Sin el peso ni el costo fijo de una agencia tradicional. Para cada reto armamos un equipo a la
      medida con talento internacional, evaluado y seleccionado por habilidad, formado con la
      metodología de nuestra firma afiliada en Singapur, Final Upgrade AI.
    </p>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div><p class="body-2"><span class="prompt">&gt;_</span> Sin la estructura pesada de una agencia: mejor precio y mayor velocidad, sin sacrificar el nivel.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Dirigidos por negocio: la dirección la pone la experiencia del lado del cliente, no un equipo puramente técnico.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Talento seleccionado por habilidad, no por cercanía, con calidad consistente en cada reto.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> A la medida de México cuando se necesita: español nativo y manejo de datos conforme a la ley mexicana.</p></div>
    </div>
  </section>

  <!-- 05 · NOSOTROS -->
  <section class="section" id="nosotros">
    <header class="section-head reveal">
      <p class="section-num">05</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>nosotros · 05 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">30 años del lado del cliente. La experiencia que dirige la IA.</h2>
    <p class="lead reveal" style="margin-top:24px">
      La diferencia no es el modelo de inteligencia artificial: es quién lo dirige. Eric Toledano
      suma más de 30 años de experiencia de negocio del lado del cliente: liderazgo comercial de
      alto nivel, como vicepresidente de marketing y director de marketing, en marcas globales de
      consumo y bebidas —Mondelez, PepsiCo y Bacardi-Martini— en siete países de cuatro continentes.
      Es la experiencia de quien contrataba y dirigía agencias y tecnología, no de quien las vende.
    </p>
  </section>

  <!-- 06 · CASOS -->
  <section class="section" id="casos">
    <header class="section-head reveal">
      <p class="section-num">06</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>casos · 06 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Trabajo real, entregado a clientes reales.</h2>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>investigación y datos</p>
        <p class="body-2">La auditoría de posicionamiento en buscadores de <strong>Sports World México</strong> y el comparativo de precios de los <strong>hoteles VLU</strong>.</p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>estrategia</p>
        <p class="body-2">El marco estratégico para una <strong>tienda de mascotas en Hong Kong</strong> y el estudio para inversionistas de una <strong>empresa de infraestructura espacial en los Emiratos</strong>.</p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>sistemas</p>
        <p class="body-2">El tablero financiero de <strong>Kanguru Beverages</strong>, la inteligencia de inventarios de <strong>Tiendas Chedraui</strong> y el sistema comercial <strong>Growth Hub</strong>.</p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>producción creativa</p>
        <p class="body-2">Las campañas audiovisuales de <strong>Sports World México</strong>.</p>
      </div>
    </div>
  </section>

  <!-- 07 · VALORACIÓN -->
  <section class="section" id="valoracion">
    <header class="section-head reveal">
      <p class="section-num">07</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>valoración · 07 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">La competencia te entrega promedio. Final Edge te entrega la ventaja.</h2>
    <p class="body-2 reveal" style="margin-top:16px; max-width:62ch">
      Empieza por una reunión de valoración: en una conversación corta entenderás dónde la
      inteligencia artificial puede mover tu margen y por dónde empezar. Sin compromiso.
    </p>
    <ol class="val-steps reveal">
      <li><span class="prompt">01</span> Responde unas preguntas rápidas: el contexto de tu empresa y tu reto, para que la reunión sea valiosa desde el primer minuto.</li>
      <li><span class="prompt">02</span> Elige tu horario: la reservación queda confirmada dentro de nuestro propio sistema.</li>
      <li><span class="prompt">03</span> ¿Dudas en el camino? Nuestro asistente de inteligencia artificial te acompaña y te ayuda a agendar.</li>
    </ol>
    <a
      class="btn reveal"
      href="mailto:eric@finalupgrade.ai?subject=Reuni%C3%B3n%20de%20valoraci%C3%B3n%20%E2%80%94%20Final%20Edge"
      style="margin-top:18px"
    >Agendar mi reunión</a>
  </section>

  <!-- placa Edge Blue (la ÚNICA placa full-bleed de acento) -->
  <section class="plate" aria-label="Tu ventaja final">
    <p class="plate-text">Tu ventaja final<span class="plate-dot">.</span></p>
  </section>

  <script>
    /* Transición hero → rueda ligada al scroll (lenguaje cosmos.so):
       el hero se eleva y desvanece; la rueda entra escalando y subiendo.
       Mapeo posicional directo (sin easing: el scroll ES la línea de tiempo). */
    function initCosmosScroll() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const hero = document.querySelector('.hero-inner') as HTMLElement | null;
      const card = document.getElementById('wheel-entry');
      if (!hero && !card) return;
      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight || 800;
        if (hero) {
          const p = Math.min(1, scrollY / (vh * 0.9));
          hero.style.transform = `translateY(${scrollY * 0.14}px)`;
          hero.style.opacity = String(1 - p * 0.4);
        }
        if (card) {
          const r = card.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
          card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.94 + p * 0.06})`;
          card.style.opacity = String(0.35 + p * 0.65);
        }
      }
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    initCosmosScroll();
    document.addEventListener('astro:page-load', initCosmosScroll);
  </script>
</Base>

<style>
  /* el hero mantiene su peso completo (logotipo, titular, párrafo, dos
     CTA) pero SIN el hueco muerto de ~150px que dejaba entre el nav y el
     primer texto — el contenido arranca inmediatamente bajo el nav. */
  .hero { padding: 48px 72px 64px; }
  .hero-inner { max-width: 900px; margin: 0 auto; }
  .hero-logo { width: min(220px, 55vw); height: auto; margin: 28px 0 24px; }
  .hero-h1 {
    font-size: clamp(40px, 6vw, 88px);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .96;
    color: var(--fg);
  }
  .hero-sub {
    margin-top: 24px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .hero .lead { margin-top: 20px; max-width: 62ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 40px; }

  /* la fila de cifras se lee como UN argumento: mismo tratamiento tipográfico,
     una línea que las presenta como facetas del mismo problema */
  .stat-lede {
    margin-top: 32px;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--fg-faint);
  }
  .stat-row {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .stat { background: var(--bg); padding: 20px; }
  .stat-num { font-size: clamp(32px, 3.6vw, 48px); font-weight: 600; letter-spacing: -.035em; color: var(--fg); white-space: nowrap; }
  .stat-unit { font-size: 0.55em; color: var(--fg-muted); }
  .stat-arrow { color: var(--accent); font-weight: 400; }
  .stat-txt { margin-top: 12px; font-size: 14px; color: var(--fg-muted); }
  .body-2 { color: var(--fg-2); font-size: var(--text-body); }

  .diff-mark { width: min(520px, 100%); }
  .diff-mark img { width: 100%; height: auto; display: block; }

  /* la sección Engine arranca con menos aire arriba y abajo para que el
     encabezado y la rueda se sientan en la misma pantalla */
  .section--engine { padding-top: 40px; padding-bottom: 40px; }
  .section--services { padding-top: 40px; }
  @media (max-width: 760px) {
    .section--engine { padding-top: 32px; padding-bottom: 32px; }
    .section--services { padding-top: 32px; }
  }

  /* tarjetas de servicio — pantalla propia, acceso directo, sin duplicar
     lo que la rueda ya navega por fase */
  .edge-grid { margin-top: 28px; }
  .edge-card { display: grid; gap: 10px; align-content: start; padding: 20px; color: inherit; border-top: 2px solid var(--pc); background: var(--bg); transition: background var(--t-hover) var(--ease); }
  /* en móvil, 2 columnas en vez de 1: cada tarjeta es corta (ícono +
     lockup + 2 líneas), apilar las 6 en una sola columna era lo que
     hacía esta pantalla casi el doble de alta de lo necesario */
  @media (max-width: 760px) {
    .edge-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  }
  .edge-card:hover { background: var(--panel); }
  .edge-card-icon { width: 36px; height: 36px; }
  .edge-card .lm { width: 150px; }
  .edge-card-service { margin-top: 6px; font-size: var(--text-body); font-weight: 500; color: var(--fg); }
  .edge-card-hook { font-size: 14px; color: var(--fg-muted); }

  .val-steps { list-style: none; margin-top: 28px; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .val-steps li { background: var(--bg); padding: 16px 20px; color: var(--fg-2); display: flex; gap: 18px; font-size: var(--text-body); }

  .plate {
    background: var(--accent);
    padding: 120px 72px;
    overflow: hidden;
  }
  .plate-text {
    max-width: 1180px;
    margin: 0 auto;
    font-size: var(--text-plate);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .95;
    color: var(--on-accent);
  }
  .plate-dot { color: var(--void-deep); }

  @media (max-width: 760px) {
    .hero { padding: 32px 24px 48px; }
    .plate { padding: 88px 24px; }
  }
</style>
