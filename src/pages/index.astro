---
import Base from '../layouts/Base.astro';
---
<Base>
  <!-- placa Edge Blue — única sección de la página principal. Texto
       centrado en la misma cuadrícula de 1180px que usa "la presión"
       (max-width:1180 + margin:auto), con la tipografía (letter-spacing
       y line-height) del h1 del hero y un relieve 3D vía gradiente —
       nunca box-shadow/text-shadow, prohibidos por R3.2. -->
  <section class="plate" aria-label="Tu ventaja final">
    <p class="plate-text">Tu ventaja final<span class="plate-dot">.</span></p>
  </section>
</Base>

<style>
  .plate {
    background: var(--accent);
    padding: 120px 72px;
    overflow: hidden;
    min-height: calc(100vh - 92px);
    display: flex;
    align-items: center;
  }
  .plate-text {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
    font-size: var(--text-plate);
    font-weight: 600;
    /* letter-spacing y line-height del h1 del hero — el tamaño se
       queda en --text-plate, no en el clamp del hero. */
    letter-spacing: -.03em;
    line-height: 1.08;
    /* relieve 3D via gradiente (claro arriba, gris abajo), no sombra:
       R3.2 prohibe box-shadow, text-shadow y drop-shadow. Ambos
       colores son tokens existentes (R1.1). */
    background: linear-gradient(180deg, var(--on-accent) 0%, var(--fg-2) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .plate-dot {
    background: var(--void-deep);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  @media (max-width: 760px) {
    .plate { padding: 88px 24px; }
  }
</style>
