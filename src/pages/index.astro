---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
---
<Base>
  <!-- 00 · HERO -->
  <section class="hero" id="inicio">
    <div class="hero-inner">
      <p class="eyebrow reveal">
        <span class="prompt">&gt;_</span>inicializando ventaja<span class="cursor">▌</span>
      </p>
      <img
        class="hero-logo reveal"
        src="/assets/logos/logo-finaledge.png"
        alt="final edge [AI]"
        width="300"
      />
      <h1 class="hero-h1 reveal">
        La IA ejecuta.<br />La experiencia <span class="prompt">decide.</span>
      </h1>
      <p class="hero-sub reveal">Haz más. Sin contratar más.</p>
      <p class="lead reveal">Dirigida por más de 30 años de experiencia de negocio del lado del cliente.</p>
      <div class="hero-cta reveal">
        <a class="btn" href="#valoracion">Agenda tu reunión de valoración</a>
        <a class="btn btn--ghost" href="#engine">Descubre el sistema completo</a>
      </div>
    </div>
  </section>

  <!-- 01 · LA PRESIÓN -->
  <section class="section" id="presion">
    <header class="section-head reveal">
      <p class="section-num">01</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>la presión · 01 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Tus costos suben por ley. Tu productividad, no.</h2>
    <p class="lead reveal" style="margin-top:16px">La IA sin dirección no mueve el margen.</p>
    <p class="stat-lede reveal">Tres cifras del mismo problema:</p>
    <div class="stat-row reveal">
      <div class="stat">
        <p class="stat-num">+30<span class="stat-unit">%</span></p>
        <p class="stat-txt">de encarecimiento de nómina con la reforma de 40 horas</p>
      </div>
      <div class="stat">
        <p class="stat-num">38<span class="stat-unit">%</span> <span class="stat-arrow">→</span> 3<span class="stat-unit">%</span></p>
        <p class="stat-txt">usa inteligencia artificial hoy; a esa fracción es a la que le funciona</p>
      </div>
      <div class="stat">
        <p class="stat-num">+20<span class="stat-unit">%</span></p>
        <p class="stat-txt">crece cada año el mercado de IA en México — sin que la mayoría lo capture</p>
      </div>
    </div>
  </section>

  <!-- 02 · LA DIFERENCIA -->
  <section class="section" id="diferencia">
    <header class="section-head reveal">
      <p class="section-num">02</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>la diferencia · 02 / 07</p>
      <hr />
    </header>
    <div class="diff-mark reveal">
      <img src="/assets/logos/logo-finaledge.png" alt="final edge [AI]" width="520" height="140" />
    </div>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div>
        <p class="eyebrow" style="margin-bottom:16px"><span class="prompt">&gt;_</span>frente a agencias y consultoras</p>
        <p class="body-2">Lo que ellas hacen en semanas, aquí ocurre en horas.</p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:16px"><span class="prompt">&gt;_</span>frente a proveedores técnicos</p>
        <p class="body-2">No vendemos experimentos: entregamos resultados.</p>
      </div>
    </div>
  </section>

  <!-- 03 · EL ENGINE — pantalla completa, a dos columnas, usando todo el
       ancho de la ventana (referencia: las páginas anexas, no el
       contenedor centrado de 1080px que usan las demás secciones). La
       rueda es la única fuente de los nombres de servicio: no se repiten
       en una lista aparte. -->
  <section class="engine-split" id="engine">
    <div class="engine-col-text">
      <header class="section-head reveal">
        <p class="section-num">03</p>
        <p class="eyebrow eyebrow--lockup">
          <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" />
        </p>
        <hr />
      </header>
      <h2 class="h2 reveal">Un sistema, no una lista de&nbsp;servicios.</h2>
      <p class="body-2 reveal" style="margin-top:12px">Tres fases, seis servicios, un solo sistema.</p>
    </div>
    <div class="engine-col-wheel">
      <div class="wheel-card" id="wheel-entry">
        <EngineWheel fitHeight />
      </div>
    </div>
  </section>

  <!-- 04 · CÓMO TRABAJAMOS -->
  <section class="section" id="como-trabajamos">
    <header class="section-head reveal">
      <p class="section-num">04</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>cómo trabajamos · 04 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">El mejor talento del mundo, reunido para tu proyecto.</h2>
    <p class="lead reveal" style="margin-top:16px">Un equipo a la medida. Sin el costo fijo de una agencia.</p>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div><p class="body-2"><span class="prompt">&gt;_</span> Menor costo y mayor velocidad que una agencia tradicional.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Dirigidos por negocio: decide la experiencia, no solo la tecnología.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Talento elegido por habilidad, no por cercanía.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Español nativo, conforme a la ley mexicana de datos.</p></div>
    </div>
  </section>

  <!-- 05 · NOSOTROS -->
  <section class="section" id="nosotros">
    <header class="section-head reveal">
      <p class="section-num">05</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>nosotros · 05 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">30 años del lado del cliente. La experiencia que dirige la IA.</h2>
    <p class="lead reveal" style="margin-top:16px">
      La diferencia no es el modelo de IA: es quién lo dirige.
    </p>
    <div class="stat-row reveal" style="margin-top:32px">
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(28px,3vw,40px)">+30<span class="stat-unit">años</span></p>
        <p class="stat-txt">de negocio del lado del cliente — Eric Toledano</p>
      </div>
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(20px,2.2vw,28px); white-space:normal">Mondelez · PepsiCo · Bacardi-Martini</p>
        <p class="stat-txt">VP y director de marketing en marcas globales</p>
      </div>
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(28px,3vw,40px)">7 <span class="stat-unit">países</span></p>
        <p class="stat-txt">en cuatro continentes — dirigiendo agencias y tecnología, no vendiéndolas</p>
      </div>
    </div>
  </section>

  <!-- 06 · CASOS -->
  <section class="section" id="casos">
    <header class="section-head reveal">
      <p class="section-num">06</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>casos · 06 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Trabajo real, entregado a clientes reales.</h2>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>investigación y datos</p>
        <p class="body-2"><strong>Sports World México</strong> · <strong>hoteles VLU</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>estrategia</p>
        <p class="body-2">Tienda de mascotas en <strong>Hong Kong</strong> · infraestructura espacial en <strong>Emiratos</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>sistemas</p>
        <p class="body-2"><strong>Kanguru Beverages</strong> · <strong>Chedraui</strong> · <strong>Growth Hub</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>producción creativa</p>
        <p class="body-2">Campañas audiovisuales de <strong>Sports World México</strong></p>
      </div>
    </div>
  </section>

  <!-- 07 · VALORACIÓN -->
  <section class="section" id="valoracion">
    <header class="section-head reveal">
      <p class="section-num">07</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>valoración · 07 / 07</p>
      <hr />
    </header>
    <h2 class="h2 reveal">La competencia te entrega promedio. Final Edge te entrega la ventaja.</h2>
    <p class="body-2 reveal" style="margin-top:16px">Una conversación corta. Sin compromiso.</p>
    <ol class="val-steps reveal">
      <li><span class="prompt">01</span> Responde unas preguntas rápidas sobre tu negocio.</li>
      <li><span class="prompt">02</span> Elige tu horario.</li>
      <li><span class="prompt">03</span> Resuelve tus dudas con nuestro asistente de IA.</li>
    </ol>
    <a
      class="btn reveal"
      href="mailto:eric@finalupgrade.ai?subject=Reuni%C3%B3n%20de%20valoraci%C3%B3n%20%E2%80%94%20Final%20Edge"
      style="margin-top:18px"
    >Agendar mi reunión</a>
  </section>

  <!-- placa Edge Blue (la ÚNICA placa full-bleed de acento) -->
  <section class="plate" aria-label="Tu ventaja final">
    <p class="plate-text">Tu ventaja final<span class="plate-dot">.</span></p>
  </section>

  <script>
    /* Transición hero → rueda ligada al scroll (lenguaje cosmos.so):
       el hero se eleva y desvanece; la rueda entra escalando y subiendo.
       Mapeo posicional directo (sin easing: el scroll ES la línea de tiempo). */
    function initCosmosScroll() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const hero = document.querySelector('.hero-inner') as HTMLElement | null;
      const card = document.getElementById('wheel-entry');
      if (!hero && !card) return;
      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight || 800;
        if (hero) {
          const p = Math.min(1, scrollY / (vh * 0.9));
          hero.style.transform = `translateY(${scrollY * 0.14}px)`;
          hero.style.opacity = String(1 - p * 0.4);
        }
        if (card) {
          const r = card.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
          card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.94 + p * 0.06})`;
          card.style.opacity = String(0.35 + p * 0.65);
        }
      }
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    initCosmosScroll();
    document.addEventListener('astro:page-load', initCosmosScroll);
  </script>
</Base>

<style>
  /* el hero mantiene su peso completo (logotipo, titular, párrafo, dos
     CTA) pero SIN el hueco muerto de ~150px que dejaba entre el nav y el
     primer texto — el contenido arranca inmediatamente bajo el nav. */
  .hero { padding: 48px 72px 64px; }
  .hero-inner { max-width: 900px; margin: 0 auto; }
  .hero-logo { width: min(220px, 55vw); height: auto; margin: 28px 0 24px; }
  .hero-h1 {
    font-size: clamp(40px, 6vw, 88px);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .96;
    color: var(--fg);
  }
  .hero-sub {
    margin-top: 24px;
    font-size: var(--text-manifesto);
    letter-spacing: -.025em;
    color: var(--fg-2);
  }
  .hero .lead { margin-top: 20px; max-width: 62ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 40px; }

  /* la fila de cifras se lee como UN argumento: mismo tratamiento tipográfico,
     una línea que las presenta como facetas del mismo problema */
  .stat-lede {
    margin-top: 32px;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--fg-faint);
  }
  .stat-row {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .stat { background: var(--bg); padding: 20px; }
  .stat-num { font-size: clamp(32px, 3.6vw, 48px); font-weight: 600; letter-spacing: -.035em; color: var(--fg); white-space: nowrap; }
  .stat-unit { font-size: 0.55em; color: var(--fg-muted); }
  .stat-arrow { color: var(--accent); font-weight: 400; }
  .stat-txt { margin-top: 12px; font-size: 14px; color: var(--fg-muted); }
  .body-2 { color: var(--fg-2); font-size: var(--text-body); }

  .diff-mark { width: min(520px, 100%); }
  .diff-mark img { width: 100%; height: auto; display: block; }

  /* El Engine — pantalla completa a dos columnas, ancho real de la
     ventana (no el contenedor de 1080px de .section), igual que las
     referencias: texto corto a la izquierda, gráfico dominante a la
     derecha, sangrado hacia el borde. La rueda se dimensiona a sí misma
     en engine-wheel.js para NUNCA exceder el alto disponible de esta
     fila — así siempre cabe entera en una sola pantalla. */
  .engine-split {
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    align-items: center;
    gap: 24px;
    padding: 16px 72px 16px 72px;
    min-height: calc(100vh - 92px);
    /* mucho más ancho que el contenedor de 1080px de las demás
       secciones (así se diferencia y la rueda tiene espacio real para
       dominar), pero SIGUE acotado y centrado — sin este tope, en
       pantallas anchas el texto quedaba pegado al margen izquierdo del
       nav mientras la rueda (limitada por el alto disponible, no por el
       ancho) flotaba lejos a la derecha con un vacío enorme en medio. */
    max-width: 1800px;
    margin: 0 auto;
  }
  .engine-col-text { padding-right: 24px; }
  .engine-col-wheel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    min-height: 0;
    min-width: 0;
    padding: 8px 16px 8px 0;
  }
  /* dentro del split, la rueda flota libre — sin el marco de "tarjeta"
     (borde + fondo + padding) que usa en otras páginas: en las
     referencias el gráfico sangra al borde, no vive dentro de una caja */
  .engine-col-wheel .wheel-card {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    border: none;
    background: transparent;
    padding: 0;
  }
  @media (max-width: 900px) {
    .engine-split {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 56px 24px;
      gap: 32px;
    }
    .engine-col-text { padding-right: 0; }
    .engine-col-wheel { justify-content: center; padding: 0; height: auto; }
  }

  .val-steps { list-style: none; margin-top: 28px; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .val-steps li { background: var(--bg); padding: 16px 20px; color: var(--fg-2); display: flex; gap: 18px; font-size: var(--text-body); }

  .plate {
    background: var(--accent);
    padding: 120px 72px;
    overflow: hidden;
  }
  .plate-text {
    max-width: 1180px;
    margin: 0 auto;
    font-size: var(--text-plate);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .95;
    color: var(--on-accent);
  }
  .plate-dot { color: var(--void-deep); }

  @media (max-width: 760px) {
    .hero { padding: 32px 24px 48px; }
    .plate { padding: 88px 24px; }
  }
</style>
