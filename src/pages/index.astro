---
import Base from '../layouts/Base.astro';
import EngineWheel from '../components/EngineWheel.astro';
import LockupMark from '../components/LockupMark.astro';
---
<Base>
  <!-- 00 · HERO — video de fondo (fotograma clave: filamento del foco en
       forma de cerebro, se enciende en azul acento — misma paleta que
       la marca) con velo oscuro para garantizar contraste con el texto,
       texto centrado en toda la pantalla. -->
  <section class="hero" id="inicio">
    <video
      class="hero-video"
      src="/assets/video/hero-bg.mp4"
      poster="/assets/video/hero-bg-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    ></video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow hero-eyebrow reveal">
        <span class="prompt hero-eyebrow-prompt">&gt;_</span> Tu próxima ventaja competitiva<span class="cursor">▌</span>
      </p>
      <img
        class="hero-logo reveal"
        src="/assets/logos/logo-mono-light.png"
        alt="final edge [AI]"
        width="300"
      />
      <h1 class="hero-h1 reveal">
        30 años de experiencia dirigen.<br />Nuestros flujos de trabajo propietarios de IA ejecutan.
      </h1>
      <p class="hero-sub reveal">Haz más. Sin contratar más.</p>
    </div>
  </section>

  <!-- 01 · LA PRESIÓN — franja Edge Blue full-bleed, mismo tratamiento
       que la placa final ("Tu ventaja final"): sin número de sección,
       solo el heading y las tres cifras. El >_ hereda el font-size del
       heading (mismo elemento), así queda exactamente a la altura de
       la "L" de "La", nunca más chico. -->
  <section class="presion-band" id="presion">
    <div class="presion-inner">
      <p class="presion-h2 reveal">
        <img class="presion-prompt-img" src="/assets/logos/symbol-prompt-silver.png" alt="" width="260" height="200" />
        La Presión
      </p>
      <div class="presion-facts reveal">
        <div class="presion-fact">
          <p class="presion-fact-num">48<span class="presion-fact-arrow">→</span>40</p>
          <p class="presion-fact-txt">horas de jornada laboral semanal hacia 2030</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+26.6<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">acumulado en el salario mínimo en los últimos dos años</p>
        </div>
        <div class="presion-fact">
          <p class="presion-fact-num">+52<span class="presion-fact-unit">%</span></p>
          <p class="presion-fact-txt">impacto acumulado en el costo laboral</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · EL ENGINE — pantalla completa, a dos columnas, usando todo el
       ancho de la ventana (referencia: las páginas anexas, no el
       contenedor centrado de 1080px que usan las demás secciones). La
       rueda es la única fuente de los nombres de servicio: no se repiten
       en una lista aparte. Titular al tamaño del hero (R5.8: el nombre
       del sistema nunca va como texto plano — el lockup de arriba ya lo
       muestra, el h2 solo continúa la frase). -->
  <section class="engine-split" id="engine">
    <div class="engine-col-text">
      <header class="section-head reveal">
        <p class="eyebrow eyebrow--lockup engine-lockup">
          <LockupMark word="final edge" tag="[ENGINE]" variant="wheel" />
        </p>
        <hr />
      </header>
      <h2 class="h2 engine-h2 reveal">El sistema que potencializa tu productividad y la convierte en una ventaja competitiva.</h2>
    </div>
    <div class="engine-col-wheel">
      <div class="wheel-card" id="wheel-entry">
        <EngineWheel fitHeight />
      </div>
    </div>
  </section>

  <!-- 03 · CÓMO TRABAJAMOS -->
  <section class="section" id="como-trabajamos">
    <header class="section-head reveal">
      <p class="section-num">03</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>cómo trabajamos · 03 / 06</p>
      <hr />
    </header>
    <h2 class="h2 reveal">El mejor talento del mundo, reunido para tu proyecto.</h2>
    <p class="lead reveal" style="margin-top:16px">Un equipo a la medida. Sin el costo fijo de una agencia.</p>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div><p class="body-2"><span class="prompt">&gt;_</span> Menor costo y mayor velocidad que una agencia tradicional.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Dirigidos por negocio: decide la experiencia, no solo la tecnología.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Talento elegido por habilidad, no por cercanía.</p></div>
      <div><p class="body-2"><span class="prompt">&gt;_</span> Español nativo, conforme a la ley mexicana de datos.</p></div>
    </div>
  </section>

  <!-- 05 · NOSOTROS -->
  <section class="section" id="nosotros">
    <header class="section-head reveal">
      <p class="section-num">04</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>nosotros · 04 / 06</p>
      <hr />
    </header>
    <h2 class="h2 reveal">30 años del lado del cliente. La experiencia que dirige la IA.</h2>
    <p class="lead reveal" style="margin-top:16px">
      La diferencia no es el modelo de IA: es quién lo dirige.
    </p>
    <div class="stat-row reveal" style="margin-top:32px">
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(28px,3vw,40px)">+30<span class="stat-unit">años</span></p>
        <p class="stat-txt">de negocio del lado del cliente — Eric Toledano</p>
      </div>
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(20px,2.2vw,28px); white-space:normal">Mondelez · PepsiCo · Bacardi-Martini</p>
        <p class="stat-txt">VP y director de marketing en marcas globales</p>
      </div>
      <div class="stat">
        <p class="stat-num" style="font-size:clamp(28px,3vw,40px)">7 <span class="stat-unit">países</span></p>
        <p class="stat-txt">en cuatro continentes — dirigiendo agencias y tecnología, no vendiéndolas</p>
      </div>
    </div>
  </section>

  <!-- 06 · CASOS -->
  <section class="section" id="casos">
    <header class="section-head reveal">
      <p class="section-num">05</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>casos · 05 / 06</p>
      <hr />
    </header>
    <h2 class="h2 reveal">Trabajo real, entregado a clientes reales.</h2>
    <div class="hairline-grid grid-2 reveal" style="margin-top:32px">
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>investigación y datos</p>
        <p class="body-2"><strong>Sports World México</strong> · <strong>hoteles VLU</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>estrategia</p>
        <p class="body-2">Tienda de mascotas en <strong>Hong Kong</strong> · infraestructura espacial en <strong>Emiratos</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>sistemas</p>
        <p class="body-2"><strong>Kanguru Beverages</strong> · <strong>Chedraui</strong> · <strong>Growth Hub</strong></p>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:14px"><span class="prompt">&gt;_</span>producción creativa</p>
        <p class="body-2">Campañas audiovisuales de <strong>Sports World México</strong></p>
      </div>
    </div>
  </section>

  <!-- 07 · VALORACIÓN -->
  <section class="section" id="valoracion">
    <header class="section-head reveal">
      <p class="section-num">06</p>
      <p class="eyebrow"><span class="prompt">&gt;_</span>valoración · 06 / 06</p>
      <hr />
    </header>
    <h2 class="h2 reveal">La competencia te entrega promedio. Final Edge te entrega la ventaja.</h2>
    <p class="body-2 reveal" style="margin-top:16px">Una conversación corta. Sin compromiso.</p>
    <ol class="val-steps reveal">
      <li><span class="prompt">01</span> Responde unas preguntas rápidas sobre tu negocio.</li>
      <li><span class="prompt">02</span> Elige tu horario.</li>
      <li><span class="prompt">03</span> Resuelve tus dudas con nuestro asistente de IA.</li>
    </ol>
    <a
      class="btn reveal"
      href="mailto:eric@finalupgrade.ai?subject=Reuni%C3%B3n%20de%20valoraci%C3%B3n%20%E2%80%94%20Final%20Edge"
      style="margin-top:18px"
    >Agendar mi reunión</a>
  </section>

  <!-- placa Edge Blue (la ÚNICA placa full-bleed de acento) -->
  <section class="plate" aria-label="Tu ventaja final">
    <p class="plate-text">Tu ventaja final<span class="plate-dot">.</span></p>
  </section>

  <script>
    /* Transición hero → rueda ligada al scroll (lenguaje cosmos.so):
       el hero se eleva y desvanece; la rueda entra escalando y subiendo.
       Mapeo posicional directo (sin easing: el scroll ES la línea de tiempo). */
    function initCosmosScroll() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const hero = document.querySelector('.hero-inner') as HTMLElement | null;
      const card = document.getElementById('wheel-entry');
      if (!hero && !card) return;
      let ticking = false;
      function update() {
        ticking = false;
        const vh = innerHeight || 800;
        if (hero) {
          const p = Math.min(1, scrollY / (vh * 0.9));
          hero.style.transform = `translateY(${scrollY * 0.14}px)`;
          hero.style.opacity = String(1 - p * 0.4);
        }
        if (card) {
          const r = card.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
          card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.94 + p * 0.06})`;
          card.style.opacity = String(0.35 + p * 0.65);
        }
      }
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    initCosmosScroll();
    document.addEventListener('astro:page-load', initCosmosScroll);
  </script>
</Base>

<style>
  /* el hero mantiene su peso completo (logotipo, titular, párrafo, dos
     CTA) pero SIN el hueco muerto de ~150px que dejaba entre el nav y el
     primer texto — el contenido arranca inmediatamente bajo el nav. */
  /* fondo de video: cubre el hero entero, recortado sin distorsión
     (object-fit:cover) y siempre detrás del velo + el texto. */
  .hero {
    position: relative;
    padding: 48px 72px 64px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(100vh - 92px);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: saturate(1.5) brightness(1.08);
  }
  /* velo oscuro UNIFORME: garantiza contraste de texto sin importar el
     fotograma del video (pasa de campo claro al atardecer a foco
     encendido en azul) — el texto está centrado en TODA la pantalla,
     así que el oscurecimiento tiene que ser parejo, no solo detrás de
     un bloque de texto en una esquina. Opacidad reducida a la mitad
     (82% → 41%) para que el foco se vea más brillante. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--bg) 41%, transparent);
  }
  .hero-inner { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .hero-eyebrow { color: var(--fg); }
  .hero-eyebrow-prompt { color: var(--silver); }
  .hero-logo { width: min(220px, 55vw); height: auto; margin: 28px 0 24px; }
  .hero-h1 {
    font-size: clamp(17px, 2.3vw, 32px);
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: var(--fg);
  }
  .hero-sub {
    margin-top: 24px;
    font-size: clamp(14px, 1.45vw, 19px);
    letter-spacing: -.025em;
    color: var(--fg);
  }
  /* franja "la presión" — mismo tratamiento full-bleed que .plate (placa
     final): fondo Edge Blue sólido, contenido acotado y centrado, texto
     en --on-accent (blanco) porque azul sobre azul no se leería. */
  .presion-band { background: var(--accent); padding: 96px 72px; overflow: hidden; }
  .presion-inner { max-width: 1180px; margin: 0 auto; }
  .presion-h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    /* equivalente al lockup >_ FINAL EDGE [ENGINE] de la sección
       siguiente (18px base × escala 1.6 = 28.8px) — antes crecía hasta
       48px con el viewport y quedaba mucho más grande que ese logo. */
    font-size: clamp(20px, 6vw, 29px);
    letter-spacing: -.02em;
    color: var(--on-accent);
  }
  /* >_ con relieve 3D real (R5.4: "siempre los PNG horneados, relieve 3D
     intacto") — recorte exacto del símbolo de logo-mono-light.png, la
     variante plata aprobada para fondos accent/void. Nunca CSS
     box-shadow/text-shadow para simular volumen (R3.2 los prohíbe). La
     altura sigue el font-size del heading (em), así se mantiene a la
     altura de la "L" de "La" en cualquier tamaño de pantalla. */
  .presion-prompt-img { height: 0.78em; width: auto; display: block; }
  /* bloques con delimitación clara: misma retícula hairline que el
     resto del sitio (gap:1px + fondo de línea), adaptada a superficie
     accent — cada bloque es un rectángulo vertical con el número
     centrado arriba del texto, nunca a la izquierda. */
  .presion-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 56px;
    background: color-mix(in srgb, var(--on-accent) 30%, transparent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 30%, transparent);
  }
  .presion-fact {
    background: var(--accent);
    padding: 40px 28px;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .presion-fact-num { font-size: clamp(28px, 3.2vw, 44px); font-weight: 600; letter-spacing: -.03em; color: var(--on-accent); white-space: nowrap; }
  .presion-fact-unit { font-size: 0.55em; }
  .presion-fact-arrow { display: inline-block; margin: 0 .2em; font-weight: 400; font-size: .7em; }
  .presion-fact-txt { margin-top: 16px; font-size: var(--text-body); line-height: 1.5; color: color-mix(in srgb, var(--on-accent) 78%, transparent); }
  .body-2 { color: var(--fg-2); font-size: var(--text-body); }

  /* El Engine — pantalla completa a dos columnas, ancho real de la
     ventana (no el contenedor de 1080px de .section), igual que las
     referencias: texto corto a la izquierda, gráfico dominante a la
     derecha, sangrado hacia el borde. La rueda se dimensiona a sí misma
     en engine-wheel.js para NUNCA exceder el alto disponible de esta
     fila — así siempre cabe entera en una sola pantalla. */
  .engine-split {
    display: grid;
    grid-template-columns: minmax(280px, 420px) 1fr;
    align-items: center;
    gap: 24px;
    /* un poco más de aire arriba que abajo — empuja el contenido
       ligeramente hacia abajo dentro de la sección, en vez de quedar
       pegado justo debajo del nav. */
    padding-top: 104px;
    padding-bottom: 72px;
    /* SIN max-width + margin:auto propio: eso centraba el bloque en su
       PROPIA caja de 1800px, una referencia distinta a la que usa
       .presion-inner (max-width:1180 dentro del padding de 72px de
       .presion-band) — el texto arrancaba en una columna distinta Y la
       rueda (sin tope a la derecha) se salía del ancho de esa misma
       cuadrícula. padding-left y padding-right usan la MISMA fórmula
       que el centrado de .presion-inner (72px de piso, o el margen que
       le tocaría a una caja de 1180px centrada) — el área de contenido
       resultante mide exactamente 1180px, igual que "la presión", así
       que el borde derecho de la rueda (flex-end dentro de su columna)
       coincide con el borde derecho real de esa cuadrícula. */
    padding-left: max(72px, calc(50vw - 590px));
    padding-right: max(72px, calc(50vw - 590px));
  }
  .engine-col-text { padding-right: 24px; }
  /* mismo tamaño (alto) que .hero-logo (~59.5px: 220px de ancho ×
     370/1368 de aspect ratio) — escala el lockup completo en vez de
     inflar el font-size a mano, para no romper la proporción interna
     entre >_, la palabra y el tag. */
  .engine-lockup { transform: scale(1.6); transform-origin: left top; margin-bottom: 4px; }
  /* titular al mismo tamaño que el h1 del hero (clamp 17–32px), no el
     --text-h2 genérico (36–56px) que usan las demás secciones. */
  /* mismo font-size y letter-spacing que .hero-sub ("Haz más. Sin
     contratar más.") — no --text-h2 genérico ni el tamaño del h1. Sin
     text-transform: mayúsculas y minúsculas normales, como el copy. */
  .engine-h2 { font-size: clamp(14px, 1.45vw, 19px); font-weight: 400; letter-spacing: -.025em; margin-top: 20px; }
  .engine-col-wheel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    padding: 8px 16px 8px 0;
  }
  /* dentro del split, la rueda flota libre — sin el marco de "tarjeta"
     (borde + fondo + padding) que usa en otras páginas: en las
     referencias el gráfico sangra al borde, no vive dentro de una caja.
     Alto FIJO (no 100%/100vh): con fitHeight, engine-wheel.js lee este
     alto para limitar el tamaño de la rueda — un valor fijo la mantiene
     legible (nombres de servicio a tamaño normal) sin depender de la
     altura de la ventana ni desbordar la sección. */
  .engine-col-wheel .wheel-card {
    display: flex;
    width: 100%;
    max-width: 900px;
    height: 720px;
    align-items: center;
    justify-content: flex-end;
    border: none;
    background: transparent;
    padding: 0;
  }
  @media (max-width: 900px) {
    .engine-split {
      grid-template-columns: 1fr;
      padding: 56px 24px;
      gap: 32px;
    }
    .engine-col-text { padding-right: 0; }
    .engine-col-wheel { justify-content: center; padding: 0; }
    .engine-col-wheel .wheel-card { height: auto; max-width: 100%; }
  }

  .val-steps { list-style: none; margin-top: 28px; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .val-steps li { background: var(--bg); padding: 16px 20px; color: var(--fg-2); display: flex; gap: 18px; font-size: var(--text-body); }

  .plate {
    background: var(--accent);
    padding: 120px 72px;
    overflow: hidden;
  }
  .plate-text {
    max-width: 1180px;
    margin: 0 auto;
    font-size: var(--text-plate);
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: .95;
    color: var(--on-accent);
  }
  .plate-dot { color: var(--void-deep); }

  @media (max-width: 760px) {
    .hero { padding: 32px 24px 48px; }
    .plate { padding: 88px 24px; }
    .presion-band { padding: 64px 24px; }
    .presion-facts { grid-template-columns: 1fr; margin-top: 40px; }
    .presion-fact { min-height: 0; padding: 32px 24px; }
  }
</style>
