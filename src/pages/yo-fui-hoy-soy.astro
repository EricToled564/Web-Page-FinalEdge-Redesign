---
import '../styles/tokens.css';

/* Página independiente y NO listada (pedido 2026-08-12): sin Nav, sin
   footer, sin layout Base — solo vive en /yo-fui-hoy-soy, no se enlaza
   desde ningún menú ni aparece en ningún sitemap, y lleva noindex para
   que buscadores tampoco la descubran. Solo es alcanzable con el URL
   directo. */
const BUILD = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
---
<html lang="es-MX" data-build={BUILD}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yo Fui, Hoy Soy</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <canvas id="dust" aria-hidden="true"></canvas>

    <main class="stage">
      <h1 class="title">Yo Fui, <span>Hoy Soy</span></h1>

      <div class="transport">
        <button type="button" data-play class="tbtn is-active" aria-label="Reproducir">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          Play
        </button>
        <button type="button" data-pause class="tbtn" aria-label="Pausar">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
          Pause
        </button>
        <button type="button" data-stop class="tbtn" aria-label="Detener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h12v12H6z" /></svg>
          Stop
        </button>
      </div>
      <p class="state" data-state>Lista para reproducir</p>
      <p class="captions" data-captions aria-live="polite"></p>

      <label class="lyrics-upload">
        <input type="file" accept=".txt" data-lyrics-file hidden />
        <span data-lyrics-label>Subir letra (.txt)</span>
      </label>
    </main>

    <script type="importmap">
    {
      "imports": {
        "three": "/assets/js/three.module.min.js"
      }
    }
    </script>
    <script type="module">
      import * as THREE from 'three';

      const canvas = document.getElementById('dust');
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      /* fondo blanco (pedido explícito), a diferencia del visualizador
         oscuro de la sección Música — por eso el fragment shader de
         abajo NO reutiliza el blending aditivo original: sobre blanco,
         aditivo simplemente desaparece (sumar luz a lo ya máximo brillo
         no cambia nada visible). Aquí las partículas son tinta oscura
         semitransparente compuesta con blending normal, como polvo/tinta
         sobre papel. */
      renderer.setClearColor(0xffffff, 1);

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0xffffff, 0.045);

      const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 200);
      camera.position.set(0, 0, 8);

      addEventListener('resize', () => {
        const w = innerWidth, h = innerHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      });

      /* muestrea el número "30" en un canvas 2D y devuelve N puntos
         dentro del trazo (con repetición + jitter leve) — mismo método
         de "glifo -> nube de puntos" usado antes para el >_ de /v2/:
         se rasteriza el texto, se toma cada pixel con tinta como
         candidato, y cada partícula elige uno al azar como su destino
         cuando el efecto "arma" el número. */
      function sampleGlyphPoints(text, count) {
        const W = 512, H = 512;
        const cv = document.createElement('canvas');
        cv.width = W; cv.height = H;
        const ctx = cv.getContext('2d');
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = '#fff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '900 300px "Geist Mono", monospace';
        ctx.fillText(text, W / 2, H / 2 + 14);
        const data = ctx.getImageData(0, 0, W, H).data;
        const pts = [];
        let minX = W, maxX = 0, minY = H, maxY = 0;
        for (let y = 0; y < H; y += 2) {
          for (let x = 0; x < W; x += 2) {
            const a = data[(y * W + x) * 4 + 3];
            if (a > 128) {
              pts.push(x, y);
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
            }
          }
        }
        const cx = (minX + maxX) / 2, cy = (minY + maxY) / 2;
        const span = Math.max(maxX - minX, maxY - minY, 1);
        const scale = 3.6 / span;
        const targets = new Float32Array(count * 3);
        const nPts = pts.length / 2;
        for (let i = 0; i < count; i++) {
          const k = nPts ? (Math.random() * nPts | 0) : 0;
          const px = nPts ? pts[k * 2] : cx;
          const py = nPts ? pts[k * 2 + 1] : cy;
          targets[i * 3 + 0] = (px - cx) * scale + (Math.random() - 0.5) * 0.025;
          targets[i * 3 + 1] = -(py - cy) * scale + (Math.random() - 0.5) * 0.025;
          targets[i * 3 + 2] = (Math.random() - 0.5) * 0.4;
        }
        return targets;
      }

      const N = 220000; // densidad x10 (pedido 2026-08-12)
      const positions = new Float32Array(N * 3);
      const seeds = new Float32Array(N);
      const tones = new Float32Array(N);
      for (let i = 0; i < N; i++) {
        const r = Math.pow(Math.random(), 0.6) * 2.4;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        positions[i * 3 + 0] = r * Math.sin(phi) * Math.cos(theta) * 1.45;
        positions[i * 3 + 1] = r * Math.cos(phi) * 0.85;
        positions[i * 3 + 2] = r * Math.sin(phi) * Math.sin(theta) * 0.85;
        seeds[i] = Math.random();
        /* mezcla pareja negra/roja por partícula (pedido 2026-08-12,
           corrige un primer intento donde quedaba mayormente negro con
           solo vetas rojas — ahora es una mezcla real 50/50 al azar). */
        tones[i] = Math.random();
      }
      const targets = sampleGlyphPoints('30', N);
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setAttribute('aSeed', new THREE.Float32BufferAttribute(seeds, 1));
      geo.setAttribute('aTone', new THREE.Float32BufferAttribute(tones, 1));
      geo.setAttribute('aTarget', new THREE.Float32BufferAttribute(targets, 3));

      const VERT = `
      uniform float uTime;
      uniform float uFlowTime;
      uniform float uLow;
      uniform float uMid;
      uniform float uHigh;
      uniform float uPulse;
      uniform float uPhase;
      uniform float uAssemble;

      attribute float aSeed;
      attribute float aTone;
      attribute vec3 aTarget;

      varying float vBright;
      varying float vDepth;
      varying float vTone;

      vec3 mod289v3(vec3 x){return x - floor(x*(1.0/289.0))*289.0;}
      vec4 mod289v4(vec4 x){return x - floor(x*(1.0/289.0))*289.0;}
      vec4 permute(vec4 x){return mod289v4(((x*34.0)+1.0)*x);}
      vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314*r;}
      float snoise(vec3 v){
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min(g.xyz, l.zxy);
        vec3 i2 = max(g.xyz, l.zxy);
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + C.yyy;
        vec3 x3 = x0 - D.yyy;
        i = mod289v3(i);
        vec4 p = permute(permute(permute(
          i.z + vec4(0.0, i1.z, i2.z, 1.0)) +
          i.y + vec4(0.0, i1.y, i2.y, 1.0)) +
          i.x + vec4(0.0, i1.x, i2.x, 1.0));
        float n_ = 0.142857142857;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0*x_);
        vec4 x = x_*ns.x + ns.yyyy;
        vec4 y = y_*ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4(x.xy, y.xy);
        vec4 b1 = vec4(x.zw, y.zw);
        vec4 s0 = floor(b0)*2.0 + 1.0;
        vec4 s1 = floor(b1)*2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
        vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
        vec3 p0 = vec3(a0.xy, h.x);
        vec3 p1 = vec3(a0.zw, h.y);
        vec3 p2 = vec3(a1.xy, h.z);
        vec3 p3 = vec3(a1.zw, h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
        m = m*m;
        return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
      }
      vec3 snoiseVec3(vec3 x){
        return vec3(
          snoise(x),
          snoise(vec3(x.y - 19.1, x.z + 33.4, x.x + 47.2)),
          snoise(vec3(x.z + 74.2, x.x - 124.5, x.y + 99.4))
        );
      }
      vec3 curlNoise(vec3 p){
        const float e = 0.1;
        vec3 dx = vec3(e, 0.0, 0.0);
        vec3 dy = vec3(0.0, e, 0.0);
        vec3 dz = vec3(0.0, 0.0, e);
        vec3 px0 = snoiseVec3(p - dx); vec3 px1 = snoiseVec3(p + dx);
        vec3 py0 = snoiseVec3(p - dy); vec3 py1 = snoiseVec3(p + dy);
        vec3 pz0 = snoiseVec3(p - dz); vec3 pz1 = snoiseVec3(p + dz);
        float xg = py1.z - py0.z - pz1.y + pz0.y;
        float yg = pz1.x - pz0.x - px1.z + px0.z;
        float zg = px1.y - px0.y - py1.x + py0.x;
        return normalize(vec3(xg, yg, zg));
      }

      void main(){
        vec3 pos = position;

        vec3 flow  = curlNoise(pos * 0.5 + vec3(uFlowTime*0.35, uFlowTime*0.27, uFlowTime*0.31) + vec3(uPhase*0.4));
        vec3 flow2 = curlNoise(pos * 1.15 + vec3(uFlowTime*0.55 + 5.0, uFlowTime*0.42, uFlowTime*0.60));

        float orderedAmp = 0.22 + uMid * 0.55 + uLow * 0.35 + uHigh * 0.15;
        vec3 ordered = flow * orderedAmp + flow2 * (orderedAmp * 0.35);

        vec3 shimmer = vec3(
          snoise(vec3(pos.x*1.6, pos.y*1.6, uFlowTime*1.4)),
          snoise(vec3(pos.y*1.6, pos.z*1.6, uFlowTime*1.7 + 3.0)),
          snoise(vec3(pos.z*1.6, pos.x*1.6, uFlowTime*1.3 + 7.0))
        ) * uHigh * 0.22;

        vec3 rnd = vec3(
          snoise(vec3(pos.x*0.5, pos.y*0.5, uTime*1.2)),
          snoise(vec3(pos.y*0.5, pos.z*0.5, uTime*1.5 + 3.0)),
          snoise(vec3(pos.z*0.5, pos.x*0.5, uTime*1.1 + 7.0))
        );
        vec3 chaos = rnd * (uPulse * 1.20);

        float expansion = 1.0 + uLow * 0.25 + uPulse * 0.30;
        vec3 basePos = pos * expansion;

        vec3 free = basePos + ordered + shimmer + chaos;
        /* en los beats más intensos uAssemble sube hacia 1 y el polvo
           libre cede el paso a su punto asignado dentro del "30" — se
           deja un resto de shimmer para que el número siga respirando
           en vez de quedar clavado y muerto. */
        pos = mix(free, aTarget + shimmer * 0.05, uAssemble);

        vec4 mv = modelViewMatrix * vec4(pos, 1.0);
        gl_Position = projectionMatrix * mv;

        float size = 1.0 + uLow * 0.7 + uPulse * 2.4 + aSeed * 0.7;
        gl_PointSize = size * (16.0 / -mv.z);

        float glow = 0.35 + aSeed * 0.35;
        glow += uPulse * (0.4 + 0.6 * aSeed);
        glow += uMid * 0.20 * aSeed;
        vBright = glow;
        vDepth  = -mv.z;
        vTone   = aTone;
      }
      `;

      /* tinta oscura semitransparente sobre blanco: blending NORMAL (no
         aditivo). vBright/uPulse mueven la OPACIDAD, no el tono hacia
         blanco (que sería invisible aquí) — más brillo/pulso = trazo más
         presente, no más claro. */
      const FRAG = `
      precision highp float;
      uniform vec3 uBlack;
      uniform vec3 uRed;
      varying float vBright;
      varying float vDepth;
      varying float vTone;

      void main(){
        vec2 c = gl_PointCoord - 0.5;
        float d = length(c);
        if (d > 0.5) discard;
        float shape = smoothstep(0.50, 0.05, d);
        float depthFade = clamp(1.0 - (vDepth - 5.0) / 15.0, 0.15, 1.0);
        float b = min(1.0, vBright);
        /* reporte 2026-08-12 "el color es solo rojo": dos causas.
           1) uPulse empujaba el tono de CADA partícula hacia rojo en
              cada golpe — con una canción con ritmo casi continuo eso
              mantenía casi toda la nube roja casi todo el tiempo. El
              tono base ahora es puramente el de cada partícula
              (vTone), fijo, sin que el audio lo mueva — 50/50 real.
           2) tinta negra semitransparente sobre blanco casi no se ve
              (negro claro * alpha bajo ≈ gris apenas perceptible),
              mientras que la MISMA alpha en rojo sí se lee con fuerza
              — así que aunque la mezcla fuera 50/50 en cantidad de
              partículas, visualmente parecía "solo rojo". Se le da al
              negro más opacidad para que pese lo mismo que el rojo. */
        float toneAlphaBoost = mix(1.9, 1.0, vTone);
        float alpha = shape * (0.10 + b * 0.30) * depthFade * toneAlphaBoost;
        vec3 col = mix(uBlack, uRed, vTone);
        gl_FragColor = vec4(col, alpha);
      }
      `;

      const css = getComputedStyle(document.documentElement);
      const blackHex = css.getPropertyValue('--bg').trim() || '#0E0E12';
      const redHex = css.getPropertyValue('--color-error').trim() || '#FF5A5A';
      const uniforms = {
        uTime: { value: 0 },
        uFlowTime: { value: 0 },
        uLow: { value: 0 },
        uMid: { value: 0 },
        uHigh: { value: 0 },
        uPulse: { value: 0 },
        uPhase: { value: 0 },
        uAssemble: { value: 0 },
        uBlack: { value: new THREE.Color(blackHex) },
        uRed: { value: new THREE.Color(redHex) },
      };

      const mat = new THREE.ShaderMaterial({
        uniforms,
        vertexShader: VERT,
        fragmentShader: FRAG,
        transparent: true,
        depthWrite: false,
        blending: THREE.NormalBlending,
      });
      const points = new THREE.Points(geo, mat);
      scene.add(points);

      // -------- Audio (una sola pista, controles nativos Play/Pause/Stop) --------
      const audio = new Audio('/assets/audio/yo-fui-hoy-soy.mp3');
      audio.preload = 'auto';
      audio.loop = false;

      let actx = null, analyser = null, freq = null, srcNode = null;
      const ensureGraph = () => {
        if (actx) return;
        actx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = actx.createAnalyser();
        analyser.fftSize = 2048;
        analyser.smoothingTimeConstant = 0.5;
        freq = new Uint8Array(analyser.frequencyBinCount);
        srcNode = actx.createMediaElementSource(audio);
        srcNode.connect(analyser);
        analyser.connect(actx.destination);
      };

      /* Letra en pantalla (pedido 2026-08-12), abajo del todo donde la
         nube de polvo casi no llega. Tiempos estimados proporcionalmente
         a la estructura de la canción (intro/verso/coro/puente/outro)
         sobre sus 274s de duración — no hay forma de detectar el
         arranque exacto de cada línea sin escuchar el audio, así que
         puede necesitar ajuste fino una vez probado en vivo.
         El TEXTO de cada línea NO vive en este archivo: se sube con el
         botón "Subir letra" (.txt, una línea por renglón, en orden) y
         se guarda en localStorage de este navegador — el arreglo de
         abajo solo trae los tiempos.
         Corregido 2026-08-12: la primera versión del mapa de tiempos
         asumía una repetición extra del coro final antes del cierre
         (bridge → coro repetido → "Treinta años...") que la estructura
         real de la canción no tiene (bridge → "Treinta años..." directo).
         Se quita ese bloque repetido — el resto de bloques (verso, pre-
         coro, coro, post-coro x2, puente, cierre) queda igual. */
      /* REHECHO 2026-08-12 con la tabla de tiempos EXACTA que entregó el
         cliente (análisis profesional del render final, precisión
         ±0.5s), reemplazando la estimación por Whisper del intento
         anterior. Cada entrada es [tiempo_en_segundos, índice_de_línea
         EN EL ARCHIVO SUBIDO] — no siempre 1 a 1: los dos coros de "Yo
         fui/Hoy soy/Sports World" de la mitad de la canción están
         escritos 6 veces cada uno en el archivo (una por repetición
         real), pero el coro final del cierre solo está escrito 2 veces
         aunque suene 3 veces — esas 2 líneas se REUTILIZAN alternando
         para las 6 repeticiones finales (por eso varios pares
         comparten el mismo índice de línea).
         CORREGIDO 2026-08-12 ("en la segunda repetición falta Yo Fui"):
         en ambos coros de mitad de canción, la línea que el archivo
         trae para la SEGUNDA repetición de "Yo fui, Hoy soy" (índices
         22 y 48) es más corta que las otras dos repeticiones y no
         coincide con ellas (verificado comparando longitudes y
         coincidencia exacta, nunca el texto) — le falta la parte "Yo
         fui". Esas dos repeticiones reutilizan ahora el índice de la
         PRIMERA repetición (20 y 46), que sí trae la línea completa. */
      const TIME_LINE_PAIRS = [
        [16.1,0],[19.4,1],[23.2,2],[25.8,3],[31.3,4],[35.1,5],[38.2,6],[41.0,7],
        [45.9,8],[48.8,9],[53.7,10],[57.8,11],[61.9,12],[64.9,13],[69.4,14],
        [73.7,15],[77.3,16],[79.5,17],[84.1,18],[86.8,19],[92.5,20],[94.7,21],
        [96.3,20],[98.4,23],[100.0,24],[102.2,25],[105.6,26],[108.0,27],
        [111.2,28],[115.4,29],[119.8,30],[122.5,31],[127.1,32],[129.9,33],
        [135.6,34],[137.3,35],[142.4,36],[146.2,37],[150.2,38],[153.0,39],
        [157.4,40],[161.3,41],[165.1,42],[167.2,43],[171.8,44],[174.4,45],
        [180.0,46],[182.1,47],[183.6,46],[185.8,49],[187.4,50],[189.5,51],
        [207.5,52],[210.3,53],[214.5,54],[218.6,55],[222.8,56],[226.2,57],
        [230.1,58],[233.9,59],[239.6,60],[241.4,61],[245.6,62],[250.8,63],
        [254.8,64],[256.6,65],[258.3,64],[260.4,65],[262.1,64],[264.2,65],
      ];
      const LYRICS_KEY = 'yfhs-lyrics-v1';
      const buildLyrics = (lines) =>
        TIME_LINE_PAIRS.map(([t, lineIdx]) => [t, (lines && lines[lineIdx]) || '']).filter((row) => row[1]);
      let LYRICS = buildLyrics(JSON.parse(localStorage.getItem(LYRICS_KEY) || 'null'));

      const fileInput = document.querySelector('[data-lyrics-file]');
      const lyricsLabel = document.querySelector('[data-lyrics-label]');
      const setLyricsLabel = (source) => {
        if (!lyricsLabel) return;
        if (!LYRICS.length) { lyricsLabel.textContent = 'Subir letra (.txt)'; return; }
        /* vista previa de la primera línea en el propio botón (pedido
           2026-08-12, tras dos intentos fallidos de arreglar acentos a
           ciegas): así se ve en el momento si el texto quedó bien
           decodificado, sin abrir herramientas de desarrollador. */
        const preview = LYRICS[0][1].slice(0, 24);
        const tag = source === 'site' ? '' : ' (solo este navegador)';
        lyricsLabel.textContent = `Letra cargada (${LYRICS.length})${tag}: "${preview}${LYRICS[0][1].length > 24 ? '…' : ''}" — cambiar`;
      };
      setLyricsLabel('local');
      /* pedido 2026-08-12 "por qué la tengo que subir en el celular":
         localStorage es por navegador/dispositivo, no se comparte. Se
         intenta primero un archivo alojado en el propio sitio
         (/assets/lyrics/yo-fui-hoy-soy.txt) — funciona igual en
         cualquier dispositivo sin volver a subir nada, porque lo sirve
         el sitio, no el navegador de quien lo ve. Si ese archivo no
         existe todavía (nadie lo ha subido al repo), se usa lo que
         haya en localStorage como respaldo. */
      (async () => {
        try {
          const res = await fetch('/assets/lyrics/yo-fui-hoy-soy.txt', { cache: 'no-store' });
          if (!res.ok) return;
          const buf = await res.arrayBuffer();
          let text;
          try { text = new TextDecoder('utf-8', { fatal: true }).decode(buf); }
          catch (_) { text = new TextDecoder('windows-1252').decode(buf); }
          const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
          if (!lines.length) return;
          LYRICS = buildLyrics(lines);
          setLyricsLabel('site');
        } catch (_) { /* sin archivo en el sitio todavía — se queda con localStorage */ }
      })();
      /* reporte 2026-08-12 "los acentos salen como signo de
         interrogación": file.text() da por hecho que el .txt está en
         UTF-8. Notepad y varios editores de Windows guardan por
         defecto en "ANSI" (Windows-1252), que codifica letras
         acentuadas y puntuación invertida con bytes distintos.
         PRIMER intento (fatal:false + buscar el carácter de reemplazo)
         no fue confiable — se cambia a fatal:true: así el decoder
         de UTF-8 arroja un error real ante CUALQUIER byte inválido en
         vez de solo sustituirlo, señal mucho más segura de que el
         archivo no es UTF-8 y hay que releerlo como Windows-1252. */
      const readTextSmart = async (file) => {
        const buf = await file.arrayBuffer();
        try {
          return new TextDecoder('utf-8', { fatal: true }).decode(buf);
        } catch (_) {
          return new TextDecoder('windows-1252').decode(buf);
        }
      };
      fileInput?.addEventListener('change', async () => {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;
        const text = await readTextSmart(file);
        const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        localStorage.setItem(LYRICS_KEY, JSON.stringify(lines));
        LYRICS = buildLyrics(lines);
        setLyricsLabel('local');
        fileInput.value = '';
      });

      const captionsEl = document.querySelector('[data-captions]');
      let lastCaptionIdx = -2;
      /* entradas cuyas marcas de tiempo caen a MERGE_GAP segundos o menos
         una de otra se muestran JUNTAS, como una sola línea combinada,
         sin pausa perceptible — esto reemplaza el truco anterior de
         duplicar marcas de tiempo (que desincronizaba el conteo). */
      const MERGE_GAP = 2.5;
      const updateCaptions = () => {
        if (!captionsEl || audio.paused) return;
        const t = audio.currentTime;
        let idx = -1;
        for (let i = 0; i < LYRICS.length; i++) {
          if (LYRICS[i][0] <= t) idx = i; else break;
        }
        if (idx < 0) { if (lastCaptionIdx !== -1) { captionsEl.textContent = ''; lastCaptionIdx = -1; } return; }
        let start = idx;
        while (start > 0 && LYRICS[start][0] - LYRICS[start - 1][0] <= MERGE_GAP) start--;
        let end = start;
        while (end + 1 < LYRICS.length && LYRICS[end + 1][0] - LYRICS[end][0] <= MERGE_GAP) end++;
        const groupText = LYRICS.slice(start, end + 1).map((r) => r[1]).join(' ');
        /* el grupo se queda en pantalla hasta 3.6s después de su última
           línea o hasta que arranca el siguiente grupo, lo que sea más
           corto — así no se traslapan en los tramos cortos como el coro. */
        const lineEnd = end + 1 < LYRICS.length ? Math.min(LYRICS[end][0] + 3.6, LYRICS[end + 1][0]) : LYRICS[end][0] + 3.6;
        const visible = t < lineEnd;
        if (!visible) { if (lastCaptionIdx !== -1) { captionsEl.textContent = ''; lastCaptionIdx = -1; } return; }
        if (start !== lastCaptionIdx) { captionsEl.textContent = groupText; lastCaptionIdx = start; }
      };

      const stateEl = document.querySelector('[data-state]');
      const btnPlay = document.querySelector('[data-play]');
      const btnPause = document.querySelector('[data-pause]');
      const btnStop = document.querySelector('[data-stop]');
      const setActive = (btn) => {
        [btnPlay, btnPause, btnStop].forEach((b) => b.classList.toggle('is-active', b === btn));
      };

      btnPlay.addEventListener('click', async () => {
        ensureGraph();
        if (actx.state === 'suspended') await actx.resume();
        try { await audio.play(); } catch (_) {}
        setActive(btnPlay);
        stateEl.textContent = '▸ en vivo';
      });
      btnPause.addEventListener('click', () => {
        audio.pause();
        setActive(btnPause);
        stateEl.textContent = 'en pausa';
      });
      btnStop.addEventListener('click', () => {
        audio.pause();
        audio.currentTime = 0;
        setActive(btnStop);
        stateEl.textContent = 'detenida';
        if (captionsEl) { captionsEl.textContent = ''; lastCaptionIdx = -2; }
      });
      audio.addEventListener('ended', () => {
        setActive(btnStop);
        stateEl.textContent = 'terminó';
      });

      // -------- Render loop --------
      const t0 = performance.now();
      let camAngle = 0;
      let lastFrameMs = t0;
      let flowTime = 0;
      const prevSpec = new Float32Array(80);
      let fluxAvg = 0;
      let beatPulse = 0;
      let beatPhase = 0;
      let lastBeatTime = 0;
      let formAmount = 0; // 0 = polvo suelto, 1 = "30" armado del todo

      function tick() {
        requestAnimationFrame(tick);
        const now = performance.now();
        const tSec = (now - t0) / 1000;
        const dt = Math.min(0.05, Math.max(0, (now - lastFrameMs) / 1000));
        lastFrameMs = now;

        updateCaptions();

        let lo = 0, mi = 0, hi = 0;
        if (analyser && freq && !audio.paused) {
          analyser.getByteFrequencyData(freq);
          const avg = (s, e) => {
            let sum = 0;
            const n = Math.min(e, freq.length);
            for (let j = s; j < n; j++) sum += freq[j];
            return (sum / Math.max(1, n - s)) / 255;
          };
          lo = Math.min(1.5, avg(0, 80) * 0.7);
          mi = Math.min(1.5, avg(80, 200) * 0.7);
          hi = Math.min(1.5, avg(200, 400) * 0.7);

          let fluxSum = 0;
          const BANDS = Math.min(80, freq.length);
          for (let i = 2; i < BANDS; i++) {
            const cur = freq[i] / 255;
            const d = cur - prevSpec[i];
            if (d > 0) fluxSum += d;
            prevSpec[i] = cur;
          }
          const flux = fluxSum / BANDS;
          fluxAvg = fluxAvg * 0.95 + flux * 0.05;

          const sinceBeat = now - lastBeatTime;
          if (sinceBeat > 120 && flux > fluxAvg * 1.5 + 0.003) {
            const strength = Math.min(1.0, (flux - fluxAvg) * 22.0);
            if (strength > 0.20) {
              beatPulse = Math.max(beatPulse, strength);
              beatPhase += 0.8 + Math.random() * 2.4;
              lastBeatTime = now;
              /* solo los golpes REALMENTE fuertes arman el número — un
                 beat cualquiera no alcanza, tiene que ser de los picos
                 más intensos de la canción (pedido 2026-08-12). */
              if (strength > 0.55) formAmount = Math.min(1, formAmount + strength * 0.9);
            }
          }
          beatPulse *= 0.88;
          if (beatPulse < 0.001) beatPulse = 0;
        } else {
          beatPulse *= 0.92;
        }
        /* el "30" se sostiene un instante y se disuelve solo — no se
           queda clavado en pantalla. */
        formAmount *= 0.975;
        if (formAmount < 0.001) formAmount = 0;

        const envelope = lo * 0.5 + mi * 0.35 + hi * 0.15;
        flowTime += dt * (0.6 + envelope * 2.6);

        camAngle += 0.0025 + beatPulse * 0.008;
        /* reporte 2026-08-12 "el 30 se sigue invirtiendo" (persistió
           incluso acotando el balanceo a ±26°): la única forma de que
           un plano se vea en espejo es que la cámara cruce a su
           reverso, así que en vez de seguir acotando el ángulo se
           elimina el movimiento horizontal por completo — la cámara
           queda FIJA en X/Z (nunca puede cruzar al reverso porque
           nunca se mueve en ese eje), y solo conserva un balanceo
           vertical sutil para que la escena no se sienta muerta. */
        camera.position.x = 0;
        camera.position.z = 8.5;
        camera.position.y = Math.sin(camAngle * 0.4) * 0.8;
        camera.lookAt(0, 0, 0);

        uniforms.uTime.value = tSec;
        uniforms.uFlowTime.value = flowTime;
        uniforms.uLow.value = lo;
        uniforms.uMid.value = mi;
        uniforms.uHigh.value = hi;
        uniforms.uPulse.value = beatPulse;
        uniforms.uPhase.value = beatPhase;
        uniforms.uAssemble.value = formAmount;

        renderer.render(scene, camera);
      }
      tick();
    </script>

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        background: #fff;
        height: 100%;
        overflow: hidden;
        -webkit-tap-highlight-color: transparent;
      }
      body {
        font-family: var(--font-ui);
      }
      #dust {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      .stage {
        position: relative;
        z-index: 1;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 40px;
        text-align: center;
        padding: 24px;
        pointer-events: none;
      }
      .title {
        font-family: var(--font-read);
        font-weight: 500;
        font-size: clamp(32px, 6vw, 72px);
        letter-spacing: -0.03em;
        line-height: 1.05;
        color: var(--bg);
      }
      /* pedido 2026-08-12: el gris no se leía bien — todo el título en
         negro sólido, sin fondo/halo/sombra de ningún tipo. */
      .title span {
        color: var(--bg);
      }
      .transport {
        display: flex;
        gap: 12px;
        pointer-events: auto;
      }
      .tbtn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid var(--bg);
        color: var(--bg);
        font-family: var(--font-ui);
        font-size: var(--text-label);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 12px 20px;
        cursor: pointer;
        transition: background var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
      }
      .tbtn svg { width: 16px; height: 16px; }
      .tbtn:hover { background: var(--bg); color: #fff; }
      /* pedido 2026-08-12: rojo en vez de azul (coherente con la nube
         negro/rojo de la página) en lugar del acento azul del sitio. */
      .tbtn.is-active { background: var(--color-error); border-color: var(--color-error); color: #fff; }
      .state {
        position: absolute;
        bottom: 28px;
        left: 0;
        right: 0;
        font-family: var(--font-ui);
        font-size: var(--text-label);
        letter-spacing: 0.08em;
        color: var(--fg-muted);
      }
      /* letra sincronizada (pedido 2026-08-12): pegada al borde inferior,
         donde la nube de partículas casi no llega — nada de fondo/halo
         detrás, solo texto sólido bien abajo para mantenerse legible. */
      .captions {
        position: absolute;
        bottom: 56px;
        left: 24px;
        right: 24px;
        text-align: center;
        font-family: var(--font-ui);
        font-size: clamp(14px, 2vw, 18px);
        letter-spacing: 0.02em;
        color: var(--bg);
        min-height: 1.4em;
        pointer-events: none;
      }
      /* botón discreto para subir el .txt de la letra (pedido
         2026-08-12) — guarda en localStorage de este navegador, sin
         backend ni GitHub de por medio. */
      .lyrics-upload {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--hairline);
        color: var(--fg-muted);
        font-family: var(--font-ui);
        font-size: var(--text-label);
        letter-spacing: 0.06em;
        padding: 8px 14px;
        cursor: pointer;
        background: #fff;
        transition: border-color var(--t-hover) var(--ease), color var(--t-hover) var(--ease);
        /* bug real (reporte 2026-08-12 "el botón no sirve"): .stage
           tiene pointer-events:none para dejar pasar los clicks hacia
           el canvas de partículas — .lyrics-upload es hijo de .stage y
           heredaba ese none, así que el click SIEMPRE le llegaba al
           canvas de atrás en vez de al botón, aunque se viera encima. */
        pointer-events: auto;
      }
      .lyrics-upload:hover { border-color: var(--bg); color: var(--bg); }
    </style>
  </body>
</html>
