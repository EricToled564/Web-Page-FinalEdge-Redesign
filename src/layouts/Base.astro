---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Assistant from '../components/Assistant.astro';
import ClosingBand from '../components/ClosingBand.astro';

const {
  title = 'Final Edge — La IA ejecuta. La experiencia decide.',
  description = 'Firma mexicana potenciada por inteligencia artificial y dirigida por visión de negocio. Haz más. Sin contratar más.',
  bandColor,
} = Astro.props;

/* marca de build visible en el DOM (<html data-build>): permite saber
   sin ambigüedad qué versión está sirviendo un deploy — se estampa en
   cada build con la fecha-hora UTC. */
const BUILD = new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Final Edge',
  alternateName: 'Final Edge AI',
  slogan: 'La IA ejecuta. La experiencia decide.',
  description,
  areaServed: { '@type': 'Country', name: 'México' },
  knowsLanguage: ['es-MX', 'en'],
  url: 'https://finaledge.mx',
  founder: { '@type': 'Person', name: 'Eric Toledano' },
  makesOffer: [
    'Intelligence', 'Estrategia', 'Team Readiness',
    'Optimización de Procesos', 'Sistemas', 'Producción Creativa',
  ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
};
---
<html lang="es-MX" data-build={BUILD}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta name="x-build" content={BUILD} />
    <link rel="icon" href="/assets/logos/logo-finaledge.png" type="image/png" />
    <link rel="preload" href="/fonts/v6-or3nQ6H-1_WfwkMZI_qYFrcdmg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main data-main>
      <slot />
    </main>
    <!-- pedido 2026-07-19: la página termina donde termina la banda de
         cierre (con su efecto de estática, el color de fase y los 3
         botones) — se elimina la última barra sólida con el logo
         (Footer.astro), quedaba redundante con el lockup que ya trae
         la propia banda. -->
    <ClosingBand color={bandColor} />
    <Assistant />
    <script>
      // Revelado de secciones — 600ms, curva maestra (R3.4)
      function initReveal() {
        /* todo lo que ya es visible en la primera pantalla al cargar se
           revela de inmediato — el rootMargin negativo de abajo es solo
           para el efecto de scroll en contenido que AÚN no se ve; sin
           este paso, contenido dentro del primer viewport (p. ej. los CTA
           del hero, cuando el hero ya cabe entero en pantalla) se quedaba
           en opacity:0 indefinidamente si el usuario nunca hacía scroll. */
        const vh = innerHeight || document.documentElement.clientHeight;
        document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh && r.bottom > 0) el.classList.add('is-in');
        });

        const els = document.querySelectorAll('.reveal:not(.is-in)');
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                io.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script>
      /* Detector de deploy en plena sesión: la rueda es una isla
         persistente cuyos estilos van sellados por build (scope de
         Astro). Una pestaña abierta a través de un deploy queda MIXTA:
         páginas nuevas + isla vieja cuyos estilos nuevos ya no le
         aplican — los cambios dentro de la rueda "no se implementan"
         para esa pestaña aunque el deploy esté perfecto (reporte
         2026-07-13: todo el día se actualizó, solo lo de la rueda no).
         Si el build de la página recién navegada difiere del build con
         el que abrió la pestaña, UNA recarga completa realinea todo:
         isla nueva, estilos nuevos, scripts nuevos. Nunca puede ciclar:
         tras recargar, el build inicial ES el nuevo. */
      const initialBuild = document.querySelector('meta[name="x-build"]')?.getAttribute('content');
      document.addEventListener('astro:page-load', () => {
        const now = document.querySelector('meta[name="x-build"]')?.getAttribute('content');
        if (initialBuild && now && now !== initialBuild) location.reload();
      });
    </script>
    <script>
      import '../scripts/fit-lockups.js';
    </script>
    <script>
      import '../scripts/scroll-to-engine.js';
    </script>
    <script>
      /* global (pedido 2026-07-19): la banda de cierre ahora vive aquí y
         sale en TODAS las páginas, incluidas las de /servicios/ que
         antes no traían este script. */
      import '../scripts/blue-edge-bg.js';
    </script>
    <script>
      /* Precalienta TODOS los videos de hero en segundo plano (reporte
         2026-07-13: "los videos tardan varios segundos en comenzar
         cuando deberían iniciar instantáneamente al llegar al landing").
         El poster ya pinta el primer fotograma al instante; lo que tarda
         es la descarga del clip (1.4–4.8 MB). Bajarlos una vez, en fila
         y con prioridad baja, los deja en la caché HTTP del navegador —
         al navegar a cualquier landing, el <video> se sirve de caché y
         el movimiento arranca de inmediato. Solo con cursor fino (en
         móvil no se queman ~19 MB de datos por adelantado), nunca bajo
         save-data ni conexiones que no sean 4g, y arrancando 2.5s
         después de la carga para no competir con la página actual.
         Corre UNA vez por documento (módulo): las navegaciones SPA
         conservan el documento y no lo re-disparan. */
      function prefetchHeroVideos() {
        if (!matchMedia('(pointer: fine)').matches) return;
        const c = (navigator as any).connection;
        if (c && (c.saveData || (c.effectiveType && c.effectiveType !== '4g'))) return;
        /* ALMACÉN EN MEMORIA (fix 2026-07-15, reporte "los videos tardan
           mucho en comenzar DE NUEVO"): el prefetch anterior solo
           calentaba la caché HTTP, y MEDIDO con CDP el <video> jamás la
           reutiliza (0 hits de disco tras un prefetch completo: el
           elemento pide rangos y la respuesta cacheada del fetch no los
           satisface, y en Vercel los assets de /public/ van con
           must-revalidate). Ahora cada clip precargado vive como blob y
           las páginas lo conectan DIRECTO al <video> (window.__videoWarm,
           ver playSvcHeroVideo en /servicios/): cero red al llegar.
           El documento persiste entre navegaciones SPA (ClientRouter),
           así que el almacén sobrevive el viaje completo. ~17MB de
           memoria solo en escritorio (pointer: fine). */
        const warm = ((window as any).__videoWarm = (window as any).__videoWarm || {});
        const load = (src: string) => {
          if (warm[src]) return warm[src];
          warm[src] = fetch(src)
            .then((r) => (r.ok ? r.blob() : Promise.reject(new Error(String(r.status)))))
            .then((b) => URL.createObjectURL(b))
            .catch(() => { delete warm[src]; return null; });
          return warm[src];
        };
        const vids = [
          '/assets/video/hero-bg.mp4',
          '/assets/video/svc-strategy-hero.mp4',
          '/assets/video/svc-intelligence-hero.mp4',
          '/assets/video/svc-readiness-hero.mp4',
          '/assets/video/svc-flow-hero.mp4',
          '/assets/video/svc-systems-hero.mp4',
          '/assets/video/svc-creative-hero.mp4',
        ];
        let i = 0;
        const next = () => {
          if (i >= vids.length) return;
          Promise.resolve(load(vids[i++])).finally(() => setTimeout(next, 250));
        };
        setTimeout(next, 1200);
        /* precarga por INTENCIÓN: al posar el puntero sobre el enlace de
           un servicio (nav, rueda, flechas), su video brinca la fila —
           para cuando el click aterriza, el blob suele estar listo. */
        const BY_SLUG: Record<string, string> = {
          'estrategia': '/assets/video/svc-strategy-hero.mp4',
          'business-intelligence': '/assets/video/svc-intelligence-hero.mp4',
          'team-readiness': '/assets/video/svc-readiness-hero.mp4',
          'optimizacion-de-procesos': '/assets/video/svc-flow-hero.mp4',
          'sistemas': '/assets/video/svc-systems-hero.mp4',
          'produccion-creativa': '/assets/video/svc-creative-hero.mp4',
        };
        document.addEventListener('pointerover', (ev) => {
          const a = (ev.target as HTMLElement | null)?.closest?.('a[href*="/servicios/"]');
          const m = a?.getAttribute('href')?.match(/\/servicios\/([^/]+)\//);
          if (m && BY_SLUG[m[1]]) load(BY_SLUG[m[1]]);
        }, { passive: true });
      }
      prefetchHeroVideos();
    </script>
  </body>
</html>
